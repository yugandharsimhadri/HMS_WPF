<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Pharma.App"
                    xmlns:system="clr-namespace:System;assembly=System.Runtime">

    <local:FeeBrushConverter x:Key="FeeBrush"/>
    <local:FeeInkConverter x:Key="FeeInk"/>
    <local:TextToVisibilityConverter x:Key="TextToVisible"/>

    <!-- Application-wide, because a StaticResource declared on one window is
         invisible to another. Declaring it on MainWindow made the data health
         grid throw a XamlParseException as its template loaded. -->
    <BooleanToVisibilityConverter x:Key="BoolToVisible"/>

    <!-- The same, but it understands ConverterParameter=invert. Global for the
         same reason: the booking and patient forms are shown over the shell, so
         a key declared on one page is not in scope where they are rendered. -->
    <local:BoolToVisibilityConverter x:Key="BoolVis"/>
    <local:EnumLabelConverter x:Key="EnumLabel"/>

    <!-- The palette lives in Theme.Light.xaml and Theme.Dark.xaml, merged at
         startup and swapped when the theme changes. -->

    <CornerRadius x:Key="FieldRadius">6</CornerRadius>

    <!--
        The navigation column (MainWindow) keeps the same dark ground in both
        the light and dark app themes, so its own accents are declared here,
        once, rather than in Theme.Light.xaml / Theme.Dark.xaml where they
        would need to double as "works on white" and "works on near-black".
    -->
    <SolidColorBrush x:Key="NavActiveBar" Color="#2AA79B"/>
    <SolidColorBrush x:Key="NavFocusStroke" Color="#5B8DEF"/>

    <!--
        One focus ring for the whole application. WPF draws this as an
        adorner sized to the control, so it survives whatever
        ControlTemplate the control itself uses — there is nowhere for a
        keyboard user to lose it. Applied per-control below rather than as
        a blanket TargetType="Control" style, because a style with no key
        only reaches controls that do not already have a more specific
        style of their own — which, in this file, is almost nothing.
    -->
    <Style x:Key="FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-3"
                               StrokeThickness="2"
                               StrokeDashArray="1 2"
                               SnapsToDevicePixels="True"
                               Stroke="{DynamicResource FocusStroke}"
                               RadiusX="4" RadiusY="4"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Same ring, but for the navigation column, which keeps NavFocusStroke
         (a fixed colour tuned for the always-dark sidebar) rather than
         FocusStroke (which is swapped between the light and dark themes for
         the mostly-light or mostly-dark page content). -->
    <Style x:Key="NavFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-2"
                               StrokeThickness="2"
                               StrokeDashArray="1 2"
                               SnapsToDevicePixels="True"
                               Stroke="{DynamicResource NavFocusStroke}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        One typeface, named once. Nothing declared a font before, so the
        application took whatever the machine happened to give it and looked
        different from one PC to the next. The fallbacks matter: Segoe UI
        Variable is Windows 11, Segoe UI is older Windows, and the last two keep
        rupee signs and the ✕ on a remove button from turning into boxes.
    -->
    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI, Nirmala UI, Segoe UI Symbol</FontFamily>

    <!--
        And one scale. There were twelve sizes in use, including 10.5, 11.5,
        12.5 and 13.5 — differences nobody can see on purpose but which make the
        screen feel unsettled. Five steps, each with a job.
    -->
    <system:Double x:Key="FontHeading">21</system:Double>
    <system:Double x:Key="FontFigure">20</system:Double>
    <system:Double x:Key="FontSubheading">14</system:Double>
    <system:Double x:Key="FontBody">13</system:Double>
    <system:Double x:Key="FontLabel">12</system:Double>
    <system:Double x:Key="FontSmall">11</system:Double>

    <!-- Typography -->
    <Style x:Key="H1" TargetType="TextBlock">
        <Setter Property="FontSize" Value="21"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
    </Style>

    <Style x:Key="H2" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <Style x:Key="Label" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource InkMuted}"/>
        <Setter Property="Margin" Value="0,0,0,3"/>
    </Style>

    <Style x:Key="Muted" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource InkMuted}"/>
    </Style>

    <!--
        The label for a field that will not save empty. Same typography as the
        Label style above so the two sit level in a column; the asterisk is the
        only difference, and it is described to a screen reader rather than left
        as a punctuation mark nobody announces.
    -->
    <Style TargetType="local:RequiredLabel">
        <Setter Property="Margin" Value="0,0,0,3"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:RequiredLabel">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{TemplateBinding Text}"
                                   FontSize="{StaticResource FontLabel}"
                                   Foreground="{DynamicResource InkMuted}"/>
                        <TextBlock Text="*" Margin="3,0,0,0"
                                   FontSize="{StaticResource FontLabel}"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource Danger}"
                                   ToolTip="Required"
                                   AutomationProperties.Name="required"/>
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        A link out of the application. Accent rather than the browser blue,
        which belongs to no palette here and reads as a foreign object on a
        dark panel; underlined only on hover, so a line of small print does not
        arrive already decorated.
    -->
    <Style TargetType="Hyperlink">
        <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
        <Setter Property="TextDecorations" Value="{x:Null}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="TextDecorations" Value="Underline"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Same link on the navigation column, which stays dark in both themes
         and so needs its own ink rather than the page accent. -->
    <Style x:Key="NavLink" TargetType="Hyperlink" BasedOn="{StaticResource {x:Type Hyperlink}}">
        <Setter Property="Foreground" Value="{DynamicResource NavInkBright}"/>
    </Style>

    <!-- ── Text box ──────────────────────────────────────────────────────── -->

    <Style TargetType="TextBox">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
        <Setter Property="Padding" Value="9,7"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        <Setter Property="Background" Value="{DynamicResource InputFill}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource InputStroke}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Accent}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource Accent}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd"
                            CornerRadius="{StaticResource FieldRadius}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      Focusable="False"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource InputStrokeHover}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource InputStrokeFocus}"/>
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface}"/>
                            <Setter TargetName="Bd" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#0F766E" BlurRadius="7" ShadowDepth="0" Opacity="0.30"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource InputFillDisabled}"/>
                            <Setter Property="Foreground" Value="{DynamicResource InkMuted}"/>
                        </Trigger>
                        <!-- Last, so a field the save just refused stays marked
                             even while it is hovered or focused — the operator
                             is looking straight at it and the reason has to
                             still be on screen. Cleared as soon as they type. -->
                        <Trigger Property="local:Field.IsMissing" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Danger}"/>
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource DangerFill}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Password box ──────────────────────────────────────────────────── -->

    <!-- Same chrome as TextBox — PasswordBox is its own control type in WPF
         and does not inherit the style above, so it needs its own copy. -->
    <Style TargetType="PasswordBox">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
        <Setter Property="Padding" Value="9,7"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        <Setter Property="Background" Value="{DynamicResource InputFill}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource InputStroke}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Accent}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource Accent}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="Bd"
                            CornerRadius="{StaticResource FieldRadius}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      Focusable="False"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource InputStrokeHover}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource InputStrokeFocus}"/>
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface}"/>
                            <Setter TargetName="Bd" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#0F766E" BlurRadius="7" ShadowDepth="0" Opacity="0.30"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource InputFillDisabled}"/>
                            <Setter Property="Foreground" Value="{DynamicResource InkMuted}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Date picker ───────────────────────────────────────────────────── -->

    <!-- DatePicker hosts its own text box type, so it needs its own chrome. -->
    <Style TargetType="DatePickerTextBox">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Accent}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource Accent}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="9,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DatePickerTextBox">
                    <ScrollViewer x:Name="PART_ContentHost"
                                  Margin="{TemplateBinding Padding}"
                                  Focusable="False"
                                  VerticalAlignment="Center"
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Hidden"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Calendar glyph button inside the date picker -->
    <ControlTemplate x:Key="DatePickerGlyphTemplate" TargetType="Button">
        <Border x:Name="Chrome" Background="Transparent" CornerRadius="0,5,5,0" Padding="9,0">
            <Path x:Name="Glyph" Width="14" Height="14" Stretch="Uniform"
                  Stroke="{DynamicResource InkMuted}" StrokeThickness="1.4"
                  VerticalAlignment="Center"
                  Data="M 1,3 H 15 M 1,3 A 1,1 0 0 1 2,2 H 14 A 1,1 0 0 1 15,3 V 14 A 1,1 0 0 1 14,15 H 2 A 1,1 0 0 1 1,14 Z M 5,1 V 4 M 11,1 V 4"/>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource PressedFill}"/>
                <Setter TargetName="Glyph" Property="Stroke" Value="{DynamicResource Accent}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="DatePicker">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Background" Value="{DynamicResource InputFill}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource InputStroke}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DatePicker">
                    <Border x:Name="Bd"
                            CornerRadius="{StaticResource FieldRadius}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="True">
                        <Grid x:Name="PART_Root">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <DatePickerTextBox x:Name="PART_TextBox" Grid.Column="0"
                                               VerticalAlignment="Center"
                                               Focusable="{TemplateBinding Focusable}"/>

                            <Button x:Name="PART_Button" Grid.Column="1"
                                    Focusable="False"
                                    Template="{StaticResource DatePickerGlyphTemplate}"/>

                            <Popup x:Name="PART_Popup" Grid.Column="0"
                                   AllowsTransparency="True"
                                   Placement="Bottom"
                                   PlacementTarget="{Binding ElementName=Bd}"
                                   StaysOpen="False"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource InputStrokeHover}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource InputStrokeFocus}"/>
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface}"/>
                            <Setter TargetName="Bd" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#0F766E" BlurRadius="7" ShadowDepth="0" Opacity="0.30"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource InputFillDisabled}"/>
                        </Trigger>
                        <Trigger Property="local:Field.IsMissing" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Danger}"/>
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource DangerFill}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Combo box ─────────────────────────────────────────────────────── -->

    <ControlTemplate x:Key="ComboToggleTemplate" TargetType="ToggleButton">
        <Border x:Name="Bd"
                CornerRadius="{StaticResource FieldRadius}"
                Background="{DynamicResource InputFill}"
                BorderBrush="{DynamicResource InputStroke}"
                BorderThickness="1"
                SnapsToDevicePixels="True">
            <Path x:Name="Arrow" HorizontalAlignment="Right" VerticalAlignment="Center"
                  Margin="0,0,11,0" Data="M 0,0 L 4.5,5 L 9,0"
                  Stroke="{DynamicResource InkMuted}" StrokeThickness="1.6"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource InputStrokeHover}"/>
                <Setter TargetName="Arrow" Property="Stroke" Value="{DynamicResource Ink}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource InputStrokeFocus}"/>
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface}"/>
                <Setter TargetName="Arrow" Property="Stroke" Value="{DynamicResource Accent}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource InputFillDisabled}"/>
                <Setter TargetName="Arrow" Property="Stroke" Value="{DynamicResource ArrowInk}"/>
            </Trigger>
            <!-- The combo's chrome is drawn by this toggle rather than by the
                 ComboBox itself, so the flag has to be read off the ComboBox
                 above it — a plain Trigger here would only see the toggle. -->
            <DataTrigger Value="True"
                         Binding="{Binding (local:Field.IsMissing),
                                   RelativeSource={RelativeSource AncestorType=ComboBox}}">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Danger}"/>
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource DangerFill}"/>
            </DataTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="ComboBoxItem">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="4"
                            BorderThickness="2" BorderBrush="Transparent"
                            Padding="{TemplateBinding Padding}" Margin="3,1">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoft}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Accent}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentDark}"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="MaxHeight" Value="36"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        <!-- Same 9px horizontal inset as TextBox/PasswordBox's Padding, so the
             closed box lines up with a TextBox beside it pixel for pixel
             rather than sitting 1px further in. -->
        <Setter Property="Padding" Value="9,0"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                      Template="{StaticResource ComboToggleTemplate}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                  RelativeSource={RelativeSource TemplatedParent}}"/>

                        <!--
                            Bound to SelectedItem/ItemTemplate rather than the
                            SelectionBoxItem pair: those are recomputed by ComboBox
                            internals and came back untemplated here, which rendered
                            the type name. This is deterministic — an ItemTemplate is
                            honoured, and a plain value falls back to ToString().

                            MaxHeight="36" on the ComboBox above clamps the closed
                            box itself: an ItemTemplate rich enough to want more
                            than one line (a couple of screens use one) used to
                            grow the whole control past every TextBox beside it —
                            that was the actual mismatch this fixes. Capped here,
                            an oversized item clips instead of stretching the row.
                        -->
                        <ContentPresenter x:Name="Selected"
                                          Margin="9,0,28,0"
                                          IsHitTestVisible="False"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Left"
                                          Content="{Binding SelectedItem, RelativeSource={RelativeSource TemplatedParent}}"
                                          ContentTemplate="{Binding ItemTemplate, RelativeSource={RelativeSource TemplatedParent}}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/>

                        <!-- Only shown when IsEditable is set; the prescription grid uses it. -->
                        <TextBox x:Name="PART_EditableTextBox"
                                 Margin="1" Padding="9,0,28,0"
                                 Background="Transparent" BorderThickness="0"
                                 VerticalContentAlignment="Center"
                                 Visibility="Collapsed"
                                 Focusable="True"
                                 IsReadOnly="{TemplateBinding IsReadOnly}"/>

                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="True"
                               Placement="Bottom"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               PopupAnimation="Fade"
                               Focusable="False">
                            <Border Margin="0,4,6,6"
                                    Background="{DynamicResource Surface}"
                                    BorderBrush="{DynamicResource Border}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    MinWidth="{TemplateBinding ActualWidth}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <Border.Effect>
                                    <DropShadowEffect Color="#26323C" BlurRadius="12" ShadowDepth="2" Opacity="0.18"/>
                                </Border.Effect>
                                <ScrollViewer Margin="0,4" SnapsToDevicePixels="True">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Selected" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="PART_Popup" Property="IsOpen" Value="False"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Other inputs ──────────────────────────────────────────────────── -->

    <Style TargetType="CheckBox">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!--
        An on/off switch, not a tick box — for a setting that is a genuine
        binary state (a module is on or it is off) rather than a choice from a
        list of many. Still a CheckBox underneath, so IsChecked binds exactly
        as it always did; only the visual is different. Named rather than
        applied to every CheckBox, since a tick box is still right for
        "Registered for GST" or "Print the receipt" — a setting read as a
        question, not a state.
    -->
    <Style x:Key="ToggleSwitch" TargetType="CheckBox">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <DockPanel Background="Transparent" SnapsToDevicePixels="True">
                        <Border x:Name="Track" DockPanel.Dock="Left"
                                Width="42" Height="24" CornerRadius="12"
                                Background="{DynamicResource InputStroke}"
                                BorderBrush="{DynamicResource Border}" BorderThickness="1"
                                VerticalAlignment="Center">
                            <Border x:Name="Thumb" Width="18" Height="18" CornerRadius="9"
                                    Background="White" HorizontalAlignment="Left" Margin="2,0,0,0">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="ThumbTransform" X="0"/>
                                </Border.RenderTransform>
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="3" ShadowDepth="0.5" Opacity="0.35" Color="#000000"/>
                                </Border.Effect>
                            </Border>
                        </Border>
                        <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Accent}"/>
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentDark}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ThumbTransform" Storyboard.TargetProperty="X"
                                                         To="18" Duration="0:0:0.12"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ThumbTransform" Storyboard.TargetProperty="X"
                                                         To="0" Duration="0:0:0.12"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ListBox">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
        <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        <Setter Property="Background" Value="{DynamicResource Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource InputStroke}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <Border CornerRadius="{StaticResource FieldRadius}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer Margin="0,3" Focusable="False">
                            <ItemsPresenter/>
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ListBoxItem">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
        <Setter Property="Padding" Value="9,6"/>
        <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="4"
                            BorderThickness="2" BorderBrush="Transparent"
                            Padding="{TemplateBinding Padding}" Margin="3,1">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverFill}"/>
                        </Trigger>
                        <!-- Selected reads by shape (a left-weighted border) and
                             weight as well as fill, so it survives when Accent
                             and the row's own colour are hard to tell apart. -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Accent}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentDark}"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Buttons ───────────────────────────────────────────────────────── -->

    <Style x:Key="BtnBase" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <!-- Centred by default, but a caller can left-align — a search suggestion
             has to line up under the box it came from, not float in the middle. -->
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            CornerRadius="{StaticResource FieldRadius}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <Border.Effect>
                            <DropShadowEffect Color="#26323C" BlurRadius="4" ShadowDepth="1" Opacity="0.16"/>
                        </Border.Effect>
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#26323C" BlurRadius="7" ShadowDepth="2" Opacity="0.22"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <!-- Pressed: drop the lift so the button reads as pushed in. -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform Y="1"/>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="Bd" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#26323C" BlurRadius="2" ShadowDepth="0" Opacity="0.18"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            <Setter TargetName="Bd" Property="Effect" Value="{x:Null}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BtnPrimary" TargetType="Button" BasedOn="{StaticResource BtnBase}">
        <Setter Property="Background" Value="{DynamicResource AccentFill}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentDark}"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>

    <!--
        The one action a screen exists for — Book visit, Save & print bill.
        A named style rather than Height="42" written on the button, so "this is
        the big one" is a decision recorded once instead of a number that drifts
        to 38 on one screen and 44 on another.
    -->
    <Style x:Key="BtnPrimaryLarge" TargetType="Button" BasedOn="{StaticResource BtnPrimary}">
        <Setter Property="MinHeight" Value="44"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Padding" Value="18,10"/>
    </Style>

    <Style x:Key="BtnGhost" TargetType="Button" BasedOn="{StaticResource BtnBase}">
        <Setter Property="Background" Value="{DynamicResource GhostFill}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource InputStroke}"/>
        <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
    </Style>

    <Style x:Key="BtnDanger" TargetType="Button" BasedOn="{StaticResource BtnBase}">
        <Setter Property="Background" Value="{DynamicResource GhostFill}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource InputStroke}"/>
        <Setter Property="Foreground" Value="{DynamicResource Danger}"/>
    </Style>

    <!-- ── Cards and grids ───────────────────────────────────────────────── -->

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#26323C" BlurRadius="10" ShadowDepth="1" Opacity="0.07"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="DataGrid">
        <!-- Anything narrowed past its text ends in an ellipsis rather than
             being chopped mid-character. Reaches the plain columns that name no
             ElementStyle of their own, and the TextBlocks inside the badge and
             chip templates, where it does no harm.

             First in the style because a property element cannot sit between
             setters. -->
        <!--
            No horizontal scrollbar, ever.

            Every column in this application is star-weighted, so the columns
            divide whatever width the grid is given rather than adding up to
            some total of their own — which means there is nothing to scroll to.
            Disabled here is the guarantee: it hands the grid a finite width to
            divide, and makes a column that somehow still does not fit trim with
            an ellipsis instead of hiding behind a scrollbar the operator has to
            find.

            A grid the operator has to scroll sideways is a grid where the
            AMOUNT column is off screen while they are reading it out to a
            customer.
        -->
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        <!--
            DataGridTextColumn builds its own TextBlock and pushes the column's
            own Foreground onto it, and a column sits outside the visual tree,
            so it never picks up the Ink set just above. Its default is the OS
            control-text colour — black, unreadable on every dark surface here.
            Template columns were unaffected, which is why one row could hold
            readable and unreadable cells side by side.

            Fixed by giving every text column the GridText element style below,
            rather than by a Resources setter here: setting Resources from a
            Style throws when the grid's template is applied.
        -->
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <!-- Its own weight, well under the border round the outside. A rule as
             dark as the frame, drawn between every pair of rows, is most of what
             made these look like spreadsheets. -->
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource GridLine}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="{DynamicResource Surface}"/>
        <Setter Property="RowBackground" Value="{DynamicResource Surface}"/>
        <Setter Property="AlternatingRowBackground" Value="{DynamicResource SurfaceMuted}"/>
        <!--
            RowBackground/AlternatingRowBackground above are set for anyone
            reading the intent, but WPF only applies them by coercing
            DataGridRow.Background when that property's current value came
            from a lower-precedence source than they did — and our own
            DataGridRow style (below) sets Background at the same "Style"
            precedence, so the coercion never wins and the row falls back to
            its built-in default (the OS window colour, always near-white).
            AlternationCount drives the AlternationIndex trigger in that style
            instead, which is what actually paints the rows.
        -->
        <Setter Property="AlternationCount" Value="2"/>
        <Setter Property="FontSize" Value="13"/>
        <!--
            40, not 46. The extra six pixels were meant to stop a row reading as
            a spreadsheet line, but the weight of the rule between rows was
            doing that; with a proper hairline the height only pushed rows apart
            and cost four or five of them off the bottom of every screen.

            The two grids that stack a drug name under the brand set their own
            height, since theirs is a genuinely taller row.
        -->
        <Setter Property="RowHeight" Value="40"/>
        <Setter Property="SelectionMode" Value="Single"/>
        <Setter Property="CanUserAddRows" Value="False"/>
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{DynamicResource HeaderFill}"/>
        <Setter Property="Foreground" Value="{DynamicResource InkMuted}"/>
        <Setter Property="FontSize" Value="11"/>
        <!-- A column label is scaffolding. Bold, it competed with the rows it
             was labelling; at normal weight the eye goes to the data. -->
        <Setter Property="FontWeight" Value="Normal"/>
        <!-- 14 either side read as generous on a two-column grid and as waste on
             a nine-column one, where it was 28px of nothing per column and the
             headers were being clipped to pay for it. -->
        <Setter Property="Padding" Value="10,10"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
        <!-- Bottom rule only. The per-column dividers chopped the header into
             boxes, which is the main thing that made these grids read as a
             spreadsheet next to the counter's list. -->
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
    </Style>

    <!--
        ── What goes in the cells ─────────────────────────────────────────────

        The grid chrome was themed already; these are for the content, and they
        are keyed rather than implicit because only the column author knows
        which of them a column wants.

        Numbers are the point of most of these grids — quantities, rates, MRPs,
        stock — and they were left-aligned, so the units, tens and hundreds of a
        column never lined up and a figure could not be compared with the one
        below it without reading both. Right-aligned, with tabular figures so
        every digit takes the same width whatever the typeface would rather do.
    -->
    <!--
        The plain text cell. Only reason it exists is Foreground: without an
        element style of its own a DataGridTextColumn renders black, whatever
        the grid, the row and the cell around it say. Every text column needs
        this or one of the styles based on it.
    -->
    <Style x:Key="GridText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style x:Key="GridNumber" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        <Setter Property="TextAlignment" Value="Right"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
        <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
    </Style>

    <!-- The header has to move with its column or the label sits over the
         wrong end of the figures. -->
    <Style x:Key="GridNumberHeader" TargetType="DataGridColumnHeader"
           BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
        <Setter Property="HorizontalContentAlignment" Value="Right"/>
    </Style>

    <!-- Money that is being asked for or paid, as against the rates and
         quantities it was worked out from. One per row at most. -->
    <Style x:Key="GridAmount" TargetType="TextBlock" BasedOn="{StaticResource GridNumber}">
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- The column that says which row this is: the medicine, the patient, the
         bill. One per grid, and it carries the weight. -->
    <Style x:Key="GridName" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <!-- Supporting detail — the maker, the supplier, a note. Present when
         looked for, quiet when not. -->
    <Style x:Key="GridMuted" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource InkMuted}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <!-- Anything that would otherwise be cut off mid-word. A composition or an
         address is worth reading, and "Dextromethorphar" is not. -->
    <Style x:Key="GridWrap" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!--
        A short code in a quiet box — a rack number, a batch, a schedule. It is
        a label to be matched against a shelf or a pack, not a sentence, and
        boxing it stops it reading as more prose in a row full of prose.
    -->
    <Style x:Key="GridChip" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource BadgeFill}"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="6,2"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="GridChipText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSmall}"/>
        <Setter Property="Foreground" Value="{DynamicResource InkMuted}"/>
    </Style>

    <!-- Nothing recorded. An em dash says "we know, and there is none" where a
         blank cell only says the screen might be broken. -->
    <Style x:Key="GridEmpty" TargetType="TextBlock">
        <Setter Property="Text" Value="—"/>
        <Setter Property="Foreground" Value="{DynamicResource InkMuted}"/>
        <Setter Property="Opacity" Value="0.7"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!--
        The schedule a medicine is on. Bind a DrugSchedule to it.

        H1 and X carry real obligations — a register kept for three years, a
        prescription retained — so they are called out. An unscheduled medicine
        is the ordinary case and says nothing rather than spending a badge on
        it; the column was showing "None" cut down to "Non", which was worse
        than blank.
    -->
    <DataTemplate x:Key="ScheduleBadge">
        <Grid VerticalAlignment="Center">
            <TextBlock x:Name="Nothing" Style="{StaticResource GridEmpty}" Visibility="Collapsed"/>

            <Border x:Name="Box" Style="{StaticResource GridChip}"
                    Background="{DynamicResource DangerFill}">
                <TextBlock x:Name="Mark" Text="{Binding}" Style="{StaticResource GridChipText}"
                           FontWeight="SemiBold" Foreground="{DynamicResource DangerInk}"/>
            </Border>
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding}" Value="None">
                <Setter TargetName="Box" Property="Visibility" Value="Collapsed"/>
                <Setter TargetName="Nothing" Property="Visibility" Value="Visible"/>
            </DataTrigger>
            <!-- H is prescription-only but not registrable: worth marking,
                 not worth alarming anyone. -->
            <DataTrigger Binding="{Binding}" Value="H">
                <Setter TargetName="Box" Property="Background" Value="{DynamicResource WarnFill}"/>
                <Setter TargetName="Mark" Property="Foreground" Value="{DynamicResource WarnInk}"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!--
        What is left on the shelf. Bind a Product to it.

        A plain figure when there is plenty, because a column of pills is a
        column nobody reads. The badge appears only when the answer is not
        "fine" — which is the whole reason for having one.
    -->
    <DataTemplate x:Key="StockBadge">
        <Border x:Name="Pill" Style="{StaticResource GridChip}"
                HorizontalAlignment="Right" Background="Transparent" Padding="0">
            <TextBlock x:Name="Count" Text="{Binding StockOnHand}"
                       Foreground="{DynamicResource Ink}"
                       Typography.NumeralAlignment="Tabular"
                       VerticalAlignment="Center"/>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Level}" Value="Low">
                <Setter TargetName="Pill" Property="Background" Value="{DynamicResource WarnFill}"/>
                <Setter TargetName="Pill" Property="Padding" Value="6,2"/>
                <Setter TargetName="Count" Property="Foreground" Value="{DynamicResource WarnInk}"/>
                <Setter TargetName="Count" Property="FontSize" Value="{StaticResource FontSmall}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Level}" Value="Empty">
                <Setter TargetName="Pill" Property="Background" Value="{DynamicResource DangerFill}"/>
                <Setter TargetName="Pill" Property="Padding" Value="6,2"/>
                <!-- "Out", not "0". In a column of figures a nought reads as
                     just another number. -->
                <Setter TargetName="Count" Property="Text" Value="Out"/>
                <Setter TargetName="Count" Property="Foreground" Value="{DynamicResource DangerInk}"/>
                <Setter TargetName="Count" Property="FontSize" Value="{StaticResource FontSmall}"/>
                <Setter TargetName="Count" Property="FontWeight" Value="SemiBold"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!--
        BasedOn the type's own default style rather than replacing it: a
        DataGridRow's real template also hosts the RowDetailsPresenter (used
        by the data-health merge screen) and the alternation machinery, and
        redeclaring TargetType="DataGridRow" with no BasedOn would blank all
        of that out. This only adds the cues on top.
    -->
    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
        <Setter Property="Background" Value="{DynamicResource Surface}"/>
        <Style.Triggers>
            <Trigger Property="AlternationIndex" Value="1">
                <Setter Property="Background" Value="{DynamicResource SurfaceMuted}"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource HoverFill}"/>
            </Trigger>
            <!-- A selected row is never fill alone: the left edge gets a
                 solid accent bar and the text goes semibold, so it still
                 reads once the fill and the row beneath it look alike. -->
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                <Setter Property="BorderThickness" Value="3,0,0,0"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--
        BasedOn the type's default style pulls in its selected-state trigger
        too — that one paints the cell with the OS highlight colour (opaque),
        which sat on top of and hid the row's own AccentSoft selection tint
        from the DataGridRow style above, leaving a near-white cell with
        near-white text. Backing that out to Transparent lets the row's tint
        show through; Foreground then just stays Ink, which already reads
        correctly against AccentSoft in both themes.
    -->
    <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
        <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        <!-- Matches the header above it, so a figure sits under its own label. -->
        <Setter Property="Padding" Value="10,0"/>
        <!--
            The cell stretches to the full height of its row. It used to be
            VerticalAlignment=Center, which shrank each cell to the height of
            whatever was in it and floated it in the middle of the row — and
            since the horizontal grid line is drawn as the cell's own bottom
            border, the rule went with it. Every cell drew its rule at its own
            height, so a row of equal-length text looked like one clean line and
            anything else did not: an empty cell drew a stub in mid-air, and a
            two-line cell drew its rule above its neighbours'.

            The content is centred inside the template instead, which is where
            that belongs.
        -->
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <!--
            The stock cell template hardcodes its Border with no Padding
            TemplateBinding, so the Padding above would be ignored without
            this. Same shape as the default otherwise — the border is what
            carries the selection/focus setters the base style still drives.
        -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="Transparent"/>
                <!-- The base style also swaps BorderBrush to the OS highlight
                     colour here, which drew a light box around every cell of
                     the selected row. The row's accent bar and tint already
                     say which row is selected. -->
                <Setter Property="BorderBrush" Value="Transparent"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--
        TabControl's built-in style sets Foreground to the OS control-text
        colour (black). A theme style's setter outranks property inheritance,
        so that black won over the Ink inherited from the window and every
        unstyled TextBlock *inside* a tab came out black on a dark ground —
        the Reports totals were the visible case, while the figures above the
        tabs were fine because they sit outside the TabControl. Naming
        Foreground here puts it back at Style precedence, where it wins.

        The tab headers are unaffected: TabItem's own theme style sets its
        Foreground, which still applies over what it would inherit from here,
        and its strip is drawn light in both themes.
    -->
    <Style TargetType="TabControl">
        <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
    </Style>

    <!--
        Foreground here is the colour the tab's *content* inherits, not the
        tab's own label: a TabItem's content keeps the TabItem as its logical
        parent even though the TabControl's template is what displays it, so
        inheritance comes from here. It was picking up the stock style's
        black, which is what put black totals on the dark Reports panel.

        The label is coloured inside the template instead, by setting
        TextElement.Foreground on the header presenter directly, so the two
        can differ — the strip is drawn light in both themes, and its text
        has to stay dark to be read.
    -->
    <Style TargetType="TabItem">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
        <Setter Property="Padding" Value="14,7"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Bd"
                            Background="{DynamicResource BadgeFill}"
                            BorderBrush="{DynamicResource Border}"
                            BorderThickness="1,1,1,0"
                            CornerRadius="6,6,0,0"
                            Margin="0,0,2,0"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter x:Name="Header"
                                          ContentSource="Header"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Center"
                                          TextElement.Foreground="{DynamicResource InkMuted}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Header" Property="TextElement.Foreground" Value="{DynamicResource Ink}"/>
                        </Trigger>
                        <!-- Selected reads by fill, weight and colour together,
                             the same way the doctor tabs and grid rows do. -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            <Setter TargetName="Bd" Property="BorderThickness" Value="1,3,1,0"/>
                            <Setter TargetName="Header" Property="TextElement.Foreground" Value="{DynamicResource Accent}"/>
                            <Setter TargetName="Header" Property="TextElement.FontWeight" Value="Bold"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Header" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Doctor tabs: radio buttons drawn as tabs, so exactly one is ever active. -->
    <Style x:Key="DoctorTab" TargetType="RadioButton">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="Foreground" Value="{DynamicResource InkMuted}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="Transparent" Padding="14,9,14,10"
                            BorderBrush="Transparent" BorderThickness="0,0,0,3">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HeaderFill}"/>
                        </Trigger>
                        <!-- The active doctor tab is never colour alone: the
                             underline appears (shape), the text goes bold
                             (weight) and switches to Accent (colour) together. -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoft}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
