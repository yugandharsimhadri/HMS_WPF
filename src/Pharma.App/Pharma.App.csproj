<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>TwinkleHMS</AssemblyName>
    <RootNamespace>Pharma.App</RootNamespace>

    <!-- Regenerate it with the IconGen tool under tools/IconGen. -->
    <ApplicationIcon>twinkle.ico</ApplicationIcon>

    <Product>Twinkle Children's Hospital</Product>
    <Company>Twinkle Children's Hospital</Company>
    <!--
        One field to bump, and it must be bumped before every publish.

        major.minor.patch.PUBLISH. The fourth part is the publish number: it
        counts the builds that actually went out to a clinic, and it is the
        thing a support call turns on. Without it every release since 1.0.0 is
        called 1.0.0, and "which version are you on?" has no useful answer.

        1.0.0.3 was the last build published to the customer, so this — the one
        under development — is .4. Bump it again the moment .4 has gone out.

        It sets the assembly version, the file version Add or remove programs
        lists, the name of the setup file, and the line in the sidebar. They
        cannot disagree because there is only one of them.
    -->
    <Version>1.0.0.4</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pharma.Core\Pharma.Core.csproj" />
    <ProjectReference Include="..\Pharma.Data\Pharma.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Sits beside the exe so a clinic can change paths without a rebuild.
         PreserveNewest, not Always: a path edited on the clinic PC survives the
         next build instead of being silently put back. -->
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />

    <!-- The window icon, as well as the one on the exe. -->
    <Resource Include="twinkle.ico" />

    <!-- The letterhead printed at the top of every document. Compiled in
         rather than copied beside the exe: the installer ships a single file,
         and a header that can go missing is a header that will.

         EmbeddedResource, not Resource: it is read through the assembly rather
         than a pack:// URI, so it loads the same way inside the application and
         inside the test host, which has no WPF Application to resolve pack
         URIs against. -->
    <EmbeddedResource Include="Assets\Header.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- AppLog and its Forget() extension are used across every view model. -->
    <Using Include="Pharma.Data" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.*" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.*" />
    <!-- Report export: QuestPDF (Community licence — free under ~$1M USD annual revenue) and
         ClosedXML (MIT) for real .xlsx workbooks with numeric/date cells. -->
    <PackageReference Include="QuestPDF" Version="2025.*" />
    <PackageReference Include="ClosedXML" Version="0.*" />
  </ItemGroup>

</Project>
