<!--
    The light palette. Every key here also exists in Theme.Dark.xaml, and the
    two are swapped at runtime, so anything that wants to follow the theme must
    reference these by DynamicResource rather than StaticResource.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="Bg"          Color="#F4F6F8"/>
    <SolidColorBrush x:Key="Surface"     Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Border"      Color="#DCE1E7"/>
    <SolidColorBrush x:Key="Ink"         Color="#1B2733"/>
    <!-- Darkened from #61707E: the old value cleared 4.5:1 against white by a
         hair (5.09) but fell to 4.52 on the grid header fill — one rounding
         error from failing WCAG AA. This clears every surface with margin. -->
    <SolidColorBrush x:Key="InkMuted"    Color="#57636F"/>
    <SolidColorBrush x:Key="Accent"      Color="#0F766E"/>
    <SolidColorBrush x:Key="AccentDark"  Color="#0B5A54"/>
    <SolidColorBrush x:Key="Danger"      Color="#B42318"/>
    <SolidColorBrush x:Key="Warn"        Color="#B54708"/>
    <SolidColorBrush x:Key="NavBg"       Color="#12303A"/>

    <!-- Quieter surfaces: a completed tile, a token badge, a warning band. -->
    <SolidColorBrush x:Key="SurfaceMuted" Color="#FAFBFC"/>
    <SolidColorBrush x:Key="BadgeFill"    Color="#EDF0F2"/>
    <SolidColorBrush x:Key="AccentSoft"   Color="#E4EFED"/>
    <SolidColorBrush x:Key="WarnFill"     Color="#FFF4E5"/>
    <!-- Darkened from #F5B742: that stroke read at 1.65:1 against WarnFill,
         so the warning band's own border was nearly invisible. -->
    <SolidColorBrush x:Key="WarnStroke"   Color="#B5740E"/>
    <SolidColorBrush x:Key="WarnInk"      Color="#7A4B00"/>

    <!-- The same pair for something that is wrong rather than merely worth
         watching: out of stock, a restricted schedule. DangerInk on DangerFill
         is 7.4:1 here, so it reads at badge size. -->
    <SolidColorBrush x:Key="DangerFill"   Color="#FDECEA"/>
    <SolidColorBrush x:Key="DangerInk"    Color="#8C2318"/>
    <SolidColorBrush x:Key="NavInk"       Color="#D6E2E6"/>
    <SolidColorBrush x:Key="NavInkBright" Color="#BFE3DF"/>
    <SolidColorBrush x:Key="NavInkFaint"  Color="#7FA3AA"/>
    <!-- Lightened from #6E8F96 (4.00:1 against the nav panel — just under the
         4.5:1 normal text needs) to #7C9BA2 (4.68:1). -->
    <SolidColorBrush x:Key="NavInkFaded"  Color="#7C9BA2"/>

    <!-- Interaction: a row under the pointer, a pressed button, a grid header. -->
    <SolidColorBrush x:Key="HoverFill"   Color="#EDF3F2"/>
    <SolidColorBrush x:Key="PressedFill" Color="#EDF2F5"/>
    <SolidColorBrush x:Key="HeaderFill"  Color="#EEF2F5"/>

    <!-- The rule between two rows. Border is the right weight around the edge
         of a grid and far too heavy repeated forty times down it — that is what
         made these read as spreadsheets rather than as lists. -->
    <SolidColorBrush x:Key="GridLine"    Color="#EDF1F4"/>
    <!-- Darkened from #A9B4BE (2.11:1 — failed the 3:1 a graphical control
         needs) to #66707A (5.04:1), so the combo-box and date-picker glyphs
         are visible to low-vision users, not just decorative. -->
    <SolidColorBrush x:Key="ArrowInk"    Color="#66707A"/>

    <!-- Keyboard focus. Blue appears nowhere else in this palette, so a
         focused control is never mistaken for a selected, hovered or teal
         "current" one — the shape of the ring is the only thing that has to
         be seen, not a shade of the same colour as something else. -->
    <SolidColorBrush x:Key="FocusStroke" Color="#1D4ED8"/>

    <!--
        Input chrome. Fields read as slightly recessed: the fill is darker at the
        top and the border is darker at the top too, which is what the eye reads
        as an inset surface. Buttons do the opposite (light at the top) so they
        read as raised. Same corner radius on both keeps the set coherent.
    -->
    <LinearGradientBrush x:Key="InputFill" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F2F5F8" Offset="0"/>
        <GradientStop Color="#FCFDFD" Offset="0.45"/>
        <GradientStop Color="#FFFFFF" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="InputStroke" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#BAC5CF" Offset="0"/>
        <GradientStop Color="#D6DDE4" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="InputStrokeHover" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#9FAEBB" Offset="0"/>
        <GradientStop Color="#C2CCD5" Offset="1"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="InputStrokeFocus" Color="#0F766E"/>
    <SolidColorBrush x:Key="InputFillDisabled" Color="#F1F3F5"/>

    <!-- The top stop was #17968C, which put white button text at 3.63:1 —
         under the 4.5:1 normal text needs. Both stops now clear it. -->
    <LinearGradientBrush x:Key="AccentFill" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#12847A" Offset="0"/>
        <GradientStop Color="#0F766E" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GhostFill" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFF" Offset="0"/>
        <GradientStop Color="#F1F4F7" Offset="1"/>
    </LinearGradientBrush>

</ResourceDictionary>
