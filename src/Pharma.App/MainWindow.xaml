<Window x:Class="Pharma.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Pharma.App"
        xmlns:vm="clr-namespace:Pharma.App.ViewModels"
        xmlns:views="clr-namespace:Pharma.App.Views"
        Title="Twinkle Children's Hospital — OPD &amp; Pharmacy"
        Icon="twinkle.ico"
        Height="820" Width="1360" WindowStartupLocation="Manual"
        FontFamily="{StaticResource UiFont}"
        Background="{DynamicResource Bg}"
        Foreground="{DynamicResource Ink}">

    <Window.Resources>
        <local:NavBrushConverter x:Key="NavBrush"/>
        <local:NavActiveConverter x:Key="NavActive"/>

        <DataTemplate DataType="{x:Type vm:ConsultationViewModel}">
            <views:ConsultationView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:OpdViewModel}">
            <views:OpdView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PatientsViewModel}">
            <views:PatientsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SaleViewModel}">
            <views:SaleView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProductsViewModel}">
            <views:ProductsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:InventoryViewModel}">
            <views:InventoryView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReportsViewModel}">
            <views:ReportsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView/>
        </DataTemplate>

        <!--
            The current page used to be shown by a background tint alone —
            at 2.5:1 against the nav panel, under the 3:1 a graphical
            indicator needs, and invisible to anyone who cannot tell the tint
            from the panel behind it. "IsCurrent" (bound below, per button,
            to NavActiveConverter) now drives a left bar and bold text as
            well, so which page is open reads even with the tint switched off.
        -->
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource NavFocusVisual}"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource NavInk}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="b" Background="{TemplateBinding Background}" Padding="18,0">
                                <DockPanel>
                                    <Border x:Name="ActiveBar" DockPanel.Dock="Left" Width="4"
                                            Margin="-18,0,14,0" Background="{DynamicResource NavActiveBar}"
                                            Visibility="Collapsed"/>
                                    <ContentPresenter x:Name="cp" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="True">
                                <Setter TargetName="ActiveBar" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="cp" Property="TextElement.FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>

    <Grid IsEnabled="{Binding IsShellEnabled}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="212"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Navigation -->
        <Border Grid.Column="0" Background="{DynamicResource NavBg}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="18,22,18,18">
                    <TextBlock Text="Twinkle" FontSize="{StaticResource FontFigure}" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Children's Hospital" FontSize="{StaticResource FontBody}" FontWeight="SemiBold"
                               Foreground="{DynamicResource NavInkBright}" Margin="0,1,0,0"/>
                    <TextBlock Text="OPD &amp; Pharmacy" FontSize="{StaticResource FontSmall}" Foreground="{DynamicResource NavInkFaint}" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="18,0,18,16">
                    <TextBlock FontSize="{StaticResource FontSmall}"
                               Foreground="{DynamicResource NavInkFaded}" TextWrapping="Wrap"
                               Text="Data is stored on this PC. A backup is taken each day it is opened."/>

                    <!-- Who built it and which build it is, where support can read
                         it out without hunting through menus. -->
                    <Border BorderBrush="{DynamicResource NavInkFaded}" BorderThickness="0,1,0,0"
                            Opacity="0.35" Margin="0,12,0,0"/>

                    <TextBlock Margin="0,10,0,0" FontSize="{StaticResource FontSmall}"
                               Foreground="{DynamicResource NavInkFaint}" TextWrapping="Wrap"
                               Text="{Binding Credit}"
                               AutomationProperties.AutomationId="AppCredit"/>
                    <TextBlock FontSize="{StaticResource FontSmall}"
                               Foreground="{DynamicResource NavInkFaded}"
                               Text="{Binding VersionLabel}"
                               AutomationProperties.AutomationId="AppVersion"/>
                </StackPanel>

                <StackPanel>
                    <Button Style="{StaticResource NavButton}" Content="OPD"
                            Command="{Binding GoCommand}" CommandParameter="opd"
                            AutomationProperties.AutomationId="NavOpd"
                            Background="{Binding ActiveNav, Converter={StaticResource NavBrush}, ConverterParameter=opd}"
                            Tag="{Binding ActiveNav, Converter={StaticResource NavActive}, ConverterParameter=opd}"/>
                    <Button Style="{StaticResource NavButton}" Content="Patients"
                            Command="{Binding GoCommand}" CommandParameter="patients"
                            AutomationProperties.AutomationId="NavPatients"
                            Background="{Binding ActiveNav, Converter={StaticResource NavBrush}, ConverterParameter=patients}"
                            Tag="{Binding ActiveNav, Converter={StaticResource NavActive}, ConverterParameter=patients}"/>
                    <Button Style="{StaticResource NavButton}" Content="Pharmacy counter"
                            Command="{Binding GoCommand}" CommandParameter="sale"
                            AutomationProperties.AutomationId="NavSale"
                            Background="{Binding ActiveNav, Converter={StaticResource NavBrush}, ConverterParameter=sale}"
                            Tag="{Binding ActiveNav, Converter={StaticResource NavActive}, ConverterParameter=sale}"/>
                    <Button Style="{StaticResource NavButton}" Content="Medicines"
                            Command="{Binding GoCommand}" CommandParameter="products"
                            AutomationProperties.AutomationId="NavProducts"
                            Background="{Binding ActiveNav, Converter={StaticResource NavBrush}, ConverterParameter=products}"
                            Tag="{Binding ActiveNav, Converter={StaticResource NavActive}, ConverterParameter=products}"/>
                    <Button Style="{StaticResource NavButton}" Content="Inventory"
                            Command="{Binding GoCommand}" CommandParameter="inventory"
                            AutomationProperties.AutomationId="NavInventory"
                            Background="{Binding ActiveNav, Converter={StaticResource NavBrush}, ConverterParameter=inventory}"
                            Tag="{Binding ActiveNav, Converter={StaticResource NavActive}, ConverterParameter=inventory}"/>
                    <Button Style="{StaticResource NavButton}" Content="Reports"
                            Command="{Binding GoCommand}" CommandParameter="reports"
                            AutomationProperties.AutomationId="NavReports"
                            Background="{Binding ActiveNav, Converter={StaticResource NavBrush}, ConverterParameter=reports}"
                            Tag="{Binding ActiveNav, Converter={StaticResource NavActive}, ConverterParameter=reports}"/>
                    <Button Style="{StaticResource NavButton}" Content="Settings"
                            Command="{Binding GoCommand}" CommandParameter="settings"
                            AutomationProperties.AutomationId="NavSettings"
                            Background="{Binding ActiveNav, Converter={StaticResource NavBrush}, ConverterParameter=settings}"
                            Tag="{Binding ActiveNav, Converter={StaticResource NavActive}, ConverterParameter=settings}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Page -->
        <DockPanel Grid.Column="1">
            <Border DockPanel.Dock="Top" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
                    BorderThickness="0,0,0,1" Padding="24,16">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource H1}"
                               AutomationProperties.AutomationId="PageTitle"/>
                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Muted}" Margin="0,2,0,0"
                               AutomationProperties.AutomationId="PageSubtitle"/>
                </StackPanel>
            </Border>

            <ContentControl Content="{Binding CurrentPage}" Margin="0"/>
        </DockPanel>
    </Grid>

        <!-- Anything opened over the shell. Nothing else can be running at the
             same time, so it can be neither lost nor duplicated. -->
        <Border Background="#8C0B1F24" Visibility="{Binding IsOverlayOpen, Converter={StaticResource BoolToVisible}}">
            <Border Margin="28" Background="{DynamicResource Bg}" CornerRadius="10"
                    BorderBrush="{DynamicResource Border}" BorderThickness="1"
                    AutomationProperties.AutomationId="Overlay">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.45" Color="#000000"/>
                </Border.Effect>
                <ContentControl Content="{Binding Overlay}"/>
            </Border>
        </Border>
    </Grid>
</Window>
