<UserControl x:Class="Pharma.App.Views.SaleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="18"/>
            <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0">

            <!-- Step 1 & 2: pick the medicine, set the quantity -->
            <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Add medicine to the bill" Style="{StaticResource H2}"/>

                    <!-- One wide search box. It filters as you type; no button, and
                         no batch to choose — nearest expiry is picked for you. -->
                    <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,8"
                             ToolTip="Search by brand, drug, maker or rack"
                             AutomationProperties.AutomationId="SaleSearch">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding AddLineCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>

                    <!-- Tall enough to scan the shelf, and it stays put after Add. -->
                    <ListBox ItemsSource="{Binding Matches}" SelectedItem="{Binding SelectedProduct, Mode=TwoWay}"
                             MinHeight="230" MaxHeight="320"
                             AutomationProperties.AutomationId="SaleMatches">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <!-- Opacity rather than a fixed grey, so the secondary
                                     text stays legible on the selected (teal) row. -->
                                <DockPanel LastChildFill="False">
                                    <StackPanel DockPanel.Dock="Left" Width="290">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding GenericName}" FontSize="11" Opacity="0.7"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <StackPanel DockPanel.Dock="Left" Width="120">
                                        <TextBlock Text="{Binding PackSize}" Opacity="0.75"/>
                                        <TextBlock Text="{Binding Manufacturer}" FontSize="11" Opacity="0.6"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <StackPanel DockPanel.Dock="Right" Width="90">
                                        <TextBlock Text="{Binding StockOnHand, StringFormat='{}{0} left'}"
                                                   FontWeight="SemiBold" TextAlignment="Right"/>
                                        <TextBlock Text="{Binding RackLabel}"
                                                   FontSize="11" Opacity="0.6" TextAlignment="Right"/>
                                    </StackPanel>

                                    <StackPanel DockPanel.Dock="Right" Width="100">
                                        <TextBlock Text="{Binding UnitPriceLabel}" FontWeight="SemiBold"
                                                   TextAlignment="Right"/>
                                        <TextBlock Text="{Binding PackPriceLabel}" FontSize="11" Opacity="0.6"
                                                   TextAlignment="Right"/>
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Quantity, discount and Add sit under the list so the flow is
                         top to bottom: find, then how many, then add. -->
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedSummary}"
                                       Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis"
                                       AutomationProperties.AutomationId="SaleSelectedSummary"/>

                            <!-- On the shelf but not in the system: put it in from here
                                 rather than sending the operator away mid-queue. -->
                            <Button Content="Stock came in — add it" Style="{StaticResource BtnGhost}"
                                    HorizontalAlignment="Left" Margin="0,6,0,0" Padding="10,4"
                                    Command="{Binding QuickStockCommand}"
                                    ToolTip="Puts stock on the shelf now, to be reconciled when the supplier bill arrives"
                                    AutomationProperties.AutomationId="SaleQuickStock"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="How many" Style="{StaticResource Label}"/>
                            <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0"
                                     AutomationProperties.AutomationId="SaleQuantity">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding AddLineCommand}"/>
                                </TextBox.InputBindings>
                            </TextBox>
                        </StackPanel>

                        <!-- The unit sits beside the number so it can never be a guess.
                             It remembers what was last used for this medicine. -->
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="of" Style="{StaticResource Label}"/>
                            <ComboBox ItemsSource="{Binding QuantityUnits}"
                                      SelectedItem="{Binding QuantityUnit, Mode=TwoWay}"
                                      Margin="0" VerticalContentAlignment="Center"
                                      AutomationProperties.AutomationId="SaleQuantityUnit"/>
                        </StackPanel>

                        <Button Grid.Column="6" Content="Add to bill" Style="{StaticResource BtnPrimary}"
                                MinWidth="120" VerticalAlignment="Bottom"
                                Command="{Binding AddLineCommand}"
                                AutomationProperties.AutomationId="SaleAddLine"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- The bill -->
            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Bill items" Style="{StaticResource H2}"/>

                    <DataGrid ItemsSource="{Binding Lines}" IsReadOnly="False" CanUserSortColumns="False"
                              AutomationProperties.AutomationId="SaleLinesGrid">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="MEDICINE" Binding="{Binding ProductName}" Width="*" MinWidth="170" IsReadOnly="True"/>
                            <DataGridTextColumn Header="BATCH" Binding="{Binding BatchNo}" Width="110" IsReadOnly="True"/>
                            <DataGridTextColumn Header="EXPIRY" Binding="{Binding Expiry}" Width="70" IsReadOnly="True"/>
                            <!-- Quantity is the only thing that can be changed here.
                                 MRP is what is printed on the pack and belongs to the
                                 batch; editing it moved money with nothing recording it. -->
                            <DataGridTextColumn Header="QTY" Binding="{Binding Quantity, UpdateSourceTrigger=LostFocus}" Width="60"/>
                            <DataGridTextColumn Header="PACKS" Binding="{Binding Packs}" Width="110" IsReadOnly="True"/>
                            <DataGridTextColumn Header="MRP" Binding="{Binding Mrp, StringFormat=N2}" Width="80" IsReadOnly="True"/>
                            <DataGridTextColumn Header="GST %" Binding="{Binding GstRate, StringFormat=N1}" Width="60" IsReadOnly="True"/>
                            <DataGridTextColumn Header="AMOUNT" Binding="{Binding Amount, StringFormat=N2}" Width="90" IsReadOnly="True"/>
                            <DataGridTemplateColumn Width="34">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="✕" ToolTip="Remove line" BorderThickness="0"
                                                Background="Transparent" Foreground="#B42318" Cursor="Hand"
                                                Command="{Binding DataContext.RemoveLineCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </DockPanel>

        <!-- Customer, totals, payment -->
        <Border Grid.Column="2" Style="{StaticResource Card}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Customer" Style="{StaticResource H2}"/>

                    <TextBlock Text="Name" Style="{StaticResource Label}"/>
                    <TextBox Text="{Binding CustomerName, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.AutomationId="SaleCustomerName"/>

                    <TextBlock Text="Prescribed by" Style="{StaticResource Label}"/>
                    <TextBox Text="{Binding DoctorName, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.AutomationId="SaleDoctorName"/>

                    <TextBlock Text="Or pull today's OPD prescription" Style="{StaticResource Label}" Margin="0,4,0,3"/>
                    <ComboBox ItemsSource="{Binding PrescribedVisits}" SelectedItem="{Binding SelectedVisit, Mode=TwoWay}"
                              AutomationProperties.AutomationId="SalePrescriptionVisit">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock>
                                    <Run Text="Token"/><Run Text=" "/><Run Text="{Binding TokenNo}"/>
                                    <Run Text=" · "/><Run Text="{Binding Patient.Name}"/>
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Content="Load prescription" Style="{StaticResource BtnGhost}"
                            Command="{Binding LoadPrescriptionCommand}" Margin="0,0,0,14"
                            AutomationProperties.AutomationId="SaleLoadPrescription"/>

                    <Border BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Margin="0,0,0,12"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Gross" Style="{StaticResource Muted}" Margin="0,0,0,5"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Gross, StringFormat=N2}" Margin="0,0,0,5"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Discount" Style="{StaticResource Muted}" Margin="0,0,0,5"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Discount, StringFormat=N2}" Margin="0,0,0,5"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Taxable value" Style="{StaticResource Muted}" Margin="0,0,0,5"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Taxable, StringFormat=N2}" Margin="0,0,0,5"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="CGST" Style="{StaticResource Muted}" Margin="0,0,0,5"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Cgst, StringFormat=N2}" Margin="0,0,0,5"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="SGST" Style="{StaticResource Muted}" Margin="0,0,0,5"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Sgst, StringFormat=N2}" Margin="0,0,0,5"/>

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Round off" Style="{StaticResource Muted}" Margin="0,0,0,5"/>
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding RoundOff, StringFormat=N2}" Margin="0,0,0,5"/>
                    </Grid>

                    <Border Background="#0F766E" CornerRadius="6" Padding="14,10" Margin="0,10,0,14">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="NET PAYABLE" Foreground="#BFE3DF"
                                       FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Net, StringFormat='₹{0:N2}'}" Foreground="White"
                                       FontSize="22" FontWeight="Bold" HorizontalAlignment="Right"
                                       AutomationProperties.AutomationId="SaleNetTotal"/>
                        </DockPanel>
                    </Border>

                    <TextBlock Text="Payment" Style="{StaticResource Label}"/>
                    <ComboBox ItemsSource="{Binding PaymentModes}" SelectedItem="{Binding PaymentMode, Mode=TwoWay}"/>

                    <Button Content="Save &amp; print bill" Style="{StaticResource BtnPrimaryLarge}"
                            Command="{Binding SaveAndPrintCommand}"
                            AutomationProperties.AutomationId="SaveAndPrint"/>
                    <Button Content="Save without printing" Style="{StaticResource BtnGhost}" Margin="0,8,0,0"
                            Command="{Binding SaveCommand}"
                            AutomationProperties.AutomationId="SaleSave"/>
                    <Button Content="Clear bill" Style="{StaticResource BtnGhost}" Margin="0,8,0,0"
                            Command="{Binding NewBillCommand}"
                            AutomationProperties.AutomationId="SaleClear"/>

                    <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}"
                               TextWrapping="Wrap" Margin="0,12,0,0"
                               AutomationProperties.AutomationId="SaleStatus"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
