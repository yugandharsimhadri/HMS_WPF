<Window x:Class="Pharma.App.Views.DataHealthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Data health check" Height="620" Width="1080"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource UiFont}"
        Background="{DynamicResource Bg}"
        Foreground="{DynamicResource Ink}">

    <DockPanel Margin="18">

        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,12" Padding="16,12">
            <StackPanel>
                <TextBlock Text="Data health check" Style="{StaticResource H2}"/>
                <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                           Text="A medicine whose pack size says 15 while it is set to 1 per pack sells whole strips to anyone asking for tablets, at fifteen times the price, and nothing reports an error. This finds them all and puts them right together."/>
                <TextBlock Text="{Binding Summary}" Margin="0,8,0,0" FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           AutomationProperties.AutomationId="HealthSummary"/>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="{Binding Status}" Style="{StaticResource Muted}"
                           VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="520"
                           AutomationProperties.AutomationId="HealthStatus"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Close" Style="{StaticResource BtnGhost}" Margin="0,0,8,0"
                            Click="Close_Click"
                            AutomationProperties.AutomationId="HealthClose"/>
                    <Button Content="Check again" Style="{StaticResource BtnGhost}" Margin="0,0,8,0"
                            Command="{Binding ScanCommand}"
                            AutomationProperties.AutomationId="HealthScan"/>
                    <Button Content="Put the ticked ones right" Style="{StaticResource BtnPrimary}"
                            Command="{Binding RepairCommand}"
                            AutomationProperties.AutomationId="HealthRepair"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <DataGrid ItemsSource="{Binding Findings}" IsReadOnly="False" CanUserSortColumns="False"
                      AutomationProperties.AutomationId="HealthGrid">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="FIX" Binding="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" Width="44"/>
                    <DataGridTextColumn Header="MEDICINE" Binding="{Binding Medicine}" Width="200" ElementStyle="{StaticResource GridName}" IsReadOnly="True"/>
                    <DataGridTextColumn Header="PROBLEM" Binding="{Binding Problem}" Width="200" ElementStyle="{StaticResource GridWrap}" IsReadOnly="True"/>
                    <DataGridTextColumn Header="NOW" Binding="{Binding Now}" Width="220" ElementStyle="{StaticResource GridWrap}" IsReadOnly="True"/>
                    <DataGridTextColumn Header="AFTER" Binding="{Binding After}" Width="150" IsReadOnly="True"/>
                    <DataGridTextColumn Header="STOCK" Binding="{Binding StockChange}" Width="110" IsReadOnly="True"/>

                    <DataGridTemplateColumn Header="" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Merge…" Style="{StaticResource BtnGhost}" Padding="8,2"
                                        Visibility="{Binding IsDuplicate, Converter={StaticResource BoolToVisible}}"
                                        Command="{Binding DataContext.MergeCommand,
                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        AutomationProperties.AutomationId="HealthMerge"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>

                <DataGrid.RowDetailsTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Explanation}" Style="{StaticResource Muted}"
                                   TextWrapping="Wrap" Margin="46,2,10,8"/>
                    </DataTemplate>
                </DataGrid.RowDetailsTemplate>
            </DataGrid>
        </Border>

    </DockPanel>
</Window>
