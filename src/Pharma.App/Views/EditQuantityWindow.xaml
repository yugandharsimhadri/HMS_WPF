<Window x:Class="Pharma.App.Views.EditQuantityWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Pharma.App"
        Title="Edit quantity" Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        FontFamily="{StaticResource UiFont}"
        Background="{DynamicResource Bg}"
        Foreground="{DynamicResource Ink}">

    <DockPanel Margin="18">

        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,12" Padding="16,12">
            <StackPanel>
                <TextBlock Text="{Binding ProductName}" Style="{StaticResource H2}" TextWrapping="Wrap"
                           AutomationProperties.AutomationId="EditQuantityMedicine"/>
                <TextBlock Style="{StaticResource Muted}">
                    <Run Text="Batch"/><Run Text=" "/><Run Text="{Binding BatchNo, Mode=OneWay}"/>
                </TextBlock>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource BtnGhost}" Margin="0,0,8,0"
                        Click="Cancel_Click"
                        AutomationProperties.AutomationId="EditQuantityCancel"/>
                <Button Content="Update quantity" Style="{StaticResource BtnPrimary}"
                        Command="{Binding ConfirmCommand}"
                        AutomationProperties.AutomationId="EditQuantityConfirm"/>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <local:RequiredLabel Text="Quantity"/>
                <TextBox x:Name="QuantityBox" Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"
                         local:Field.IsMissing="{Binding QuantityMissing}"
                         local:NumericInput.Mode="Whole"
                         FontSize="{StaticResource FontHeading}"
                         AutomationProperties.AutomationId="EditQuantityValue">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding ConfirmCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>

                <TextBlock Text="{Binding PacksPreview}" Style="{StaticResource Muted}" Margin="0,4,0,10"
                           AutomationProperties.AutomationId="EditQuantityPacks"/>

                <Border Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource Border}"
                        BorderThickness="1" CornerRadius="6" Padding="12,10">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="New amount" Style="{StaticResource Muted}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding AmountPreview}" FontWeight="Bold"
                                   FontSize="{StaticResource FontHeading}"
                                   HorizontalAlignment="Right"
                                   AutomationProperties.AutomationId="EditQuantityAmount"/>
                    </DockPanel>
                </Border>
            </StackPanel>
        </Border>

    </DockPanel>
</Window>
