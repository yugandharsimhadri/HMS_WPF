<UserControl x:Class="Pharma.App.Views.GeneralMasterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Pharma.App">

    <UserControl.Resources>
        <!-- The department picker on the Procedures tab — ghost by default,
             filled teal (BtnPrimary's own colours) once selected. Tag
             carries the "am I the selected one" bool since BtnBase's
             template leaves Tag untouched. -->
        <Style x:Key="DeptPill" TargetType="Button" BasedOn="{StaticResource BtnGhost}">
            <Setter Property="Tag" Value="False"/>
            <Style.Triggers>
                <Trigger Property="Tag" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentFill}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentDark}"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Border Style="{StaticResource Card}" Padding="8">
            <TabControl BorderThickness="0" Background="Transparent"
                        AutomationProperties.AutomationId="GeneralMasterTabs">

                <!-- ══════════════════════════════════════════════════════ -->
                <TabItem Header="Vaccine Master"
                         Visibility="{Binding PediatricsEnabled, Converter={StaticResource BoolVis}}">
                    <Grid Margin="16">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                                <Button DockPanel.Dock="Right" Content="+ New vaccine" Style="{StaticResource BtnPrimary}"
                                        Margin="8,0,0,0" Command="{Binding NewVaccineCommand}"
                                        AutomationProperties.AutomationId="PediatricsNewVaccine"/>
                                <Button DockPanel.Dock="Right" Content="Edit" Style="{StaticResource BtnGhost}"
                                        Margin="8,0,0,0" MinWidth="80"
                                        Command="{Binding EditVaccineCommand}"
                                        IsEnabled="{Binding HasMasterVaccine}"
                                        AutomationProperties.AutomationId="PediatricsVaccineEdit"/>
                                <TextBox Text="{Binding VaccineMasterSearch, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0" VerticalAlignment="Center"
                                         AutomationProperties.AutomationId="PediatricsVaccineMasterSearch"/>
                            </DockPanel>

                            <DataGrid ItemsSource="{Binding VaccineMasterRows}" IsReadOnly="True"
                                      SelectedItem="{Binding SelectedMasterVaccine, Mode=TwoWay}"
                                      SelectionMode="Single" RowHeight="40"
                                      AutomationProperties.AutomationId="PediatricsVaccineMasterGrid">
                                <DataGrid.InputBindings>
                                    <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding EditVaccineCommand}"/>
                                </DataGrid.InputBindings>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="VACCINE" Binding="{Binding Name}" Width="200*" MinWidth="120"
                                                        ElementStyle="{StaticResource GridName}"/>
                                    <DataGridTextColumn Header="DOSE" Binding="{Binding DoseNumber}" Width="Auto"
                                                        ElementStyle="{StaticResource GridNumber}"/>
                                    <DataGridTextColumn Header="AGE (DAYS)" Binding="{Binding RecommendedAgeDays}" Width="Auto"
                                                        ElementStyle="{StaticResource GridNumber}"/>
                                    <DataGridTextColumn Header="CATEGORY" Binding="{Binding Category}" Width="Auto"
                                                        ElementStyle="{StaticResource GridMuted}"/>
                                    <DataGridCheckBoxColumn Header="ACTIVE" Binding="{Binding Active}" Width="Auto" IsReadOnly="True"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Grid>
                </TabItem>

                <!-- ══════════════════════════════════════════════════════ -->
                <TabItem Header="Procedures">
                    <Grid Margin="16">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBlock Text="Department" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <Button Content="Pediatrics" Margin="0,0,6,0" MinWidth="90"
                                        Style="{StaticResource DeptPill}" Tag="{Binding IsPediatricsDepartment}"
                                        Visibility="{Binding PediatricsEnabled, Converter={StaticResource BoolVis}}"
                                        Command="{Binding SelectPediatricsDepartmentCommand}"
                                        AutomationProperties.AutomationId="GeneralMasterDeptPediatrics"/>
                                <Button Content="General" Margin="0,0,6,0" MinWidth="90"
                                        Style="{StaticResource DeptPill}" Tag="{Binding IsGeneralDepartment}"
                                        Command="{Binding SelectGeneralDepartmentCommand}"
                                        AutomationProperties.AutomationId="GeneralMasterDeptGeneral"/>
                                <Button Content="Dentist" MinWidth="90"
                                        Style="{StaticResource DeptPill}" Tag="{Binding IsDentistDepartment}"
                                        Visibility="{Binding DentistEnabled, Converter={StaticResource BoolVis}}"
                                        Command="{Binding SelectDentistDepartmentCommand}"
                                        AutomationProperties.AutomationId="GeneralMasterDeptDentist"/>
                            </StackPanel>

                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                                <Button DockPanel.Dock="Right" Content="+ New procedure" Style="{StaticResource BtnPrimary}"
                                        Margin="8,0,0,0" Command="{Binding NewProcedureCommand}"
                                        AutomationProperties.AutomationId="GeneralMasterNewProcedure"/>
                                <Button DockPanel.Dock="Right" Content="Edit" Style="{StaticResource BtnGhost}"
                                        Margin="8,0,0,0" MinWidth="80"
                                        Command="{Binding EditProcedureCommand}"
                                        IsEnabled="{Binding HasMasterProcedure}"
                                        AutomationProperties.AutomationId="GeneralMasterProcedureEdit"/>
                                <TextBox Text="{Binding ProcedureMasterSearch, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0" VerticalAlignment="Center"
                                         AutomationProperties.AutomationId="GeneralMasterProcedureSearch"/>
                            </DockPanel>

                            <DataGrid ItemsSource="{Binding ProcedureMasterRows}" IsReadOnly="True"
                                      SelectedItem="{Binding SelectedMasterProcedure, Mode=TwoWay}"
                                      SelectionMode="Single" RowHeight="40"
                                      AutomationProperties.AutomationId="GeneralMasterProcedureGrid">
                                <DataGrid.InputBindings>
                                    <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding EditProcedureCommand}"/>
                                </DataGrid.InputBindings>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="PROCEDURE" Binding="{Binding Name}" Width="220*" MinWidth="120"
                                                        ElementStyle="{StaticResource GridName}"/>
                                    <DataGridTextColumn Header="CATEGORY" Binding="{Binding Category}" Width="Auto"
                                                        ElementStyle="{StaticResource GridMuted}"/>
                                    <DataGridTextColumn Header="PRICE" Binding="{Binding Price, StringFormat=N2}" Width="Auto"
                                                        ElementStyle="{StaticResource GridNumber}"
                                                        HeaderStyle="{StaticResource GridNumberHeader}"/>
                                    <DataGridCheckBoxColumn Header="ACTIVE" Binding="{Binding Active}" Width="Auto" IsReadOnly="True"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Grid>
                </TabItem>

                <!-- ══════════════════════════════════════════════════════ -->
                <TabItem Header="Dental Replacements"
                         Visibility="{Binding DentistEnabled, Converter={StaticResource BoolVis}}">
                    <Grid Margin="16">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                                <Button DockPanel.Dock="Right" Content="+ New" Style="{StaticResource BtnPrimary}"
                                        Margin="8,0,0,0" Command="{Binding NewReplacementCommand}"
                                        AutomationProperties.AutomationId="DentistNewReplacement"/>
                                <Button DockPanel.Dock="Right" Content="Edit" Style="{StaticResource BtnGhost}"
                                        Margin="8,0,0,0" MinWidth="80"
                                        Command="{Binding EditReplacementCommand}"
                                        IsEnabled="{Binding HasMasterReplacement}"
                                        AutomationProperties.AutomationId="DentistReplacementEdit"/>
                                <TextBox Text="{Binding ReplacementMasterSearch, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0" VerticalAlignment="Center"
                                         AutomationProperties.AutomationId="DentistReplacementMasterSearch"/>
                            </DockPanel>

                            <DataGrid ItemsSource="{Binding ReplacementMasterRows}" IsReadOnly="True"
                                      SelectedItem="{Binding SelectedMasterReplacement, Mode=TwoWay}"
                                      SelectionMode="Single" RowHeight="40"
                                      AutomationProperties.AutomationId="DentistReplacementMasterGrid">
                                <DataGrid.InputBindings>
                                    <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding EditReplacementCommand}"/>
                                </DataGrid.InputBindings>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="REPLACEMENT" Binding="{Binding Name}" Width="180*" MinWidth="100"
                                                        ElementStyle="{StaticResource GridName}"/>
                                    <DataGridTextColumn Header="CATEGORY" Binding="{Binding Category}" Width="Auto"
                                                        ElementStyle="{StaticResource GridMuted}"/>
                                    <DataGridTextColumn Header="UNIT COST" Binding="{Binding UnitCost, StringFormat=N2}" Width="Auto"
                                                        ElementStyle="{StaticResource GridNumber}"
                                                        HeaderStyle="{StaticResource GridNumberHeader}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Grid>
                </TabItem>

                <!-- ══════════════════════════════════════════════════════ -->
                <TabItem Header="Anesthesia Types"
                         Visibility="{Binding DentistEnabled, Converter={StaticResource BoolVis}}">
                    <Grid Margin="16">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                                <Button DockPanel.Dock="Right" Content="+ New" Style="{StaticResource BtnPrimary}"
                                        Margin="8,0,0,0" Command="{Binding NewAnesthesiaTypeCommand}"
                                        AutomationProperties.AutomationId="DentistNewAnesthesiaType"/>
                                <Button DockPanel.Dock="Right" Content="Edit" Style="{StaticResource BtnGhost}"
                                        Margin="8,0,0,0" MinWidth="80"
                                        Command="{Binding EditAnesthesiaTypeCommand}"
                                        IsEnabled="{Binding HasMasterAnesthesiaType}"
                                        AutomationProperties.AutomationId="DentistAnesthesiaTypeEdit"/>
                            </DockPanel>

                            <DataGrid ItemsSource="{Binding AnesthesiaMasterRows}" IsReadOnly="True"
                                      SelectedItem="{Binding SelectedMasterAnesthesiaType, Mode=TwoWay}"
                                      SelectionMode="Single" RowHeight="40"
                                      AutomationProperties.AutomationId="DentistAnesthesiaMasterGrid">
                                <DataGrid.InputBindings>
                                    <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding EditAnesthesiaTypeCommand}"/>
                                </DataGrid.InputBindings>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="TYPE" Binding="{Binding Name}" Width="180*" MinWidth="100"
                                                        ElementStyle="{StaticResource GridName}"/>
                                    <DataGridTextColumn Header="DEFAULT COST" Binding="{Binding DefaultCost, StringFormat=N2}" Width="Auto"
                                                        ElementStyle="{StaticResource GridNumber}"
                                                        HeaderStyle="{StaticResource GridNumberHeader}"/>
                                    <DataGridCheckBoxColumn Header="ACTIVE" Binding="{Binding Active}" Width="Auto" IsReadOnly="True"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Grid>
                </TabItem>

                <!-- ══════════════════════════════════════════════════════ -->
                <TabItem Header="Dental Packages"
                         Visibility="{Binding DentistEnabled, Converter={StaticResource BoolVis}}">
                    <Grid Margin="16">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                                <Button DockPanel.Dock="Right" Content="+ New package" Style="{StaticResource BtnPrimary}"
                                        Margin="8,0,0,0" Command="{Binding NewPackageCommand}"
                                        AutomationProperties.AutomationId="DentistNewPackage"/>
                                <Button DockPanel.Dock="Right" Content="Edit" Style="{StaticResource BtnGhost}"
                                        Margin="8,0,0,0" MinWidth="80"
                                        Command="{Binding EditPackageCommand}"
                                        IsEnabled="{Binding HasMasterPackage}"
                                        AutomationProperties.AutomationId="DentistPackageEdit"/>
                            </DockPanel>

                            <DataGrid ItemsSource="{Binding PackageMasterRows}" IsReadOnly="True"
                                      SelectedItem="{Binding SelectedMasterPackage, Mode=TwoWay}"
                                      SelectionMode="Single" RowHeight="40"
                                      AutomationProperties.AutomationId="DentistPackageMasterGrid">
                                <DataGrid.InputBindings>
                                    <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding EditPackageCommand}"/>
                                </DataGrid.InputBindings>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="PACKAGE" Binding="{Binding Name}" Width="220*" MinWidth="120"
                                                        ElementStyle="{StaticResource GridName}"/>
                                    <DataGridTextColumn Header="PRICE" Binding="{Binding PackagePrice, StringFormat=N2}" Width="Auto"
                                                        ElementStyle="{StaticResource GridNumber}"
                                                        HeaderStyle="{StaticResource GridNumberHeader}"/>
                                    <DataGridCheckBoxColumn Header="ACTIVE" Binding="{Binding Active}" Width="Auto" IsReadOnly="True"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Grid>
                </TabItem>
            </TabControl>
        </Border>
    </Grid>
</UserControl>
