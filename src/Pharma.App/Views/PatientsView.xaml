<UserControl x:Class="Pharma.App.Views.PatientsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Pharma.App">

    <!-- The register and everything behind it. Adding or editing a patient opens
         over the shell, which is what lets this have the whole window. -->
    <Grid Margin="20">

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="14"/>
                <RowDefinition Height="280"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource Card}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right" Content="+ New patient" Style="{StaticResource BtnPrimary}"
                                Margin="8,0,0,0" Command="{Binding NewPatientCommand}"
                                AutomationProperties.AutomationId="PatientsNew"/>
                        <Button DockPanel.Dock="Right" Content="Edit" Style="{StaticResource BtnGhost}"
                                Margin="8,0,0,0" MinWidth="80"
                                Command="{Binding EditPatientCommand}"
                                IsEnabled="{Binding HasPatient}"
                                ToolTip="Opens the highlighted patient. Double-clicking a row does the same."
                                AutomationProperties.AutomationId="PatientsEdit"/>
                        <Button DockPanel.Dock="Right" Content="Clear" Style="{StaticResource BtnGhost}"
                                Margin="8,0,0,0" MinWidth="80" Command="{Binding ClearCommand}"
                                ToolTip="Empties the search and puts the selection down"
                                AutomationProperties.AutomationId="PatientClear"/>
                        <Button DockPanel.Dock="Right" Content="Search" Style="{StaticResource BtnGhost}"
                                Margin="8,0,0,0" Command="{Binding FindCommand}"
                                AutomationProperties.AutomationId="PatientsSearchButton"/>
                        <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0" VerticalAlignment="Center"
                                 AutomationProperties.AutomationId="PatientsSearchBox">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding FindCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                    </DockPanel>

                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" Style="{StaticResource Muted}"
                               TextWrapping="Wrap" Margin="2,10,2,0"
                               AutomationProperties.AutomationId="PatientsStatus"/>

                    <DataGrid ItemsSource="{Binding Patients}" SelectedItem="{Binding SelectedPatient, Mode=TwoWay}"
                              AutomationProperties.AutomationId="PatientsGrid">
                        <!-- Double-click is what people do to a row without being
                             told; the Edit button is what tells them. -->
                        <DataGrid.InputBindings>
                            <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding EditPatientCommand}"/>
                        </DataGrid.InputBindings>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="PATIENT NO" Binding="{Binding PatientNo}" Width="Auto"
                                                ElementStyle="{StaticResource GridMuted}"/>
                            <DataGridTextColumn Header="NAME" Binding="{Binding Name}" Width="220*" MinWidth="105"
                                                ElementStyle="{StaticResource GridName}"/>
                            <DataGridTextColumn Header="PHONE" Binding="{Binding Phone}" Width="Auto" ElementStyle="{StaticResource GridText}"/>
                            <DataGridTextColumn Header="AGE" Binding="{Binding Age}" Width="Auto"
                                                ElementStyle="{StaticResource GridNumber}"
                                                HeaderStyle="{StaticResource GridNumberHeader}"/>
                            <DataGridTextColumn Header="SEX" Binding="{Binding Gender}" Width="Auto"
                                                ElementStyle="{StaticResource GridMuted}"/>
                            <!-- An allergy is the one thing on this row that can
                                 hurt somebody, so it wraps rather than being cut
                                 off at whatever the column happens to fit. -->
                            <DataGridTextColumn Header="ALLERGIES" Binding="{Binding Allergies}" Width="Auto"
                                                ElementStyle="{StaticResource GridWrap}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- Everything this patient has ever had, printable at any time. -->
            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8">
                <TabControl BorderThickness="0" Background="Transparent">

                    <TabItem Header="Visits &amp; prescriptions">
                        <DockPanel Margin="0,10,0,0">
                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="Print prescription" Style="{StaticResource BtnGhost}" Margin="0,0,8,0"
                                        Command="{Binding PrintPrescriptionCommand}"
                                        AutomationProperties.AutomationId="PatientPrintRx"/>
                                <Button Content="Print fee receipt" Style="{StaticResource BtnGhost}"
                                        Command="{Binding PrintReceiptCommand}"
                                        AutomationProperties.AutomationId="PatientPrintReceipt"/>
                            </StackPanel>

                            <!--
                                The one grid that keeps fixed widths and its own
                                scrollbar.

                                Eight columns of real content do not fit the width
                                this card gets, and no sizing mode changes that:
                                auto, star and a suppressed scrollbar all end the
                                same way, with STATUS pushed off the end. A column
                                that silently is not there is worse than one you
                                scroll to — nobody looks for what they cannot see
                                is missing.

                                So this grid opts out: fixed widths, and a
                                scrollbar when it needs one. Everything else in
                                the application sizes to fit.
                            -->
                            <DataGrid ItemsSource="{Binding History}" SelectedItem="{Binding SelectedVisit, Mode=TwoWay}"
                                      HorizontalScrollBarVisibility="Auto"
                                      AutomationProperties.AutomationId="PatientHistoryGrid">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="DATE" Binding="{Binding ScheduledOn, StringFormat='dd MMM yy HH:mm'}" Width="130"
                                                        ElementStyle="{StaticResource GridMuted}"/>
                                    <DataGridTextColumn Header="VISIT NO" Binding="{Binding VisitNo}" Width="90"
                                                        ElementStyle="{StaticResource GridName}"/>
                                    <DataGridTextColumn Header="DOCTOR" Binding="{Binding Doctor.Name}" Width="150" ElementStyle="{StaticResource GridText}"/>
                                    <DataGridTextColumn Header="DIAGNOSIS" Binding="{Binding Diagnosis}" Width="*" MinWidth="140"
                                                        ElementStyle="{StaticResource GridWrap}"/>
                                    <DataGridTextColumn Header="RX" Binding="{Binding Prescription.Count}" Width="50"
                                                        ElementStyle="{StaticResource GridNumber}"
                                                        HeaderStyle="{StaticResource GridNumberHeader}"/>
                                    <DataGridTextColumn Header="FEE" Binding="{Binding Fee, StringFormat=N2}" Width="80"
                                                        ElementStyle="{StaticResource GridAmount}"
                                                        HeaderStyle="{StaticResource GridNumberHeader}"/>
                                    <DataGridTextColumn Header="RECEIPT" Binding="{Binding FeeReceiptNo}" Width="100"
                                                        ElementStyle="{StaticResource GridMuted}"/>
                                    <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="100" ElementStyle="{StaticResource GridText}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </TabItem>

                    <TabItem Header="Medicine bills">
                        <DockPanel Margin="0,10,0,0">
                            <Button DockPanel.Dock="Bottom" Content="Print bill" HorizontalAlignment="Left"
                                    Style="{StaticResource BtnGhost}" Margin="0,10,0,0"
                                    Command="{Binding PrintBillCommand}"
                                    AutomationProperties.AutomationId="PatientPrintBill"/>

                            <DataGrid ItemsSource="{Binding Bills}" SelectedItem="{Binding SelectedBill, Mode=TwoWay}"
                                      AutomationProperties.AutomationId="PatientBillsGrid">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="DATE" Binding="{Binding BillDate, StringFormat='dd MMM yy HH:mm'}" Width="Auto"
                                                        ElementStyle="{StaticResource GridMuted}"/>
                                    <DataGridTextColumn Header="BILL NO" Binding="{Binding BillNo}" Width="Auto"
                                                        ElementStyle="{StaticResource GridName}"/>
                                    <DataGridTextColumn Header="ITEMS" Binding="{Binding Items.Count}" Width="Auto"
                                                        ElementStyle="{StaticResource GridNumber}"
                                                        HeaderStyle="{StaticResource GridNumberHeader}"/>
                                    <DataGridTextColumn Header="DOCTOR" Binding="{Binding DoctorName}" Width="220*" MinWidth="105" ElementStyle="{StaticResource GridText}"/>
                                    <DataGridTextColumn Header="NET" Binding="{Binding NetAmount, StringFormat=N2}" Width="Auto"
                                                        ElementStyle="{StaticResource GridAmount}"
                                                        HeaderStyle="{StaticResource GridNumberHeader}"/>
                                    <DataGridTextColumn Header="MODE" Binding="{Binding PaymentMode}" Width="Auto"
                                                        ElementStyle="{StaticResource GridMuted}"/>
                                    <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="Auto" ElementStyle="{StaticResource GridText}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>
    </Grid>
</UserControl>
