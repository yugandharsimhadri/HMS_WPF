<UserControl x:Class="Pharma.App.Views.AddProcedureLineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Pharma.App"
             Background="{DynamicResource Bg}"
             Width="380">

    <DockPanel Margin="18">

        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,14" Padding="16,12">
            <TextBlock Text="{Binding Header}" Style="{StaticResource H2}"
                       AutomationProperties.AutomationId="AddProcedureLineHeader"/>
        </Border>

        <Border DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource BtnGhost}" Margin="0,0,8,0"
                        MinWidth="100" IsCancel="True"
                        Command="{Binding CancelCommand}"
                        AutomationProperties.AutomationId="AddProcedureLineCancel"/>
                <Button Content="Add" Style="{StaticResource BtnPrimaryLarge}"
                        MinWidth="100" IsDefault="True"
                        Command="{Binding AddCommand}"
                        AutomationProperties.AutomationId="AddProcedureLineAdd"/>
            </StackPanel>
        </Border>

        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" Style="{StaticResource Muted}"
                   TextWrapping="Wrap" Margin="2,10,2,0"
                   AutomationProperties.AutomationId="AddProcedureLineStatus"/>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <local:RequiredLabel Text="Procedure"/>
                <ComboBox ItemsSource="{Binding Procedures}" SelectedItem="{Binding SelectedProcedure, Mode=TwoWay}"
                          DisplayMemberPath="Name"
                          local:Field.IsMissing="{Binding ProcedureMissing}"
                          AutomationProperties.AutomationId="AddProcedureLinePicker"/>

                <TextBlock Text="Quantity" Style="{StaticResource Label}"/>
                <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"
                         local:NumericInput.Mode="Whole"
                         AutomationProperties.AutomationId="AddProcedureLineQuantity"/>
            </StackPanel>
        </Border>
    </DockPanel>
</UserControl>
