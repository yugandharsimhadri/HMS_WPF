<UserControl x:Class="Pharma.App.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Pharma.App">

    <UserControl.Resources>
        <local:ZeroToVisibilityConverter x:Key="ZeroVis"/>
    </UserControl.Resources>

    <DockPanel Margin="20">

        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,14">
            <DockPanel>
                <DatePicker DockPanel.Dock="Right" Width="150" SelectedDate="{Binding Date, Mode=TwoWay}" Margin="0"
                            AutomationProperties.AutomationId="ReportsDate"/>
                <UniformGrid Rows="1" Columns="5">
                    <StackPanel>
                        <TextBlock Text="PHARMACY SALES" Style="{StaticResource Label}"/>
                        <TextBlock Text="{Binding TotalCollected, StringFormat='₹{0:N2}'}" FontSize="{StaticResource FontFigure}" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="CASH" Style="{StaticResource Label}"/>
                        <TextBlock Text="{Binding CashTotal, StringFormat='₹{0:N2}'}" FontSize="{StaticResource FontFigure}" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="UPI" Style="{StaticResource Label}"/>
                        <TextBlock Text="{Binding UpiTotal, StringFormat='₹{0:N2}'}" FontSize="{StaticResource FontFigure}" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="CONSULTATION FEES" Style="{StaticResource Label}"/>
                        <TextBlock Text="{Binding ConsultationTotal, StringFormat='₹{0:N2}'}" FontSize="{StaticResource FontFigure}" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="OPD VISITS" Style="{StaticResource Label}"/>
                        <TextBlock Text="{Binding VisitCount}" FontSize="{StaticResource FontFigure}" FontWeight="Bold"/>
                    </StackPanel>
                </UniformGrid>
            </DockPanel>
        </Border>

        <Border Style="{StaticResource Card}" Padding="8">
            <DockPanel>

                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Right" Margin="4,2,4,4">
                    <Button Content="Export PDF" Style="{StaticResource BtnGhost}" Padding="12,6" Margin="0,0,8,0"
                            Command="{Binding ExportPdfCommand}" AutomationProperties.AutomationId="ReportsExportPdf"/>
                    <Button Content="Export Excel" Style="{StaticResource BtnGhost}" Padding="12,6"
                            Command="{Binding ExportExcelCommand}" AutomationProperties.AutomationId="ReportsExportExcel"/>
                </StackPanel>

                <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" Style="{StaticResource Muted}"
                           Margin="4,6,4,0" TextWrapping="Wrap"
                           AutomationProperties.AutomationId="ReportsStatus"/>

                <TabControl BorderThickness="0" Background="Transparent"
                            SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}"
                            AutomationProperties.AutomationId="ReportsTabs">

                    <TabItem Header="Day book">
                        <DockPanel Margin="0,10,0,0">

                            <!-- Finding and reprinting an old bill. A walk-in has no
                                 patient record, so the bill number or the name on it
                                 are the only handles when someone comes back for a copy. -->
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                <TextBlock DockPanel.Dock="Left" Text="Find any bill" VerticalAlignment="Center"
                                           Style="{StaticResource Label}" Margin="0,0,10,0"/>
                                <Button DockPanel.Dock="Right" Content="Reprint selected bill"
                                        Style="{StaticResource BtnGhost}" Margin="8,0,0,0"
                                        Command="{Binding ReprintBillCommand}"
                                        AutomationProperties.AutomationId="ReprintBill"/>
                                <Button DockPanel.Dock="Right" Content="Search" Style="{StaticResource BtnGhost}"
                                        Margin="8,0,0,0" Command="{Binding FindBillCommand}"
                                        AutomationProperties.AutomationId="FindBillButton"/>
                                <TextBox Text="{Binding BillSearch, UpdateSourceTrigger=PropertyChanged}" Margin="0"
                                         ToolTip="Bill number or customer name — searches every date"
                                         AutomationProperties.AutomationId="BillSearchBox">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding FindBillCommand}"/>
                                    </TextBox.InputBindings>
                                </TextBox>
                            </DockPanel>

                            <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0"
                                    Margin="0,6,0,0" Padding="8,10,8,2">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="Taxable: " Style="{StaticResource Muted}"/>
                                    <TextBlock Text="{Binding DayBookTaxableTotal, StringFormat='₹{0:N2}'}" FontWeight="SemiBold" Margin="0,0,16,0"/>
                                    <TextBlock Text="CGST: " Style="{StaticResource Muted}"/>
                                    <TextBlock Text="{Binding DayBookCgstTotal, StringFormat='₹{0:N2}'}" FontWeight="SemiBold" Margin="0,0,16,0"/>
                                    <TextBlock Text="SGST: " Style="{StaticResource Muted}"/>
                                    <TextBlock Text="{Binding DayBookSgstTotal, StringFormat='₹{0:N2}'}" FontWeight="SemiBold" Margin="0,0,16,0"/>
                                    <TextBlock Text="Net Sales: " Style="{StaticResource Muted}"/>
                                    <TextBlock Text="{Binding DayBookNetTotal, StringFormat='₹{0:N2}'}" FontWeight="SemiBold" Margin="0,0,16,0"/>
                                    <TextBlock Text="Cash: " Style="{StaticResource Muted}"/>
                                    <TextBlock Text="{Binding CashTotal, StringFormat='₹{0:N2}'}" FontWeight="SemiBold" Margin="0,0,16,0"/>
                                    <TextBlock Text="UPI: " Style="{StaticResource Muted}"/>
                                    <TextBlock Text="{Binding UpiTotal, StringFormat='₹{0:N2}'}" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                            <Grid>
                                <DataGrid ItemsSource="{Binding Sales}"
                                          SelectedItem="{Binding SelectedSale, Mode=TwoWay}"
                                          AutomationProperties.AutomationId="ReportsDayBookGrid">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="BILL NO" Binding="{Binding BillNo}"  Width="110" ElementStyle="{StaticResource GridName}"/>
                                        <DataGridTextColumn Header="TIME" Binding="{Binding BillDate, StringFormat=HH:mm}"  Width="70" ElementStyle="{StaticResource GridMuted}"/>
                                        <DataGridTextColumn Header="CUSTOMER" Binding="{Binding CustomerName}" Width="*"/>
                                        <DataGridTextColumn Header="DOCTOR" Binding="{Binding DoctorName}" Width="160"/>
                                        <DataGridTextColumn Header="ITEMS" Binding="{Binding Items.Count}"  Width="60" ElementStyle="{StaticResource GridNumber}" HeaderStyle="{StaticResource GridNumberHeader}"/>
                                        <DataGridTextColumn Header="TAXABLE" Binding="{Binding TaxableAmount, StringFormat=N2}"  Width="90" ElementStyle="{StaticResource GridNumber}" HeaderStyle="{StaticResource GridNumberHeader}"/>
                                        <DataGridTextColumn Header="CGST" Binding="{Binding CgstAmount, StringFormat=N2}"  Width="80" ElementStyle="{StaticResource GridNumber}" HeaderStyle="{StaticResource GridNumberHeader}"/>
                                        <DataGridTextColumn Header="SGST" Binding="{Binding SgstAmount, StringFormat=N2}"  Width="80" ElementStyle="{StaticResource GridNumber}" HeaderStyle="{StaticResource GridNumberHeader}"/>
                                        <DataGridTextColumn Header="NET" Binding="{Binding NetAmount, StringFormat=N2}"  Width="100" ElementStyle="{StaticResource GridAmount}" HeaderStyle="{StaticResource GridNumberHeader}"/>
                                        <DataGridTextColumn Header="MODE" Binding="{Binding PaymentMode}" Width="80"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Text="No records found for the selected date." Style="{StaticResource Muted}" FontSize="{StaticResource FontSubheading}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{Binding Sales.Count, Converter={StaticResource ZeroVis}}"/>
                            </Grid>
                        </DockPanel>
                    </TabItem>

                    <TabItem Header="GST summary">
                        <DockPanel Margin="0,10,0,0">
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="2,0,0,10">
                                <TextBlock Text="From" VerticalAlignment="Center" Style="{StaticResource Label}" Margin="0,0,6,10"/>
                                <DatePicker Width="130" SelectedDate="{Binding FromDate, Mode=TwoWay}" Margin="0,0,14,0"/>
                                <TextBlock Text="To" VerticalAlignment="Center" Style="{StaticResource Label}" Margin="0,0,6,10"/>
                                <DatePicker Width="130" SelectedDate="{Binding ToDate, Mode=TwoWay}"/>
                            </StackPanel>
                            <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0"
                                    Margin="0,6,0,0" Padding="8,10,8,2">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="Taxable: " Style="{StaticResource Muted}"/>
                                    <TextBlock Text="{Binding GstGrandTaxable, StringFormat='₹{0:N2}'}" FontWeight="SemiBold" Margin="0,0,16,0"/>
                                    <TextBlock Text="CGST: " Style="{StaticResource Muted}"/>
                                    <TextBlock Text="{Binding GstGrandCgst, StringFormat='₹{0:N2}'}" FontWeight="SemiBold" Margin="0,0,16,0"/>
                                    <TextBlock Text="SGST: " Style="{StaticResource Muted}"/>
                                    <TextBlock Text="{Binding GstGrandSgst, StringFormat='₹{0:N2}'}" FontWeight="SemiBold" Margin="0,0,16,0"/>
                                    <TextBlock Text="Invoice Value: " Style="{StaticResource Muted}"/>
                                    <TextBlock Text="{Binding GstGrandTotal, StringFormat='₹{0:N2}'}" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                            <Grid>
                                <DataGrid ItemsSource="{Binding GstSummary}" AutomationProperties.AutomationId="ReportsGstGrid">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="RATE" Binding="{Binding Rate, StringFormat='{}{0:N1}%'}"  Width="100" ElementStyle="{StaticResource GridNumber}" HeaderStyle="{StaticResource GridNumberHeader}"/>
                                        <DataGridTextColumn Header="TAXABLE VALUE" Binding="{Binding Taxable, StringFormat=N2}"  Width="160" ElementStyle="{StaticResource GridNumber}" HeaderStyle="{StaticResource GridNumberHeader}"/>
                                        <DataGridTextColumn Header="CGST" Binding="{Binding Cgst, StringFormat=N2}"  Width="140" ElementStyle="{StaticResource GridNumber}" HeaderStyle="{StaticResource GridNumberHeader}"/>
                                        <DataGridTextColumn Header="SGST" Binding="{Binding Sgst, StringFormat=N2}"  Width="140" ElementStyle="{StaticResource GridNumber}" HeaderStyle="{StaticResource GridNumberHeader}"/>
                                        <DataGridTextColumn Header="INVOICE VALUE" Binding="{Binding Total, StringFormat=N2}"  Width="*" ElementStyle="{StaticResource GridAmount}" HeaderStyle="{StaticResource GridNumberHeader}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Text="No records found for the selected date range." Style="{StaticResource Muted}" FontSize="{StaticResource FontSubheading}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{Binding GstSummary.Count, Converter={StaticResource ZeroVis}}"/>
                            </Grid>
                        </DockPanel>
                    </TabItem>

                    <TabItem Header="OPD register">
                        <DockPanel Margin="0,10,0,0">
                            <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0"
                                    Margin="0,6,0,0" Padding="8,10,8,2">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="Total OPD Visits: " Style="{StaticResource Muted}"/>
                                    <TextBlock Text="{Binding VisitCount}" FontWeight="SemiBold" Margin="0,0,16,0"/>
                                    <TextBlock Text="Total Consultation Fees: " Style="{StaticResource Muted}"/>
                                    <TextBlock Text="{Binding ConsultationTotal, StringFormat='₹{0:N2}'}" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                            <Grid>
                                <DataGrid ItemsSource="{Binding Visits}" AutomationProperties.AutomationId="ReportsOpdGrid">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="VISIT NO" Binding="{Binding VisitNo}" Width="100"/>
                                        <DataGridTextColumn Header="TIME" Binding="{Binding ScheduledOn, StringFormat=HH:mm}"  Width="70" ElementStyle="{StaticResource GridMuted}"/>
                                        <DataGridTextColumn Header="PATIENT" Binding="{Binding Patient.Name}"  Width="*" ElementStyle="{StaticResource GridName}"/>
                                        <DataGridTextColumn Header="AGE" Binding="{Binding Patient.Age}"  Width="60" ElementStyle="{StaticResource GridNumber}" HeaderStyle="{StaticResource GridNumberHeader}"/>
                                        <DataGridTextColumn Header="GENDER" Binding="{Binding Patient.Gender}" Width="90"/>
                                        <DataGridTextColumn Header="DOCTOR" Binding="{Binding Doctor.Name}" Width="160"/>
                                        <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="110"/>
                                        <DataGridTextColumn Header="FEE" Binding="{Binding Fee, StringFormat=N2}"  Width="90" ElementStyle="{StaticResource GridAmount}" HeaderStyle="{StaticResource GridNumberHeader}"/>
                                        <DataGridCheckBoxColumn Header="PAID" Binding="{Binding FeePaid}" Width="60"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Text="No records found for the selected date." Style="{StaticResource Muted}" FontSize="{StaticResource FontSubheading}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{Binding Visits.Count, Converter={StaticResource ZeroVis}}"/>
                            </Grid>
                        </DockPanel>
                    </TabItem>

                    <TabItem Header="Expiring soon">
                        <DockPanel Margin="0,10,0,0">
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="2,0,0,10">
                                <TextBlock Text="Expiring within" VerticalAlignment="Center" Style="{StaticResource Label}" Margin="0,0,8,10"/>
                                <ComboBox Width="90" ItemsSource="{Binding ExpiringDayOptions}"
                                          SelectedItem="{Binding ExpiringDays, Mode=TwoWay}"/>
                                <TextBlock Text="days" VerticalAlignment="Center" Style="{StaticResource Label}" Margin="8,0,0,10"/>
                            </StackPanel>
                            <Grid>
                                <DataGrid ItemsSource="{Binding Expiring}" AutomationProperties.AutomationId="ReportsExpiringGrid">
                                    <DataGrid.RowStyle>
                                        <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsExpired}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource Danger}"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.RowStyle>
                                    <DataGrid.Columns>
                                        <!-- Spelled out in words, not left to the row's red tint to
                                             say alone — the tint still reinforces it for sighted users. -->
                                        <DataGridTextColumn Header="STATUS" Binding="{Binding StatusLabel}" Width="170"/>
                                        <DataGridTextColumn Header="MEDICINE" Binding="{Binding Batch.Product.Name}"  Width="*" ElementStyle="{StaticResource GridName}"/>
                                        <DataGridTextColumn Header="BATCH" Binding="{Binding Batch.BatchNo}" Width="130"/>
                                        <DataGridTextColumn Header="EXPIRY" Binding="{Binding Batch.ExpiryDate, StringFormat=dd MMM yyyy}"  Width="120" ElementStyle="{StaticResource GridMuted}"/>
                                        <DataGridTextColumn Header="QTY LEFT" Binding="{Binding Batch.QtyOnHand}"  Width="90" ElementStyle="{StaticResource GridNumber}" HeaderStyle="{StaticResource GridNumberHeader}"/>
                                        <!-- Only sealed packs go back to the distributor; an opened
                                             strip cannot, so the two are counted separately. -->
                                        <DataGridTextColumn Header="RETURNABLE" Binding="{Binding Batch.Returnable}" Width="200"/>
                                        <DataGridTextColumn Header="MRP" Binding="{Binding Batch.Mrp, StringFormat=N2}"  Width="90" ElementStyle="{StaticResource GridNumber}" HeaderStyle="{StaticResource GridNumberHeader}"/>
                                        <DataGridTextColumn Header="SUPPLIER" Binding="{Binding Batch.SupplierName}" Width="170"/>
                                        <DataGridTextColumn Header="DAYS REMAINING" Binding="{Binding DaysRemaining}"  Width="130" ElementStyle="{StaticResource GridNumber}" HeaderStyle="{StaticResource GridNumberHeader}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Text="No medicines are expiring in the selected window." Style="{StaticResource Muted}" FontSize="{StaticResource FontSubheading}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{Binding Expiring.Count, Converter={StaticResource ZeroVis}}"/>
                            </Grid>
                        </DockPanel>
                    </TabItem>

                <TabItem Header="Part packs">
                    <DockPanel Margin="0,10,0,0">
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Muted}" Margin="2,0,0,8"
                                   TextWrapping="Wrap"
                                   Text="Opened strips with less than a full pack left. Nobody asks for exactly three, so these sit until they expire — sell them first, or write them off deliberately under Inventory → Correct the stock count."/>
                        <DataGrid ItemsSource="{Binding PartPacks}"
                                  AutomationProperties.AutomationId="PartPacksGrid">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="MEDICINE" Binding="{Binding Product.Name}"  Width="*" ElementStyle="{StaticResource GridName}"/>
                                <DataGridTextColumn Header="BATCH" Binding="{Binding BatchNo}" Width="130"/>
                                <DataGridTextColumn Header="EXPIRY" Binding="{Binding ExpiryDate, StringFormat=MMM yyyy}"  Width="110" ElementStyle="{StaticResource GridMuted}"/>
                                <DataGridTextColumn Header="LEFT" Binding="{Binding QtyOnHand}"  Width="80" ElementStyle="{StaticResource GridNumber}" HeaderStyle="{StaticResource GridNumberHeader}"/>
                                <DataGridTextColumn Header="OF A PACK OF" Binding="{Binding UnitsPerPack}"  Width="120" ElementStyle="{StaticResource GridNumber}" HeaderStyle="{StaticResource GridNumberHeader}"/>
                                <DataGridTextColumn Header="MRP" Binding="{Binding Mrp, StringFormat=N2}"  Width="90" ElementStyle="{StaticResource GridNumber}" HeaderStyle="{StaticResource GridNumberHeader}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>

                <TabItem Header="Stock to reconcile">
                    <DockPanel Margin="0,10,0,0">
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Muted}" Margin="2,0,0,8"
                                   TextWrapping="Wrap"
                                   Text="Put on the shelf at the counter to serve a patient, with no supplier bill behind it yet. Purchases will not tie out against sales until each of these is matched to the bill when it arrives. A batch number starting CTR- was allocated by the system, not printed on the pack."/>
                        <DataGrid ItemsSource="{Binding ToReconcile}"
                                  AutomationProperties.AutomationId="ReconcileGrid">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ADDED" Binding="{Binding ReceivedOn, StringFormat=dd MMM yyyy}"  Width="110" ElementStyle="{StaticResource GridMuted}"/>
                                <DataGridTextColumn Header="MEDICINE" Binding="{Binding Product.Name}"  Width="*" ElementStyle="{StaticResource GridName}"/>
                                <DataGridTextColumn Header="BATCH" Binding="{Binding BatchNo}"  Width="150" ElementStyle="{StaticResource GridMuted}"/>
                                <DataGridTextColumn Header="EXPIRY" Binding="{Binding ExpiryDate, StringFormat=MMM yyyy}"  Width="100" ElementStyle="{StaticResource GridMuted}"/>
                                <DataGridTextColumn Header="ON HAND" Binding="{Binding QtyOnHand}"  Width="90" ElementStyle="{StaticResource GridNumber}" HeaderStyle="{StaticResource GridNumberHeader}"/>
                                <DataGridTextColumn Header="MRP" Binding="{Binding Mrp, StringFormat=N2}"  Width="90" ElementStyle="{StaticResource GridNumber}" HeaderStyle="{StaticResource GridNumberHeader}"/>
                                <DataGridTextColumn Header="RATE PAID" Binding="{Binding PurchaseRate, StringFormat=N2}"  Width="100" ElementStyle="{StaticResource GridNumber}" HeaderStyle="{StaticResource GridNumberHeader}"/>
                                <DataGridTextColumn Header="SUPPLIER" Binding="{Binding SupplierName}"  Width="150" ElementStyle="{StaticResource GridMuted}"/>
                                <DataGridTextColumn Header="THEIR BILL" Binding="{Binding SupplierInvoiceNo}"  Width="120" ElementStyle="{StaticResource GridMuted}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>

                    <TabItem Header="Low stock">
                        <Grid Margin="0,10,0,0">
                            <DataGrid ItemsSource="{Binding LowStock}" AutomationProperties.AutomationId="ReportsLowStockGrid">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="MEDICINE" Binding="{Binding Name}"  Width="*" ElementStyle="{StaticResource GridName}"/>
                                    <DataGridTextColumn Header="PACK" Binding="{Binding PackSize}" Width="100"/>
                                    <DataGridTextColumn Header="RACK" Binding="{Binding RackLocation}" Width="80"/>
                                    <DataGridTextColumn Header="IN STOCK" Binding="{Binding StockOnHand}"  Width="90" ElementStyle="{StaticResource GridNumber}" HeaderStyle="{StaticResource GridNumberHeader}"/>
                                    <DataGridTextColumn Header="REORDER AT" Binding="{Binding ReorderLevel}"  Width="100" ElementStyle="{StaticResource GridNumber}" HeaderStyle="{StaticResource GridNumberHeader}"/>
                                    <DataGridTextColumn Header="SHORTAGE" Binding="{Binding Shortage}"  Width="100" ElementStyle="{StaticResource GridNumber}" HeaderStyle="{StaticResource GridNumberHeader}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Text="No medicines are below their reorder level." Style="{StaticResource Muted}" FontSize="{StaticResource FontSubheading}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding LowStock.Count, Converter={StaticResource ZeroVis}}"/>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Stock Register">
                        <DockPanel Margin="0,10,0,0">
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="2,0,0,10">
                                <TextBlock Text="Search" VerticalAlignment="Center" Style="{StaticResource Label}" Margin="0,0,6,10"/>
                                <TextBox Width="220" Text="{Binding StockSearch, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,0,20,10" AutomationProperties.AutomationId="ReportsStockSearch"/>
                                <CheckBox Content="Include Zero Stock" VerticalAlignment="Center" Margin="0,0,0,10"
                                          IsChecked="{Binding IncludeZeroStock, Mode=TwoWay}"
                                          AutomationProperties.AutomationId="ReportsStockIncludeZero"/>
                            </StackPanel>
                            <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0"
                                    Margin="0,6,0,0" Padding="8,10,8,2">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="Total Products: " Style="{StaticResource Muted}"/>
                                    <TextBlock Text="{Binding StockTotalProducts}" FontWeight="SemiBold" Margin="0,0,16,0"/>
                                    <TextBlock Text="Total Batches: " Style="{StaticResource Muted}"/>
                                    <TextBlock Text="{Binding StockTotalBatches}" FontWeight="SemiBold" Margin="0,0,16,0"/>
                                    <TextBlock Text="Total Units: " Style="{StaticResource Muted}"/>
                                    <TextBlock Text="{Binding StockTotalUnits}" FontWeight="SemiBold" Margin="0,0,16,0"/>
                                    <TextBlock Text="Cost Value: " Style="{StaticResource Muted}"/>
                                    <TextBlock Text="{Binding StockTotalCostValue, StringFormat='₹{0:N2}'}" FontWeight="SemiBold" Margin="0,0,16,0"/>
                                    <TextBlock Text="MRP Value: " Style="{StaticResource Muted}"/>
                                    <TextBlock Text="{Binding StockTotalMrpValue, StringFormat='₹{0:N2}'}" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                            <Grid>
                                <DataGrid ItemsSource="{Binding StockRegister}" AutomationProperties.AutomationId="ReportsStockGrid">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="MEDICINE" Binding="{Binding Product.Name}"  Width="*" ElementStyle="{StaticResource GridName}"/>
                                        <DataGridTextColumn Header="MANUFACTURER" Binding="{Binding Product.Manufacturer}" Width="130"/>
                                        <DataGridTextColumn Header="PACK" Binding="{Binding Product.PackSize}" Width="90"/>
                                        <DataGridTextColumn Header="BATCH" Binding="{Binding BatchNo}" Width="110"/>
                                        <DataGridTextColumn Header="EXPIRY" Binding="{Binding ExpiryDate, StringFormat=dd MMM yyyy}"  Width="110" ElementStyle="{StaticResource GridMuted}"/>
                                        <DataGridTextColumn Header="RACK" Binding="{Binding Product.RackLocation}" Width="80"/>
                                        <DataGridTextColumn Header="CURRENT STOCK" Binding="{Binding QtyOnHand}"  Width="110" ElementStyle="{StaticResource GridNumber}" HeaderStyle="{StaticResource GridNumberHeader}"/>
                                        <DataGridTextColumn Header="REORDER LEVEL" Binding="{Binding Product.ReorderLevel}"  Width="110" ElementStyle="{StaticResource GridNumber}" HeaderStyle="{StaticResource GridNumberHeader}"/>
                                        <DataGridTextColumn Header="SHORTAGE" Binding="{Binding Product.Shortage}"  Width="90" ElementStyle="{StaticResource GridNumber}" HeaderStyle="{StaticResource GridNumberHeader}"/>
                                        <DataGridTextColumn Header="PURCHASE RATE" Binding="{Binding PurchaseRate, StringFormat=N2}"  Width="110" ElementStyle="{StaticResource GridNumber}" HeaderStyle="{StaticResource GridNumberHeader}"/>
                                        <DataGridTextColumn Header="MRP" Binding="{Binding Mrp, StringFormat=N2}"  Width="90" ElementStyle="{StaticResource GridNumber}" HeaderStyle="{StaticResource GridNumberHeader}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Text="No stock found for the current filters." Style="{StaticResource Muted}" FontSize="{StaticResource FontSubheading}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{Binding StockRegister.Count, Converter={StaticResource ZeroVis}}"/>
                            </Grid>
                        </DockPanel>
                    </TabItem>

                    <TabItem Header="Schedule H1 register">
                        <DockPanel Margin="0,10,0,0">
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Muted}" Margin="2,0,0,8"
                                       Text="Statutory record of Schedule H1 sales. Retain for three years."/>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="2,0,0,10">
                                <TextBlock Text="From" VerticalAlignment="Center" Style="{StaticResource Label}" Margin="0,0,6,10"/>
                                <DatePicker Width="130" SelectedDate="{Binding FromDate, Mode=TwoWay}" Margin="0,0,14,0"/>
                                <TextBlock Text="To" VerticalAlignment="Center" Style="{StaticResource Label}" Margin="0,0,6,10"/>
                                <DatePicker Width="130" SelectedDate="{Binding ToDate, Mode=TwoWay}"/>
                            </StackPanel>
                            <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0"
                                    Margin="0,6,0,0" Padding="8,10,8,2">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="Entries: " Style="{StaticResource Muted}"/>
                                    <TextBlock Text="{Binding H1Register.Count}" FontWeight="SemiBold" Margin="0,0,16,0"/>
                                    <TextBlock Text="Total Quantity: " Style="{StaticResource Muted}"/>
                                    <TextBlock Text="{Binding H1TotalQuantity}" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                            <Grid>
                                <DataGrid ItemsSource="{Binding H1Register}" AutomationProperties.AutomationId="ReportsH1Grid">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="DATE" Binding="{Binding SoldOn, StringFormat='dd MMM yyyy HH:mm'}"  Width="160" ElementStyle="{StaticResource GridMuted}"/>
                                        <DataGridTextColumn Header="BILL NO" Binding="{Binding BillNo}" Width="110"/>
                                        <DataGridTextColumn Header="MEDICINE" Binding="{Binding ProductName}"  Width="*" ElementStyle="{StaticResource GridName}"/>
                                        <DataGridTextColumn Header="BATCH" Binding="{Binding BatchNo}"  Width="120" ElementStyle="{StaticResource GridMuted}"/>
                                        <DataGridTextColumn Header="QTY" Binding="{Binding Quantity}"  Width="70" ElementStyle="{StaticResource GridNumber}" HeaderStyle="{StaticResource GridNumberHeader}"/>
                                        <DataGridTextColumn Header="PATIENT" Binding="{Binding PatientName}" Width="180"/>
                                        <DataGridTextColumn Header="PRESCRIBER" Binding="{Binding DoctorName}" Width="180"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Text="No records found for the selected date range." Style="{StaticResource Muted}" FontSize="{StaticResource FontSubheading}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{Binding H1Register.Count, Converter={StaticResource ZeroVis}}"/>
                            </Grid>
                        </DockPanel>
                    </TabItem>

                </TabControl>
            </DockPanel>
        </Border>
    </DockPanel>
</UserControl>
