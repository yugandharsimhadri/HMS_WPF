<Window x:Class="Pharma.App.Views.ImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import a supplier bill" Height="720" Width="1120"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Bg}">

    <DockPanel Margin="18">

        <!-- Step 1: which supplier, which file -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="1.6*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Supplier profile" Style="{StaticResource Label}"/>
                    <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding Profile, Mode=TwoWay}"
                              AutomationProperties.AutomationId="ImportProfile">
                        <ComboBox.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding Name}"/></DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="File" Style="{StaticResource Label}"/>
                    <TextBox Text="{Binding FilePath, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.AutomationId="ImportFilePath"/>
                </StackPanel>

                <StackPanel Grid.Column="4">
                    <TextBlock Text="Supplier name" Style="{StaticResource Label}"/>
                    <TextBox Text="{Binding SupplierName, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="The file does not name the supplier — type who it came from"
                             AutomationProperties.AutomationId="ImportSupplier"/>
                </StackPanel>

                <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,10">
                    <Button Content="Browse…" Style="{StaticResource BtnGhost}" Margin="0,0,8,0"
                            Command="{Binding BrowseCommand}"
                            AutomationProperties.AutomationId="ImportBrowse"/>
                    <Button Content="Read file" Style="{StaticResource BtnGhost}"
                            Command="{Binding PreviewCommand}"
                            AutomationProperties.AutomationId="ImportPreview"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Step 3: commit -->
        <Border DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Import" Style="{StaticResource BtnPrimary}"
                        MinWidth="140" IsEnabled="{Binding CanImport}"
                        Command="{Binding ImportCommand}"
                        AutomationProperties.AutomationId="ImportCommit"/>
                <Button DockPanel.Dock="Right" Content="Close" Style="{StaticResource BtnGhost}"
                        Margin="0,0,8,0" Click="Close_Click"
                        AutomationProperties.AutomationId="ImportClose"/>
                <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" TextWrapping="Wrap"
                           VerticalAlignment="Center" Margin="0,0,12,0"
                           AutomationProperties.AutomationId="ImportStatus"/>
            </DockPanel>
        </Border>

        <!-- Step 2: what it will do -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="{Binding Summary}" Style="{StaticResource H2}"
                       TextWrapping="Wrap" Margin="2,0,0,10"
                       AutomationProperties.AutomationId="ImportSummary"/>

            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="10">
                <DataGrid ItemsSource="{Binding Lines}" IsReadOnly="False"
                          AutomationProperties.AutomationId="ImportLinesGrid">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="105" IsReadOnly="True"/>
                        <DataGridTextColumn Header="MEDICINE" Binding="{Binding ProductName}" Width="*" IsReadOnly="True"/>
                        <DataGridTextColumn Header="PACK" Binding="{Binding Source.PackSize}" Width="70" IsReadOnly="True"/>
                        <!-- Editable: the file rarely says how many are in a pack. -->
                        <DataGridTextColumn Header="PER PACK" Binding="{Binding UnitsPerPack}" Width="80"/>
                        <DataGridTextColumn Header="BATCH" Binding="{Binding Source.BatchNo}" Width="105" IsReadOnly="True"/>
                        <DataGridTextColumn Header="EXPIRY" Binding="{Binding Source.Expiry, StringFormat='MM/yyyy'}" Width="75" IsReadOnly="True"/>
                        <DataGridTextColumn Header="QTY" Binding="{Binding Source.Quantity}" Width="55" IsReadOnly="True"/>
                        <DataGridTextColumn Header="FREE" Binding="{Binding Source.FreeQuantity}" Width="55" IsReadOnly="True"/>
                        <DataGridTextColumn Header="UNITS" Binding="{Binding UnitsReceived}" Width="70" IsReadOnly="True"/>
                        <DataGridTextColumn Header="RATE" Binding="{Binding Source.Rate, StringFormat=N2}" Width="80" IsReadOnly="True"/>
                        <DataGridTextColumn Header="MRP" Binding="{Binding Source.Mrp, StringFormat=N2}" Width="80" IsReadOnly="True"/>
                        <DataGridTextColumn Header="GST" Binding="{Binding Source.GstPercent, StringFormat=N1}" Width="55" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="10" Margin="0,12,0,0" MaxHeight="150">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="What the file says" Style="{StaticResource H2}"/>
                    <DataGrid ItemsSource="{Binding Issues}"
                              AutomationProperties.AutomationId="ImportIssuesGrid">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="" Binding="{Binding Severity}" Width="80"/>
                            <DataGridTextColumn Header="LINE" Binding="{Binding Line}" Width="55"/>
                            <DataGridTextColumn Header="FIELD" Binding="{Binding Field}" Width="120"/>
                            <DataGridTextColumn Header="DETAIL" Binding="{Binding Message}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
