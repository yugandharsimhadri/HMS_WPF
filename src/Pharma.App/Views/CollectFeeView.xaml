<UserControl x:Class="Pharma.App.Views.CollectFeeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Pharma.App"
             Background="{DynamicResource Bg}"
             Width="460">

    <!-- Two fields and a tick box. Narrow on purpose: this is a stop, not a
         form, and it should read in one glance. -->
    <DockPanel Margin="18">

        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,14" Padding="16,12">
            <StackPanel>
                <TextBlock Text="{Binding Header}" Style="{StaticResource H2}" Margin="0"
                           TextTrimming="CharacterEllipsis"
                           AutomationProperties.AutomationId="CollectFeeHeader"/>
                <!-- Who, and by whom. The check before money changes hands. -->
                <TextBlock Text="{Binding Summary}" Style="{StaticResource Muted}" Margin="0,3,0,0"
                           TextWrapping="Wrap"
                           AutomationProperties.AutomationId="CollectFeeSummary"/>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource BtnGhost}" Margin="0,0,8,0"
                        MinWidth="100" IsCancel="True"
                        Command="{Binding CancelCommand}"
                        AutomationProperties.AutomationId="CollectFeeCancel"/>
                <Button Content="Take fee" Style="{StaticResource BtnPrimaryLarge}"
                        MinWidth="150" IsDefault="True"
                        Command="{Binding CollectCommand}"
                        AutomationProperties.AutomationId="CollectFeeTake"/>
            </StackPanel>
        </Border>

        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" Style="{StaticResource Muted}"
                   TextWrapping="Wrap" Margin="2,10,2,0"
                   AutomationProperties.AutomationId="CollectFeeStatus"/>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Fee (₹)" Style="{StaticResource Label}"/>
                        <TextBox Text="{Binding Fee, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="{StaticResource FontSubheading}"
                                 local:NumericInput.Mode="Money"
                                 ToolTip="What is actually being taken. Change it for a concession or a follow-up."
                                 AutomationProperties.AutomationId="CollectFeeAmount"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Paid by" Style="{StaticResource Label}"/>
                        <ComboBox ItemsSource="{Binding PaymentModes}" SelectedItem="{Binding Mode, Mode=TwoWay}"
                                  ToolTip="Cash, UPI or card — recorded against the receipt"
                                  AutomationProperties.AutomationId="CollectFeeMode"/>
                    </StackPanel>
                </Grid>

                <StackPanel Visibility="{Binding ShowTransactionNo, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="Transaction / reference no." Style="{StaticResource Label}"/>
                    <TextBox Text="{Binding TransactionNo, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Optional — for reconciling against the gateway or bank statement"
                             AutomationProperties.AutomationId="CollectFeeTransactionNo"/>
                </StackPanel>

                <!-- Only when the figure differs from what was quoted at booking. -->
                <Border Background="{DynamicResource WarnFill}" BorderBrush="{DynamicResource WarnStroke}"
                        BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,10,0,0"
                        Visibility="{Binding FeeNote, Converter={StaticResource TextToVisible}}">
                    <TextBlock Text="{Binding FeeNote}" TextWrapping="Wrap"
                               Foreground="{DynamicResource WarnInk}" FontSize="{StaticResource FontLabel}"
                               AutomationProperties.AutomationId="CollectFeeNote"/>
                </Border>

                <CheckBox Content="Print the receipt" IsChecked="{Binding PrintReceipt, Mode=TwoWay}"
                          Margin="0,12,0,0"
                          ToolTip="The receipt is numbered either way, and can be reprinted from the patient's record"
                          AutomationProperties.AutomationId="CollectFeePrint"/>
            </StackPanel>
        </Border>
    </DockPanel>
</UserControl>
