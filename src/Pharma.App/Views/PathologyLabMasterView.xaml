<UserControl x:Class="Pharma.App.Views.PathologyLabMasterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Pharma.App">

    <Grid Margin="20">
        <Border Style="{StaticResource Card}" Padding="8">
            <TabControl BorderThickness="0" Background="Transparent"
                        AutomationProperties.AutomationId="PathologyLabMasterTabs">

                <!-- ══════════════════════════════════════════════════════ -->
                <TabItem Header="Analyte Master">
                    <Grid Margin="16">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                                <Button DockPanel.Dock="Right" Content="+ New analyte" Style="{StaticResource BtnPrimary}"
                                        Margin="8,0,0,0" Command="{Binding NewAnalyteCommand}"
                                        AutomationProperties.AutomationId="LabNewAnalyte"/>
                                <Button DockPanel.Dock="Right" Content="Edit" Style="{StaticResource BtnGhost}"
                                        Margin="8,0,0,0" MinWidth="80"
                                        Command="{Binding EditAnalyteCommand}"
                                        IsEnabled="{Binding HasMasterAnalyte}"
                                        AutomationProperties.AutomationId="LabAnalyteEdit"/>
                                <TextBox Text="{Binding AnalyteMasterSearch, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0" VerticalAlignment="Center"
                                         AutomationProperties.AutomationId="LabAnalyteMasterSearch"/>
                            </DockPanel>

                            <DataGrid ItemsSource="{Binding AnalyteMasterRows}" IsReadOnly="True"
                                      SelectedItem="{Binding SelectedMasterAnalyte, Mode=TwoWay}"
                                      SelectionMode="Single" RowHeight="40"
                                      AutomationProperties.AutomationId="LabAnalyteMasterGrid">
                                <DataGrid.InputBindings>
                                    <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding EditAnalyteCommand}"/>
                                </DataGrid.InputBindings>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ANALYTE" Binding="{Binding Name}" Width="180*" MinWidth="110"
                                                        ElementStyle="{StaticResource GridName}"/>
                                    <DataGridTextColumn Header="CATEGORY" Binding="{Binding Category}" Width="Auto"
                                                        ElementStyle="{StaticResource GridMuted}"/>
                                    <DataGridTextColumn Header="UNITS" Binding="{Binding Units}" Width="Auto"
                                                        ElementStyle="{StaticResource GridMuted}"/>
                                    <DataGridTextColumn Header="TYPE" Binding="{Binding ResultType}" Width="Auto"
                                                        ElementStyle="{StaticResource GridMuted}"/>
                                    <DataGridCheckBoxColumn Header="ACTIVE" Binding="{Binding Active}" Width="Auto" IsReadOnly="True"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Grid>
                </TabItem>

                <!-- ══════════════════════════════════════════════════════ -->
                <TabItem Header="Report Master">
                    <Grid Margin="16">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                                <Button DockPanel.Dock="Right" Content="+ New report" Style="{StaticResource BtnPrimary}"
                                        Margin="8,0,0,0" Command="{Binding NewReportCommand}"
                                        AutomationProperties.AutomationId="LabNewReport"/>
                                <Button DockPanel.Dock="Right" Content="Edit" Style="{StaticResource BtnGhost}"
                                        Margin="8,0,0,0" MinWidth="80"
                                        Command="{Binding EditReportCommand}"
                                        IsEnabled="{Binding HasMasterReport}"
                                        AutomationProperties.AutomationId="LabReportEdit"/>
                            </DockPanel>

                            <DataGrid ItemsSource="{Binding ReportMasterRows}" IsReadOnly="True"
                                      SelectedItem="{Binding SelectedMasterReport, Mode=TwoWay}"
                                      SelectionMode="Single" RowHeight="40"
                                      AutomationProperties.AutomationId="LabReportMasterGrid">
                                <DataGrid.InputBindings>
                                    <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding EditReportCommand}"/>
                                </DataGrid.InputBindings>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="REPORT" Binding="{Binding Name}" Width="200*" MinWidth="120"
                                                        ElementStyle="{StaticResource GridName}"/>
                                    <DataGridTextColumn Header="CATEGORY" Binding="{Binding Category}" Width="Auto"
                                                        ElementStyle="{StaticResource GridMuted}"/>
                                    <DataGridTextColumn Header="PRICE" Binding="{Binding Price, StringFormat=N2}" Width="Auto"
                                                        ElementStyle="{StaticResource GridNumber}"
                                                        HeaderStyle="{StaticResource GridNumberHeader}"/>
                                    <DataGridCheckBoxColumn Header="ACTIVE" Binding="{Binding Active}" Width="Auto" IsReadOnly="True"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Grid>
                </TabItem>

                <!-- ══════════════════════════════════════════════════════ -->
                <TabItem Header="Package Master">
                    <Grid Margin="16">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                                <Button DockPanel.Dock="Right" Content="+ New package" Style="{StaticResource BtnPrimary}"
                                        Margin="8,0,0,0" Command="{Binding NewPackageCommand}"
                                        AutomationProperties.AutomationId="LabNewPackage"/>
                                <Button DockPanel.Dock="Right" Content="Edit" Style="{StaticResource BtnGhost}"
                                        Margin="8,0,0,0" MinWidth="80"
                                        Command="{Binding EditPackageCommand}"
                                        IsEnabled="{Binding HasMasterPackage}"
                                        AutomationProperties.AutomationId="LabPackageEdit"/>
                            </DockPanel>

                            <DataGrid ItemsSource="{Binding PackageMasterRows}" IsReadOnly="True"
                                      SelectedItem="{Binding SelectedMasterPackage, Mode=TwoWay}"
                                      SelectionMode="Single" RowHeight="40"
                                      AutomationProperties.AutomationId="LabPackageMasterGrid">
                                <DataGrid.InputBindings>
                                    <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding EditPackageCommand}"/>
                                </DataGrid.InputBindings>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="PACKAGE" Binding="{Binding Name}" Width="220*" MinWidth="120"
                                                        ElementStyle="{StaticResource GridName}"/>
                                    <DataGridTextColumn Header="PRICE" Binding="{Binding PackagePrice, StringFormat=N2}" Width="Auto"
                                                        ElementStyle="{StaticResource GridNumber}"
                                                        HeaderStyle="{StaticResource GridNumberHeader}"/>
                                    <DataGridCheckBoxColumn Header="ACTIVE" Binding="{Binding Active}" Width="Auto" IsReadOnly="True"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Grid>
                </TabItem>
            </TabControl>
        </Border>
    </Grid>
</UserControl>
