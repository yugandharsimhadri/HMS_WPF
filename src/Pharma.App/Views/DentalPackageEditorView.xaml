<UserControl x:Class="Pharma.App.Views.DentalPackageEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Pharma.App"
             Background="{DynamicResource Bg}"
             Width="480">

    <DockPanel Margin="18">

        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,14" Padding="16,12">
            <TextBlock Text="{Binding Header}" Style="{StaticResource H2}"
                       TextTrimming="CharacterEllipsis"
                       AutomationProperties.AutomationId="PackageEditorHeader"/>
        </Border>

        <Border DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <DockPanel>
                <Button DockPanel.Dock="Left" Content="Delete" Style="{StaticResource BtnDanger}"
                        MinWidth="100"
                        Command="{Binding DeleteCommand}"
                        Visibility="{Binding CanDelete, Converter={StaticResource BoolVis}}"
                        AutomationProperties.AutomationId="PackageEditorDelete"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Style="{StaticResource BtnGhost}" Margin="0,0,8,0"
                            MinWidth="100" IsCancel="True"
                            Command="{Binding CancelCommand}"
                            AutomationProperties.AutomationId="PackageEditorCancel"/>
                    <Button Content="Save package" Style="{StaticResource BtnPrimaryLarge}"
                            MinWidth="130" IsDefault="True"
                            Command="{Binding SaveCommand}"
                            AutomationProperties.AutomationId="PackageEditorSave"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" Style="{StaticResource Muted}"
                   TextWrapping="Wrap" Margin="2,10,2,0"
                   AutomationProperties.AutomationId="PackageEditorStatus"/>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <local:RequiredLabel Text="Package name"/>
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                         local:Field.IsMissing="{Binding NameMissing}"
                         AutomationProperties.AutomationId="PackageEditorName"/>

                <TextBlock Text="Description" Style="{StaticResource Label}"/>
                <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.AutomationId="PackageEditorDescription"/>

                <TextBlock Text="Package price" Style="{StaticResource Label}"/>
                <TextBox Text="{Binding PackagePrice, UpdateSourceTrigger=PropertyChanged}"
                         local:NumericInput.Mode="Money"
                         ToolTip="What the whole package bills at — not the sum of the items below"
                         AutomationProperties.AutomationId="PackageEditorPrice"/>

                <CheckBox Content="Active" IsChecked="{Binding Active, Mode=TwoWay}"
                          Margin="0,10,0,10"
                          AutomationProperties.AutomationId="PackageEditorActive"/>

                <TextBlock Text="Included procedures (reference only)" Style="{StaticResource H2}" Margin="0,4,0,6"/>

                <DockPanel Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Content="Add" Style="{StaticResource BtnPrimary}"
                            Margin="8,0,0,0"
                            Command="{Binding AddItemCommand}"
                            AutomationProperties.AutomationId="PackageEditorAddItem"/>
                    <ComboBox ItemsSource="{Binding Procedures}" SelectedItem="{Binding SelectedProcedureToAdd, Mode=TwoWay}"
                              DisplayMemberPath="Name"
                              AutomationProperties.AutomationId="PackageEditorProcedurePicker"/>
                </DockPanel>

                <ItemsControl ItemsSource="{Binding Items}"
                              AutomationProperties.AutomationId="PackageEditorItems">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,2,0,2">
                                <Button DockPanel.Dock="Right" Content="✕" BorderThickness="0"
                                        Background="Transparent" Foreground="{DynamicResource Danger}" Cursor="Hand"
                                        Command="{Binding DataContext.RemoveItemCommand,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>
                                <TextBlock Text="{Binding Quantity, StringFormat='× {0}'}" DockPanel.Dock="Right" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding ProcedureName}"/>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </DockPanel>
</UserControl>
