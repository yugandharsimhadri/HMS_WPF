<UserControl x:Class="Pharma.App.Views.PatientEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Pharma.App"
             Background="{DynamicResource Bg}"
             Width="640">

    <!-- Seven fields in two columns. Stated width because the overlay sizes to
         its content, and no field here earns more room than this. -->
    <DockPanel Margin="18">

        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,14" Padding="16,12">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding PatientNo}" Style="{StaticResource Muted}"
                           VerticalAlignment="Center" Margin="12,0,0,0"
                           AutomationProperties.AutomationId="PatientNo"/>
                <TextBlock Text="{Binding Header}" Style="{StaticResource H2}" Margin="0"
                           TextTrimming="CharacterEllipsis"
                           AutomationProperties.AutomationId="PatientEditorHeader"/>
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <DockPanel>
                <!-- Removing sits at the far left, away from Save, because the
                     two are next to each other in every other layout and only
                     one of them can be undone. -->
                <Button DockPanel.Dock="Left" Content="Remove" Style="{StaticResource BtnDanger}"
                        MinWidth="100"
                        Command="{Binding RemoveCommand}"
                        Visibility="{Binding CanRemove, Converter={StaticResource BoolVis}}"
                        AutomationProperties.AutomationId="PatientDelete"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Style="{StaticResource BtnGhost}" Margin="0,0,8,0"
                            MinWidth="100" IsCancel="True"
                            Command="{Binding CancelCommand}"
                            AutomationProperties.AutomationId="PatientEditorCancel"/>
                    <Button Content="Save patient" Style="{StaticResource BtnPrimaryLarge}"
                            MinWidth="150" IsDefault="True"
                            Command="{Binding SaveCommand}"
                            AutomationProperties.AutomationId="PatientSave"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" Style="{StaticResource Muted}"
                   TextWrapping="Wrap" Margin="2,10,2,0"
                   AutomationProperties.AutomationId="PatientEditorStatus"/>

        <Border Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <local:RequiredLabel Text="Name"/>
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                             local:Field.IsMissing="{Binding NameMissing}"
                             AutomationProperties.AutomationId="PatientName"/>

                    <TextBlock Text="Phone" Style="{StaticResource Label}"/>
                    <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="A family shares one number, and that is fine — the desk picks which child is here"
                             AutomationProperties.AutomationId="PatientPhone"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Age" Style="{StaticResource Label}"/>
                            <TextBox Text="{Binding Age, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.AutomationId="PatientAge"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Sex" Style="{StaticResource Label}"/>
                            <ComboBox ItemsSource="{Binding Genders}" SelectedItem="{Binding Gender, Mode=TwoWay}"
                                      AutomationProperties.AutomationId="PatientGender"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Address" Style="{StaticResource Label}"/>
                    <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" Height="76" TextWrapping="Wrap"
                             AutomationProperties.AutomationId="PatientAddress"/>

                    <!-- The one field on this form that can hurt somebody, so it
                         is not buried at the bottom of a column of six. -->
                    <TextBlock Text="Allergies" Style="{StaticResource Label}"/>
                    <TextBox Text="{Binding Allergies, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Shown against every prescription this child is written"
                             AutomationProperties.AutomationId="PatientAllergies"/>
                </StackPanel>
            </Grid>
        </Border>
    </DockPanel>
</UserControl>
