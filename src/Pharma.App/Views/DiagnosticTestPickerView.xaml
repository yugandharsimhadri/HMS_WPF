<UserControl x:Class="Pharma.App.Views.DiagnosticTestPickerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Pharma.App"
             Background="{DynamicResource Bg}"
             Width="680" MinHeight="520">

    <!-- Stated width, not just a minimum — a search box and a grid of tests
         is not a form that benefits from stretching to fill the window. -->
    <DockPanel Margin="18">

        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,14" Padding="16,12">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding AddedCount, StringFormat='{}{0} added'}"
                           Style="{StaticResource Muted}" VerticalAlignment="Center"
                           AutomationProperties.AutomationId="TestPickerAddedCount"/>
                <TextBlock Text="{Binding PatientName, StringFormat='Add tests for {0}'}" Style="{StaticResource H2}"
                           TextTrimming="CharacterEllipsis"
                           AutomationProperties.AutomationId="TestPickerHeader"/>
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="{Binding AddedTotal, StringFormat='Bill total so far: ₹{0:N2}'}"
                           Style="{StaticResource Muted}" VerticalAlignment="Center"
                           AutomationProperties.AutomationId="TestPickerTotal"/>
                <Button DockPanel.Dock="Right" Content="Done" Style="{StaticResource BtnPrimaryLarge}"
                        HorizontalAlignment="Right" MinWidth="120" IsDefault="True"
                        Command="{Binding DoneCommand}"
                        AutomationProperties.AutomationId="TestPickerDone"/>
            </DockPanel>
        </Border>

        <TextBox DockPanel.Dock="Top" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,0,0,10"
                 ToolTip="Search by test name or category"
                 AutomationProperties.AutomationId="TestPickerSearch"/>

        <Border Style="{StaticResource Card}">
            <DataGrid ItemsSource="{Binding Tests}" IsReadOnly="True" CanUserSortColumns="True" RowHeight="40"
                      AutomationProperties.AutomationId="TestPickerGrid">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="TEST" Binding="{Binding Name}" Width="220*" MinWidth="140"
                                        ElementStyle="{StaticResource GridName}"/>
                    <DataGridTextColumn Header="CATEGORY" Binding="{Binding Category}" Width="Auto"
                                        ElementStyle="{StaticResource GridMuted}"/>
                    <DataGridTextColumn Header="PRICE" Binding="{Binding Price, StringFormat=N2}" Width="Auto"
                                        ElementStyle="{StaticResource GridNumber}"
                                        HeaderStyle="{StaticResource GridNumberHeader}"/>
                    <DataGridTemplateColumn Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="+ Add" Style="{StaticResource BtnGhost}" Padding="10,3"
                                        Command="{Binding DataContext.AddTestCommand,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</UserControl>
