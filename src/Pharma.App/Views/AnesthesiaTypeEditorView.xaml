<UserControl x:Class="Pharma.App.Views.AnesthesiaTypeEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Pharma.App"
             Background="{DynamicResource Bg}"
             Width="380">

    <DockPanel Margin="18">

        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,14" Padding="16,12">
            <TextBlock Text="{Binding Header}" Style="{StaticResource H2}"
                       TextTrimming="CharacterEllipsis"
                       AutomationProperties.AutomationId="AnesthesiaEditorHeader"/>
        </Border>

        <Border DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource BtnGhost}" Margin="0,0,8,0"
                        MinWidth="100" IsCancel="True"
                        Command="{Binding CancelCommand}"
                        AutomationProperties.AutomationId="AnesthesiaEditorCancel"/>
                <Button Content="Save" Style="{StaticResource BtnPrimaryLarge}"
                        MinWidth="130" IsDefault="True"
                        Command="{Binding SaveCommand}"
                        AutomationProperties.AutomationId="AnesthesiaEditorSave"/>
            </StackPanel>
        </Border>

        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" Style="{StaticResource Muted}"
                   TextWrapping="Wrap" Margin="2,10,2,0"
                   AutomationProperties.AutomationId="AnesthesiaEditorStatus"/>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <local:RequiredLabel Text="Anesthesia type"/>
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                         local:Field.IsMissing="{Binding NameMissing}"
                         AutomationProperties.AutomationId="AnesthesiaEditorName"/>

                <TextBlock Text="Default cost" Style="{StaticResource Label}"/>
                <TextBox Text="{Binding DefaultCost, UpdateSourceTrigger=PropertyChanged}"
                         local:NumericInput.Mode="Money"
                         AutomationProperties.AutomationId="AnesthesiaEditorDefaultCost"/>

                <CheckBox Content="Active" IsChecked="{Binding Active, Mode=TwoWay}"
                          Margin="0,10,0,4"
                          AutomationProperties.AutomationId="AnesthesiaEditorActive"/>
            </StackPanel>
        </Border>
    </DockPanel>
</UserControl>
