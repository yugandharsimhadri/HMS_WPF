<UserControl x:Class="Pharma.App.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Pharma.App">

    <!-- Find a medicine, see what is on the shelf, then do one of two things to
         it. Both of those open over the shell, which is what lets these grids
         have the whole window instead of a 380px column. -->
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="260"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Card}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <!-- Docked right in reverse order: receiving is the job people
                         come to this screen for, so it sits at the end of the row
                         where the eye lands. -->
                    <Button DockPanel.Dock="Right" Content="Receive stock" Style="{StaticResource BtnPrimary}"
                            Margin="8,0,0,0" Command="{Binding ReceiveStockCommand}"
                            IsEnabled="{Binding HasProduct}"
                            ToolTip="Opens a delivery line for the highlighted medicine"
                            AutomationProperties.AutomationId="InventoryReceive"/>
                    <Button DockPanel.Dock="Right" Content="Correct count" Style="{StaticResource BtnGhost}"
                            Margin="8,0,0,0" MinWidth="120"
                            Command="{Binding CorrectStockCommand}"
                            IsEnabled="{Binding HasProduct}"
                            ToolTip="Puts a batch's count right when the shelf and the system disagree"
                            AutomationProperties.AutomationId="InventoryCorrect"/>
                    <Button DockPanel.Dock="Right" Content="Import supplier bill" Style="{StaticResource BtnGhost}"
                            Margin="8,0,0,0" Command="{Binding ImportBillCommand}"
                            ToolTip="Load a supplier's file instead of typing each medicine"
                            AutomationProperties.AutomationId="InventoryImport"/>
                    <Button DockPanel.Dock="Right" Content="Clear" Style="{StaticResource BtnGhost}"
                            Margin="8,0,0,0" MinWidth="80" Command="{Binding ClearCommand}"
                            ToolTip="Empties the search and puts the selection down"
                            AutomationProperties.AutomationId="InventoryClear"/>
                    <Button DockPanel.Dock="Right" Content="Search" Style="{StaticResource BtnGhost}"
                            Margin="8,0,0,0" Command="{Binding FindCommand}"
                            AutomationProperties.AutomationId="InventorySearchButton"/>
                    <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0" VerticalAlignment="Center"
                             ToolTip="Search by brand, drug, maker or rack"
                             AutomationProperties.AutomationId="InventorySearch">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding FindCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                </DockPanel>

                <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" Style="{StaticResource Muted}"
                           TextWrapping="Wrap" Margin="2,10,2,0"
                           AutomationProperties.AutomationId="InventoryStatus"/>

                <!-- Only visible when the pack size and units-per-pack disagree.
                     It stays on the page rather than inside either popup: it is a
                     fact about the medicine, and it is the reason not to receive
                     against it until it is fixed. -->
                <Border DockPanel.Dock="Bottom" Background="{DynamicResource WarnFill}"
                        BorderBrush="{DynamicResource WarnStroke}" BorderThickness="1"
                        CornerRadius="6" Padding="10,8" Margin="0,12,0,0"
                        Visibility="{Binding PackWarning, Converter={StaticResource TextToVisible}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚠" FontSize="{StaticResource FontSubheading}" FontWeight="Bold"
                                   Foreground="{DynamicResource WarnInk}" Margin="0,0,8,0" VerticalAlignment="Top"/>
                        <TextBlock Text="{Binding PackWarning}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource WarnInk}" FontSize="{StaticResource FontLabel}"
                                   AutomationProperties.AutomationId="InventoryPackWarning"/>
                    </StackPanel>
                </Border>

                <!-- What is on the shelf for the highlighted medicine, as chips.
                     Wrapping rather than a list, because there are usually two or
                     three and a whole panel for them earns nothing. -->
                <ItemsControl DockPanel.Dock="Bottom" ItemsSource="{Binding Batches}" Margin="0,12,0,0"
                              AutomationProperties.AutomationId="InventoryBatches">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource GridChip}" Margin="0,0,6,6">
                                <TextBlock Text="{Binding Display}" Style="{StaticResource GridChipText}"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <DataGrid ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct, Mode=TwoWay}" RowHeight="48"
                          AutomationProperties.AutomationId="InventoryProductsGrid">
                    <!-- Double-click is what people do to a row without being
                         told; the button is what tells them. -->
                    <DataGrid.InputBindings>
                        <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding ReceiveStockCommand}"/>
                    </DataGrid.InputBindings>
                    <DataGrid.Columns>
                        <!-- Brand with the drug name under it, as on the
                             Medicines screen: one medicine, said two ways. -->
                        <DataGridTemplateColumn Header="MEDICINE" Width="220*" MinWidth="105" ClipboardContentBinding="{Binding Name}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource GridName}"/>
                                        <TextBlock Text="{Binding GenericName}" FontSize="{StaticResource FontSmall}"
                                                   Foreground="{DynamicResource InkMuted}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding GenericName, Converter={StaticResource TextToVisible}}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="PACK" Binding="{Binding PackSize}" Width="Auto" ElementStyle="{StaticResource GridText}"/>
                        <DataGridTextColumn Header="MAKER" Binding="{Binding Manufacturer}" Width="Auto"
                                            ElementStyle="{StaticResource GridMuted}"/>
                        <DataGridTextColumn Header="PER PACK" Binding="{Binding UnitsPerPack}" Width="Auto"
                                            ElementStyle="{StaticResource GridNumber}"
                                            HeaderStyle="{StaticResource GridNumberHeader}"/>

                        <DataGridTemplateColumn Header="ON HAND" Width="Auto" ClipboardContentBinding="{Binding StockOnHand}"
                                                HeaderStyle="{StaticResource GridNumberHeader}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ContentControl Content="{Binding}" HorizontalAlignment="Right"
                                                    ContentTemplate="{StaticResource StockBadge}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="RACK" Width="Auto" ClipboardContentBinding="{Binding RackLocation}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource GridChip}"
                                            Visibility="{Binding RackLocation, Converter={StaticResource TextToVisible}}">
                                        <TextBlock Text="{Binding RackLocation}" Style="{StaticResource GridChipText}"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Recent corrections" Style="{StaticResource H2}"/>
                <DataGrid ItemsSource="{Binding Adjustments}"
                          AutomationProperties.AutomationId="AdjustmentsGrid">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="WHEN" Binding="{Binding AdjustedOn, StringFormat='dd MMM HH:mm'}" Width="Auto"
                                            ElementStyle="{StaticResource GridMuted}"/>
                        <DataGridTextColumn Header="MEDICINE" Binding="{Binding ProductName}" Width="220*" MinWidth="105"
                                            ElementStyle="{StaticResource GridName}"/>
                        <DataGridTextColumn Header="BATCH" Binding="{Binding BatchNo}" Width="Auto"
                                            ElementStyle="{StaticResource GridMuted}"/>
                        <DataGridTextColumn Header="WAS" Binding="{Binding QuantityBefore}" Width="Auto"
                                            ElementStyle="{StaticResource GridNumber}"
                                            HeaderStyle="{StaticResource GridNumberHeader}"/>
                        <DataGridTextColumn Header="NOW" Binding="{Binding QuantityAfter}" Width="Auto"
                                            ElementStyle="{StaticResource GridNumber}"
                                            HeaderStyle="{StaticResource GridNumberHeader}"/>
                        <DataGridTextColumn Header="CHANGE" Binding="{Binding Direction}" Width="Auto"
                                            ElementStyle="{StaticResource GridNumber}"
                                            HeaderStyle="{StaticResource GridNumberHeader}"/>
                        <DataGridTextColumn Header="REASON" Binding="{Binding Reason}" Width="Auto" ElementStyle="{StaticResource GridText}"/>
                        <DataGridTextColumn Header="NOTES" Binding="{Binding Notes}" Width="Auto"
                                            ElementStyle="{StaticResource GridMuted}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
