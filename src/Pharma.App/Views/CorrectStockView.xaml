<UserControl x:Class="Pharma.App.Views.CorrectStockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Pharma.App"
             Background="{DynamicResource Bg}"
             Width="470">

    <!-- Four fields, so one column. Narrower than receiving on purpose: this is
         a correction, not a delivery, and it should not look like one. -->
    <DockPanel Margin="18">

        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,14" Padding="16,12">
            <TextBlock Text="{Binding Header}" Style="{StaticResource H2}" Margin="0"
                       TextWrapping="Wrap"
                       AutomationProperties.AutomationId="CorrectStockHeader"/>
        </Border>

        <Border DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="{Binding Status}" Style="{StaticResource Muted}"
                           VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="180"
                           AutomationProperties.AutomationId="CorrectStockStatus"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Style="{StaticResource BtnGhost}" Margin="0,0,8,0"
                            MinWidth="90" IsCancel="True"
                            Command="{Binding CancelCommand}"
                            AutomationProperties.AutomationId="CorrectStockCancel"/>
                    <Button Content="Correct count" Style="{StaticResource BtnPrimaryLarge}"
                            MinWidth="140" IsDefault="True"
                            Command="{Binding SaveCommand}"
                            AutomationProperties.AutomationId="CorrectStock"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <!-- Batch first: a count is only ever wrong for one batch, and
                     correcting the wrong one writes off stock that is there. -->
                <TextBlock Text="Batch" Style="{StaticResource Label}"/>
                <ComboBox ItemsSource="{Binding Batches}" SelectedItem="{Binding SelectedBatch, Mode=TwoWay}"
                          AutomationProperties.AutomationId="CorrectBatch">
                    <ComboBox.ItemTemplate>
                        <DataTemplate><TextBlock Text="{Binding Display}"/></DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="True count" Style="{StaticResource Label}"/>
                        <TextBox Text="{Binding CorrectedQuantity, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="What is actually on the shelf, in units"
                                 local:NumericInput.Mode="Whole"
                                 AutomationProperties.AutomationId="CorrectQuantity"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Reason" Style="{StaticResource Label}"/>
                        <ComboBox ItemsSource="{Binding Reasons}" SelectedItem="{Binding Reason, Mode=TwoWay}"
                                  ToolTip="Why the shelf and the system disagree. It is kept."
                                  AutomationProperties.AutomationId="CorrectReason"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Notes" Style="{StaticResource Label}"/>
                <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Anything the next person would want to know"
                         AutomationProperties.AutomationId="CorrectNotes"/>
            </StackPanel>
        </Border>
    </DockPanel>
</UserControl>
