<UserControl x:Class="Pharma.App.Views.DiagnosticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Pharma.App">

    <Grid Margin="20">
        <Border Style="{StaticResource Card}" Padding="8">
            <TabControl BorderThickness="0" Background="Transparent"
                        AutomationProperties.AutomationId="DiagnosticsTabs">

                <!-- ══════════════════════════════════════════════════════ -->
                <TabItem Header="Billing">
                    <Grid Margin="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="320"/>
                        </Grid.ColumnDefinitions>

                        <DockPanel Grid.Column="0">

                            <!-- Step 1: the patient -->
                            <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Patient" Style="{StaticResource H2}"/>

                                    <DockPanel Margin="0,0,0,8">
                                        <Button DockPanel.Dock="Right" Content="+ New patient" Style="{StaticResource BtnGhost}"
                                                Margin="8,0,0,0"
                                                Visibility="{Binding HasSelectedPatient, Converter={StaticResource BoolVis}, ConverterParameter=invert}"
                                                Command="{Binding NewPatientCommand}"
                                                ToolTip="Register a walk-in who has no record yet, without leaving this screen"
                                                AutomationProperties.AutomationId="DiagnosticsNewPatient"/>
                                        <TextBox Text="{Binding PatientSearch, UpdateSourceTrigger=PropertyChanged}"
                                                 Margin="0"
                                                 ToolTip="Search by patient name or phone number"
                                                 AutomationProperties.AutomationId="DiagnosticsPatientSearch"/>
                                    </DockPanel>

                                    <ListBox ItemsSource="{Binding PatientMatches}"
                                             SelectedItem="{Binding SelectedPatient, Mode=TwoWay}"
                                             DisplayMemberPath="Display" MaxHeight="120"
                                             Visibility="{Binding HasSelectedPatient, Converter={StaticResource BoolVis}, ConverterParameter=invert}"
                                             AutomationProperties.AutomationId="DiagnosticsPatientMatches"/>

                                    <!-- Every field on the patient, not just the name — the
                                         desk is about to bill this person and wants to
                                         recognise them (and see any allergy) without a
                                         second trip to the Patients screen. -->
                                    <Border Visibility="{Binding HasSelectedPatient, Converter={StaticResource BoolVis}}"
                                            Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
                                            BorderThickness="1" CornerRadius="6" Padding="10">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="Change" Style="{StaticResource BtnGhost}"
                                                    VerticalAlignment="Top"
                                                    Command="{Binding ChangePatientCommand}"
                                                    AutomationProperties.AutomationId="DiagnosticsChangePatient"/>
                                            <StackPanel>
                                                <TextBlock Text="{Binding SelectedPatient.Name}" FontWeight="SemiBold"
                                                           FontSize="{StaticResource FontSubheading}"
                                                           AutomationProperties.AutomationId="DiagnosticsSelectedPatient"/>
                                                <TextBlock Style="{StaticResource Muted}"
                                                           AutomationProperties.AutomationId="DiagnosticsSelectedPatientDetails">
                                                    <Run Text="{Binding SelectedPatient.PatientNo, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding SelectedPatient.Age, Mode=OneWay}"/><Run Text=" yrs · "/><Run Text="{Binding SelectedPatient.Gender, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding SelectedPatient.Phone, Mode=OneWay}"/>
                                                </TextBlock>
                                                <TextBlock Text="{Binding SelectedPatient.Address}" Style="{StaticResource Muted}"
                                                           TextWrapping="Wrap" Margin="0,2,0,0"
                                                           Visibility="{Binding SelectedPatient.Address, Converter={StaticResource TextToVisible}}"
                                                           AutomationProperties.AutomationId="DiagnosticsSelectedPatientAddress"/>
                                                <TextBlock Text="{Binding SelectedPatient.Allergies, StringFormat='⚠ {0}'}"
                                                           Foreground="{DynamicResource Danger}" FontWeight="SemiBold"
                                                           TextWrapping="Wrap" Margin="0,2,0,0"
                                                           Visibility="{Binding SelectedPatient.Allergies, Converter={StaticResource TextToVisible}}"
                                                           AutomationProperties.AutomationId="DiagnosticsSelectedPatientAllergies"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Step 2: add tests — a popup over the shell listing
                                 every active test, searchable, that adds straight to
                                 the bill as each one is picked. Only enabled once
                                 there is a patient to bill. -->
                            <Button DockPanel.Dock="Top" Content="+ Add test" Style="{StaticResource BtnPrimaryLarge}"
                                    HorizontalAlignment="Left" Margin="0,0,0,14"
                                    IsEnabled="{Binding HasSelectedPatient}"
                                    Command="{Binding OpenTestPickerCommand}"
                                    AutomationProperties.AutomationId="DiagnosticsAddTest"/>

                            <!-- The bill -->
                            <Border Style="{StaticResource Card}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="Bill items" Style="{StaticResource H2}"/>

                                    <DataGrid ItemsSource="{Binding Lines}" IsReadOnly="False" CanUserSortColumns="False"
                                              IsEnabled="{Binding CanEdit}"
                                              AutomationProperties.AutomationId="DiagnosticsLinesGrid">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="TEST" Binding="{Binding TestName}" Width="260*" MinWidth="140"
                                                                IsReadOnly="True" ElementStyle="{StaticResource GridName}"/>
                                            <DataGridTextColumn Header="PRICE" Binding="{Binding Price, StringFormat=N2, UpdateSourceTrigger=LostFocus}"
                                                                Width="Auto" ElementStyle="{StaticResource GridNumber}"
                                                                HeaderStyle="{StaticResource GridNumberHeader}"/>
                                            <DataGridTextColumn Header="QTY" Binding="{Binding Quantity, UpdateSourceTrigger=LostFocus}"
                                                                Width="Auto" ElementStyle="{StaticResource GridNumber}"
                                                                HeaderStyle="{StaticResource GridNumberHeader}"/>
                                            <DataGridTextColumn Header="AMOUNT" Binding="{Binding Amount, StringFormat=N2}"
                                                                Width="Auto" IsReadOnly="True" ElementStyle="{StaticResource GridAmount}"
                                                                HeaderStyle="{StaticResource GridNumberHeader}"/>
                                            <DataGridTemplateColumn Width="Auto">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Content="✕" ToolTip="Remove line" BorderThickness="0"
                                                                Background="Transparent" Foreground="{DynamicResource Danger}" Cursor="Hand"
                                                                Command="{Binding DataContext.RemoveLineCommand,
                                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </Border>
                        </DockPanel>

                        <!-- Totals, payment, status -->
                        <Border Grid.Column="2" Style="{StaticResource Card}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel IsEnabled="{Binding CanEdit}">
                                    <TextBlock Text="Bill" Style="{StaticResource H2}"/>

                                    <!-- A second, parallel way in — same idea, same
                                         place, as the pharmacy counter's "today's OPD
                                         prescription" list, so tests the doctor
                                         requested during consultation do not need the
                                         patient searched for by hand. Shown only when
                                         there is something to load — a patient with
                                         requested-but-unbilled tests is the exception,
                                         not the everyday case the pharmacy list is. -->
                                    <StackPanel Visibility="{Binding HasRequestedTestVisits, Converter={StaticResource BoolVis}}">
                                        <TextBlock Text="Or pull today's OPD test requests" Style="{StaticResource Label}"/>
                                        <ComboBox ItemsSource="{Binding RequestedTestVisits}" SelectedItem="{Binding SelectedRequestVisit, Mode=TwoWay}"
                                                  Margin="0,0,0,6"
                                                  AutomationProperties.AutomationId="DiagnosticsRequestedVisit">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock>
                                                        <Run Text="Token"/><Run Text=" "/><Run Text="{Binding TokenNo}"/>
                                                        <Run Text=" · "/><Run Text="{Binding Patient.Name}"/>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <Button Content="Load diagnostic tests" Style="{StaticResource BtnGhost}"
                                                Command="{Binding LoadDiagnosticTestsCommand}" Margin="0,0,0,10"
                                                AutomationProperties.AutomationId="DiagnosticsLoadTests"/>
                                    </StackPanel>

                                    <TextBlock Text="{Binding BillNo, StringFormat='Bill No {0}'}"
                                               Style="{StaticResource Muted}"
                                               Visibility="{Binding BillNo, Converter={StaticResource TextToVisible}}"
                                               AutomationProperties.AutomationId="DiagnosticsBillNo"/>

                                    <TextBlock Text="Status" Style="{StaticResource Label}"/>

                                    <!-- A dropdown with nothing to pick from yet reads as
                                         broken, not as "not applicable" — so a bill that
                                         has never been saved shows the fixed starting
                                         status as plain text instead of a disabled control,
                                         and only becomes a real dropdown once there is a
                                         saved bill whose status can actually move on. -->
                                    <TextBlock Text="{Binding BillStatus}" FontWeight="SemiBold" Margin="0,0,0,6"
                                               Visibility="{Binding HasBillId, Converter={StaticResource BoolVis}, ConverterParameter=invert}"
                                               ToolTip="Every new bill starts as Ordered. Save it first to move it along."
                                               AutomationProperties.AutomationId="DiagnosticsStatusFixed"/>
                                    <ComboBox ItemsSource="{Binding BillStatuses}" SelectedItem="{Binding BillStatus, Mode=TwoWay}"
                                              Margin="0,0,0,6"
                                              Visibility="{Binding HasBillId, Converter={StaticResource BoolVis}}"
                                              AutomationProperties.AutomationId="DiagnosticsStatus"/>

                                    <TextBlock Text="Discount" Style="{StaticResource Label}"/>
                                    <TextBox Text="{Binding Discount, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,0,0,6"
                                             local:NumericInput.Mode="Money"
                                             AutomationProperties.AutomationId="DiagnosticsDiscount"/>

                                    <StackPanel Visibility="{Binding HasVisitId, Converter={StaticResource BoolVis}, ConverterParameter=invert}">
                                        <TextBlock Text="Referred by" Style="{StaticResource Label}"/>
                                        <TextBox Text="{Binding ReferredBy, UpdateSourceTrigger=PropertyChanged}"
                                                 Margin="0,0,0,6"
                                                 ToolTip="Optional — the outside doctor who sent this patient in for tests"
                                                 AutomationProperties.AutomationId="DiagnosticsReferredBy"/>
                                    </StackPanel>

                                    <TextBlock Text="Remarks" Style="{StaticResource Label}"/>
                                    <TextBox Text="{Binding Remarks, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,0,0,6"
                                             AutomationProperties.AutomationId="DiagnosticsRemarks"/>

                                    <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Margin="0,6,0,10"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Total" Style="{StaticResource Muted}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding TotalAmount, StringFormat=N2}"/>
                                    </Grid>

                                    <Border Background="#0F766E" CornerRadius="6" Padding="14,10" Margin="0,8,0,12">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Left" Text="FINAL AMOUNT" Foreground="{DynamicResource NavInkBright}"
                                                       FontSize="{StaticResource FontSmall}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding FinalAmount, StringFormat='₹{0:N2}'}" Foreground="White"
                                                       FontSize="{StaticResource FontHeading}" FontWeight="Bold" HorizontalAlignment="Right"
                                                       AutomationProperties.AutomationId="DiagnosticsFinalAmount"/>
                                        </DockPanel>
                                    </Border>

                                    <TextBlock Text="Payment" Style="{StaticResource Label}"/>
                                    <ComboBox ItemsSource="{Binding PaymentModes}" SelectedItem="{Binding PaymentMode, Mode=TwoWay}"
                                              Margin="0,0,0,6"
                                              AutomationProperties.AutomationId="DiagnosticsPaymentMode"/>

                                    <StackPanel Visibility="{Binding ShowTransactionNo, Converter={StaticResource BoolVis}}">
                                        <TextBlock Text="Transaction / reference no." Style="{StaticResource Label}"/>
                                        <TextBox Text="{Binding TransactionNo, UpdateSourceTrigger=PropertyChanged}"
                                                 Margin="0,0,0,6"
                                                 ToolTip="Optional — for reconciling against the gateway or bank statement"
                                                 AutomationProperties.AutomationId="DiagnosticsTransactionNo"/>
                                    </StackPanel>

                                    <Button Content="Save &amp; print bill" Style="{StaticResource BtnPrimaryLarge}"
                                            Margin="0,4,0,0"
                                            Command="{Binding SaveAndPrintCommand}"
                                            AutomationProperties.AutomationId="DiagnosticsSaveAndPrint"/>
                                    <Button Content="Save without printing" Style="{StaticResource BtnGhost}" Margin="0,6,0,0"
                                            Command="{Binding SaveCommand}"
                                            AutomationProperties.AutomationId="DiagnosticsSave"/>
                                    <Button Content="Clear" Style="{StaticResource BtnGhost}" Margin="0,6,0,0"
                                            Command="{Binding NewBillCommand}"
                                            AutomationProperties.AutomationId="DiagnosticsNewBill"/>

                                    <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}"
                                               TextWrapping="Wrap" Margin="0,8,0,0"
                                               AutomationProperties.AutomationId="DiagnosticsStatusMessage"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- ══════════════════════════════════════════════════════ -->
                <TabItem Header="Test Master">
                    <!-- The list, and nothing else beside it — adding or editing
                         opens over the shell, same as the Medicines screen. -->
                    <Grid Margin="16">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                                <Button DockPanel.Dock="Right" Content="+ New test" Style="{StaticResource BtnPrimary}"
                                        Margin="8,0,0,0" Command="{Binding NewTestCommand}"
                                        AutomationProperties.AutomationId="DiagnosticsNewTest"/>
                                <Button DockPanel.Dock="Right" Content="Edit" Style="{StaticResource BtnGhost}"
                                        Margin="8,0,0,0" MinWidth="80"
                                        Command="{Binding EditTestCommand}"
                                        IsEnabled="{Binding HasMasterTest}"
                                        ToolTip="Opens the highlighted test. Double-clicking a row does the same."
                                        AutomationProperties.AutomationId="DiagnosticsTestEdit"/>
                                <TextBox Text="{Binding TestMasterSearch, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0" VerticalAlignment="Center"
                                         ToolTip="Search by name or category"
                                         AutomationProperties.AutomationId="DiagnosticsTestMasterSearch"/>
                            </DockPanel>

                            <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="2,10,2,0"
                                       Text="Deactivate a test from its editor to hide it from billing without losing it from past bills."/>

                            <DataGrid ItemsSource="{Binding Tests}" IsReadOnly="True" CanUserSortColumns="True"
                                      SelectedItem="{Binding SelectedMasterTest, Mode=TwoWay}"
                                      SelectionMode="Single" RowHeight="40"
                                      AutomationProperties.AutomationId="DiagnosticsTestMasterGrid">
                                <DataGrid.InputBindings>
                                    <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding EditTestCommand}"/>
                                </DataGrid.InputBindings>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="TEST" Binding="{Binding Name}" Width="220*" MinWidth="120"
                                                        ElementStyle="{StaticResource GridName}"/>
                                    <DataGridTextColumn Header="CATEGORY" Binding="{Binding Category}" Width="Auto"
                                                        ElementStyle="{StaticResource GridMuted}"/>
                                    <DataGridTextColumn Header="PRICE" Binding="{Binding Price, StringFormat=N2}" Width="Auto"
                                                        ElementStyle="{StaticResource GridNumber}"
                                                        HeaderStyle="{StaticResource GridNumberHeader}"/>
                                    <DataGridCheckBoxColumn Header="ACTIVE" Binding="{Binding Active}" Width="Auto" IsReadOnly="True"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Grid>
                </TabItem>
            </TabControl>
        </Border>
    </Grid>
</UserControl>
