<UserControl x:Class="Pharma.App.Views.ProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="18"/>
            <ColumnDefinition Width="380"/>
        </Grid.ColumnDefinitions>

        <!-- Catalogue -->
        <Border Grid.Column="0" Style="{StaticResource Card}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <Button DockPanel.Dock="Right" Content="+ New medicine" Style="{StaticResource BtnPrimary}"
                            Margin="8,0,0,0" Command="{Binding NewProductCommand}"
                            AutomationProperties.AutomationId="ProductsNew"/>
                    <Button DockPanel.Dock="Right" Content="Import bill" Style="{StaticResource BtnGhost}"
                            Margin="8,0,0,0" Command="{Binding ImportBillCommand}"
                            ToolTip="Load a supplier's file instead of typing each medicine"
                            AutomationProperties.AutomationId="ProductsImport"/>
                    <Button DockPanel.Dock="Right" Content="Search" Style="{StaticResource BtnGhost}"
                            Margin="8,0,0,0" Command="{Binding FindCommand}"
                            AutomationProperties.AutomationId="ProductsSearchButton"/>
                    <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0" VerticalAlignment="Center"
                             AutomationProperties.AutomationId="ProductSearch">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding FindCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                </DockPanel>

                <DataGrid ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct, Mode=TwoWay}"
                          AutomationProperties.AutomationId="ProductsGrid">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="MEDICINE" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="PACK" Binding="{Binding PackSize}" Width="80"/>
                        <DataGridTextColumn Header="MAKER" Binding="{Binding Manufacturer}" Width="130"/>
                        <DataGridTextColumn Header="RACK" Binding="{Binding RackLocation}" Width="60"/>
                        <DataGridTextColumn Header="GST %" Binding="{Binding GstRate, StringFormat=N1}" Width="60"/>
                        <DataGridTextColumn Header="SCH" Binding="{Binding Schedule}" Width="60"/>
                        <DataGridTextColumn Header="PER PACK" Binding="{Binding UnitsPerPack}" Width="75"/>
                        <DataGridTextColumn Header="STOCK" Binding="{Binding StockOnHand}" Width="70"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <!-- Editor -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Medicine details" Style="{StaticResource H2}"/>

                        <TextBlock Text="Name" Style="{StaticResource Label}"/>
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.AutomationId="ProductName"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Manufacturer" Style="{StaticResource Label}"/>
                                <TextBox Text="{Binding Manufacturer, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Pack size" Style="{StaticResource Label}"/>
                                <TextBox Text="{Binding PackSize, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="As printed, e.g. 10 TAB"
                                         AutomationProperties.AutomationId="ProductPackSize"/>
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="HSN" Style="{StaticResource Label}"/>
                                <TextBox Text="{Binding HsnCode, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="GST %" Style="{StaticResource Label}"/>
                                <TextBox Text="{Binding GstRate, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.AutomationId="ProductGstRate"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Schedule" Style="{StaticResource Label}"/>
                                <ComboBox ItemsSource="{Binding Schedules}" SelectedItem="{Binding Schedule, Mode=TwoWay}"/>
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Rack" Style="{StaticResource Label}"/>
                                <TextBox Text="{Binding RackLocation, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Reorder level" Style="{StaticResource Label}"/>
                                <TextBox Text="{Binding ReorderLevel, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Width="90">
                                <TextBlock Text="Units per pack" Style="{StaticResource Label}"/>
                                <TextBox Text="{Binding UnitsPerPack, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="10 for a ten-tablet strip. 1 for a syrup bottle."
                                         AutomationProperties.AutomationId="ProductUnitsPerPack"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,8,0,10">
                                <CheckBox Content="Sell loose units" IsChecked="{Binding AllowLooseSale, Mode=TwoWay}"
                                          ToolTip="Allows part of a strip to be sold"
                                          AutomationProperties.AutomationId="ProductAllowLoose"/>
                            </StackPanel>
                        </Grid>

                        <CheckBox Content="Active" IsChecked="{Binding IsActive, Mode=TwoWay}" Margin="0,0,0,12"/>

                        <Button Content="Save medicine" Style="{StaticResource BtnPrimary}"
                                Command="{Binding SaveProductCommand}"
                                AutomationProperties.AutomationId="ProductSave"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Add stock to the selected medicine" Style="{StaticResource H2}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Batch no" Style="{StaticResource Label}"/>
                                <TextBox Text="{Binding BatchNo, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.AutomationId="StockBatchNo"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Expiry" Style="{StaticResource Label}"/>
                                <DatePicker SelectedDate="{Binding ExpiryDate, Mode=TwoWay}"
                                            AutomationProperties.AutomationId="StockExpiry"/>
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Qty" Style="{StaticResource Label}"/>
                                <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.AutomationId="StockQuantity"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Free" Style="{StaticResource Label}"/>
                                <TextBox Text="{Binding FreeQuantity, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Scheme quantity, e.g. the +1 in 10+1"
                                         AutomationProperties.AutomationId="StockFreeQuantity"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Rate" Style="{StaticResource Label}"/>
                                <TextBox Text="{Binding PurchaseRate, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.AutomationId="StockPurchaseRate"/>
                            </StackPanel>
                            <StackPanel Grid.Column="6">
                                <TextBlock Text="MRP" Style="{StaticResource Label}"/>
                                <TextBox Text="{Binding Mrp, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.AutomationId="StockMrp"/>
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Supplier" Style="{StaticResource Label}"/>
                                <TextBox Text="{Binding SupplierName, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Supplier bill no" Style="{StaticResource Label}"/>
                                <TextBox Text="{Binding SupplierInvoiceNo, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>

                        <Button Content="Add stock" Style="{StaticResource BtnPrimary}"
                                Command="{Binding AddStockCommand}"
                                AutomationProperties.AutomationId="StockAdd"/>

                        <TextBlock Text="Batches in stock" Style="{StaticResource Label}" Margin="0,14,0,4"/>
                        <ItemsControl ItemsSource="{Binding Batches}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Display}" Style="{StaticResource Muted}" Margin="0,0,0,3"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}"
                                   TextWrapping="Wrap" Margin="0,12,0,0"
                                   AutomationProperties.AutomationId="ProductsStatus"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
