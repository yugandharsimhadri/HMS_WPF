<UserControl x:Class="Pharma.App.Views.ProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Pharma.App">

    <!-- The catalogue, and nothing else. Adding or editing opens over the shell,
         which is what lets this grid have the whole window. -->
    <Grid Margin="20">

        <Border Style="{StaticResource Card}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <Button DockPanel.Dock="Right" Content="+ New medicine" Style="{StaticResource BtnPrimary}"
                            Margin="8,0,0,0" Command="{Binding NewProductCommand}"
                            AutomationProperties.AutomationId="ProductsNew"/>
                    <Button DockPanel.Dock="Right" Content="Edit" Style="{StaticResource BtnGhost}"
                            Margin="8,0,0,0" MinWidth="80"
                            Command="{Binding EditProductCommand}"
                            IsEnabled="{Binding HasProduct}"
                            ToolTip="Opens the highlighted medicine. Double-clicking a row does the same."
                            AutomationProperties.AutomationId="ProductsEdit"/>
                    <Button DockPanel.Dock="Right" Content="Search" Style="{StaticResource BtnGhost}"
                            Margin="8,0,0,0" Command="{Binding FindCommand}"
                            AutomationProperties.AutomationId="ProductsSearchButton"/>
                    <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0" VerticalAlignment="Center"
                             AutomationProperties.AutomationId="ProductSearch">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding FindCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                </DockPanel>

                <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" Style="{StaticResource Muted}"
                           TextWrapping="Wrap" Margin="2,10,2,0"
                           AutomationProperties.AutomationId="ProductsStatus"/>

                <DataGrid ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct, Mode=TwoWay}" RowHeight="48"
                          AutomationProperties.AutomationId="ProductsGrid">
                    <!-- Double-click is what people do to a row without being
                         told; the Edit button is what tells them. -->
                    <DataGrid.InputBindings>
                        <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding EditProductCommand}"/>
                    </DataGrid.InputBindings>
                    <DataGrid.Columns>
                        <!-- The drug name used to have a column of its own, 140px
                             wide, which cut "Dextromethorphan" off mid-word. It
                             belongs under the brand anyway: it is the same
                             medicine said another way, not a separate fact. -->
                        <DataGridTemplateColumn Header="MEDICINE" Width="220*" MinWidth="105" ClipboardContentBinding="{Binding Name}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource GridName}"/>
                                        <TextBlock Text="{Binding GenericName}" FontSize="{StaticResource FontSmall}"
                                                   Foreground="{DynamicResource InkMuted}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding GenericName, Converter={StaticResource TextToVisible}}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="PACK" Binding="{Binding PackSize}" Width="Auto" ElementStyle="{StaticResource GridText}"/>
                        <DataGridTextColumn Header="MAKER" Binding="{Binding Manufacturer}" Width="Auto"
                                            ElementStyle="{StaticResource GridMuted}"/>

                        <DataGridTemplateColumn Header="RACK" Width="Auto" ClipboardContentBinding="{Binding RackLocation}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource GridChip}"
                                            Visibility="{Binding RackLocation, Converter={StaticResource TextToVisible}}">
                                        <TextBlock Text="{Binding RackLocation}" Style="{StaticResource GridChipText}"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="GST" Binding="{Binding GstRate, StringFormat={}{0:N0}%}" Width="Auto"
                                            ElementStyle="{StaticResource GridNumber}"
                                            HeaderStyle="{StaticResource GridNumberHeader}"/>

                        <!-- A schedule is worth calling out; "None" truncated to
                             "Non" was worth nothing at all. -->
                        <DataGridTemplateColumn Header="SCH" Width="Auto" ClipboardContentBinding="{Binding Schedule}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ContentControl Content="{Binding Schedule}"
                                                    ContentTemplate="{StaticResource ScheduleBadge}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="PER PACK" Binding="{Binding UnitsPerPack}" Width="Auto"
                                            ElementStyle="{StaticResource GridNumber}"
                                            HeaderStyle="{StaticResource GridNumberHeader}"/>

                        <DataGridTemplateColumn Header="STOCK" Width="Auto" ClipboardContentBinding="{Binding StockOnHand}"
                                                HeaderStyle="{StaticResource GridNumberHeader}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ContentControl Content="{Binding}" HorizontalAlignment="Right"
                                                    ContentTemplate="{StaticResource StockBadge}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
