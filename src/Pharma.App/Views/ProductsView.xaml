<UserControl x:Class="Pharma.App.Views.ProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="18"/>
            <ColumnDefinition Width="380"/>
        </Grid.ColumnDefinitions>

        <!-- Catalogue -->
        <Border Grid.Column="0" Style="{StaticResource Card}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <Button DockPanel.Dock="Right" Content="+ New medicine" Style="{StaticResource BtnPrimary}"
                            Margin="8,0,0,0" Command="{Binding NewProductCommand}"
                            AutomationProperties.AutomationId="ProductsNew"/>
                    <Button DockPanel.Dock="Right" Content="Search" Style="{StaticResource BtnGhost}"
                            Margin="8,0,0,0" Command="{Binding FindCommand}"
                            AutomationProperties.AutomationId="ProductsSearchButton"/>
                    <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0" VerticalAlignment="Center"
                             AutomationProperties.AutomationId="ProductSearch">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding FindCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                </DockPanel>

                <DataGrid ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct, Mode=TwoWay}"
                          AutomationProperties.AutomationId="ProductsGrid">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="MEDICINE" Binding="{Binding Name}" Width="*" MinWidth="150"/>
                        <DataGridTextColumn Header="DRUG" Binding="{Binding GenericName}" Width="140"/>
                        <DataGridTextColumn Header="PACK" Binding="{Binding PackSize}" Width="80"/>
                        <DataGridTextColumn Header="MAKER" Binding="{Binding Manufacturer}" Width="130"/>
                        <DataGridTextColumn Header="RACK" Binding="{Binding RackLocation}" Width="60"/>
                        <DataGridTextColumn Header="GST %" Binding="{Binding GstRate, StringFormat=N1}" Width="60"/>
                        <DataGridTextColumn Header="SCH" Binding="{Binding Schedule}" Width="60"/>
                        <DataGridTextColumn Header="PER PACK" Binding="{Binding UnitsPerPack}" Width="75"/>
                        <DataGridTextColumn Header="STOCK" Binding="{Binding StockOnHand}" Width="70"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <!-- Editor -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Medicine details" Style="{StaticResource H2}"/>

                        <TextBlock Text="Brand name" Style="{StaticResource Label}"/>
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="What is printed on the pack, e.g. Calpol"
                                 AutomationProperties.AutomationId="ProductName"/>

                        <TextBlock Text="Drug / generic name" Style="{StaticResource Label}"/>
                        <TextBox Text="{Binding GenericName, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="The drug itself, e.g. Paracetamol 250mg. Searched too."
                                 AutomationProperties.AutomationId="ProductGenericName"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Manufacturer" Style="{StaticResource Label}"/>
                                <TextBox Text="{Binding Manufacturer, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Pack size" Style="{StaticResource Label}"/>
                                <TextBox Text="{Binding PackSize, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="As printed, e.g. 10 TAB"
                                         AutomationProperties.AutomationId="ProductPackSize"/>
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="HSN" Style="{StaticResource Label}"/>
                                <TextBox Text="{Binding HsnCode, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="GST %" Style="{StaticResource Label}"/>
                                <TextBox Text="{Binding GstRate, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.AutomationId="ProductGstRate"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Schedule" Style="{StaticResource Label}"/>
                                <ComboBox ItemsSource="{Binding Schedules}" SelectedItem="{Binding Schedule, Mode=TwoWay}"/>
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Rack" Style="{StaticResource Label}"/>
                                <TextBox Text="{Binding RackLocation, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Reorder level" Style="{StaticResource Label}"/>
                                <TextBox Text="{Binding ReorderLevel, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Width="90">
                                <TextBlock Text="Sold as" Style="{StaticResource Label}"/>
                                <ComboBox ItemsSource="{Binding DispensingUnitOptions}"
                                          SelectedItem="{Binding DispensingUnit, Mode=TwoWay}"
                                          ToolTip="What one unit is that a customer can buy"
                                          AutomationProperties.AutomationId="ProductDispensingUnit"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,8,0,10">
                                <CheckBox Content="Sell loose units" IsChecked="{Binding AllowLooseSale, Mode=TwoWay}"
                                          ToolTip="Allows part of a strip to be sold"
                                          AutomationProperties.AutomationId="ProductAllowLoose"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Units in one pack" Style="{StaticResource Label}"/>
                        <TextBox Text="{Binding UnitsPerPack, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="There is no standard: 1, 3, 5, 10, 15 all occur. 1 for a bottle."
                                 AutomationProperties.AutomationId="ProductUnitsPerPack"/>

                        <CheckBox Content="Active" IsChecked="{Binding IsActive, Mode=TwoWay}" Margin="0,0,0,12"/>

                        <!-- Reads back what a pack means, so 15-per-strip is obvious. -->
                        <TextBlock Text="{Binding PackHint}" Style="{StaticResource Muted}"
                                   TextWrapping="Wrap" Margin="0,0,0,10"
                                   AutomationProperties.AutomationId="ProductPackHint"/>

                        <Button Content="Save medicine" Style="{StaticResource BtnPrimary}"
                                Command="{Binding SaveProductCommand}"
                                AutomationProperties.AutomationId="ProductSave"/>

                        <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}"
                                   TextWrapping="Wrap" Margin="0,12,0,0"
                                   AutomationProperties.AutomationId="ProductsStatus"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
