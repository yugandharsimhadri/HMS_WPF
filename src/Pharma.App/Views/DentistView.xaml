<UserControl x:Class="Pharma.App.Views.DentistView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Pharma.App">

    <UserControl.Resources>
        <!-- The read-only case summary shown at the top of Treatment and
             Payments — title, status pill, and the same three money figures
             that used to sit in the middle of the old single-page layout,
             now carried across whichever of the two tabs is open. -->
        <DataTemplate x:Key="CaseStrip">
            <Border Style="{StaticResource Card}" Background="{DynamicResource AccentSoft}" Margin="0,0,0,14">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Switch case ↗" Style="{StaticResource BtnGhost}"
                            VerticalAlignment="Center" BorderThickness="0" Background="Transparent"
                            Command="{Binding GoToCasesTabCommand}"
                            AutomationProperties.AutomationId="DentistSwitchCase"/>

                    <StackPanel DockPanel.Dock="Right" Margin="0,0,20,0" MinWidth="90">
                        <TextBlock Text="{Binding SelectedCase.Balance, StringFormat='₹{0:N2}'}" FontWeight="Bold"
                                   Foreground="{DynamicResource Danger}" HorizontalAlignment="Right"
                                   AutomationProperties.AutomationId="DentistCaseBalance"/>
                        <TextBlock Text="BALANCE" Style="{StaticResource Muted}" FontSize="{StaticResource FontSmall}"
                                   HorizontalAlignment="Right"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Margin="0,0,20,0" MinWidth="90">
                        <TextBlock Text="{Binding SelectedCase.AmountPaid, StringFormat='₹{0:N2}'}" FontWeight="SemiBold"
                                   HorizontalAlignment="Right"
                                   AutomationProperties.AutomationId="DentistCaseAmountPaid"/>
                        <TextBlock Text="PAID" Style="{StaticResource Muted}" FontSize="{StaticResource FontSmall}"
                                   HorizontalAlignment="Right"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Margin="0,0,20,0" MinWidth="90">
                        <TextBlock Text="{Binding SelectedCase.TotalCost, StringFormat='₹{0:N2}'}" FontWeight="SemiBold"
                                   HorizontalAlignment="Right"
                                   AutomationProperties.AutomationId="DentistCaseTotalCost"/>
                        <TextBlock Text="TOTAL" Style="{StaticResource Muted}" FontSize="{StaticResource FontSmall}"
                                   HorizontalAlignment="Right"/>
                    </StackPanel>

                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding SelectedCase.ProcedureName}" FontWeight="SemiBold"
                                       FontSize="{StaticResource FontSubheading}"
                                       AutomationProperties.AutomationId="DentistSelectedCaseTitle"/>
                            <Border Background="{Binding SelectedCase.Status, Converter={StaticResource DentalCaseStatusFill}}"
                                    CornerRadius="10" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedCase.Status, Converter={StaticResource EnumLabel}}"
                                           Foreground="{Binding SelectedCase.Status, Converter={StaticResource DentalCaseStatusInk}}"
                                           FontSize="{StaticResource FontSmall}" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Muted}">
                            <Run Text="Tooth "/><Run Text="{Binding SelectedCase.ToothNumber, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding SelectedCase.StartedOn, StringFormat=dd MMM yyyy, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>

        <!-- No case picked yet — Treatment and Payments both need one, the
             same "pick something above first" placeholder every gated tab
             in this app already uses. -->
        <DataTemplate x:Key="NoCaseSelected">
            <Border Style="{StaticResource Card}" MaxWidth="420"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="No case selected" Style="{StaticResource H2}"/>
                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"
                               Text="Open a case or pick one from the list on the Cases tab first."/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════════════════════
             Patient — search, select, clear. Above the tabs, so it
             carries across whatever tab is open below rather than
             living inside any one of them. -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="16,12">
            <Grid>
                <StackPanel Visibility="{Binding HasSelectedPatient, Converter={StaticResource BoolVis}, ConverterParameter=invert}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="+ New patient" Style="{StaticResource BtnGhost}"
                                Margin="8,0,0,0"
                                Command="{Binding NewPatientCommand}"
                                AutomationProperties.AutomationId="DentistNewPatient"/>
                        <TextBlock DockPanel.Dock="Left" Text="Patient" Style="{StaticResource Label}"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox Text="{Binding PatientSearch, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0"
                                 ToolTip="Search by patient name or phone number"
                                 AutomationProperties.AutomationId="DentistPatientSearch"/>
                    </DockPanel>

                    <ListBox ItemsSource="{Binding PatientMatches}"
                             SelectedItem="{Binding SelectedPatient, Mode=TwoWay}"
                             DisplayMemberPath="Display" MaxHeight="160" Margin="0,8,0,0"
                             AutomationProperties.AutomationId="DentistPatientMatches"/>
                </StackPanel>

                <DockPanel Visibility="{Binding HasSelectedPatient, Converter={StaticResource BoolVis}}">
                    <Button DockPanel.Dock="Right" Content="Clear patient" Style="{StaticResource BtnGhost}"
                            VerticalAlignment="Center"
                            Command="{Binding ChangePatientCommand}"
                            AutomationProperties.AutomationId="DentistChangePatient"/>
                    <StackPanel>
                        <TextBlock Text="{Binding SelectedPatient.Name}" FontWeight="SemiBold"
                                   FontSize="{StaticResource FontSubheading}"
                                   AutomationProperties.AutomationId="DentistSelectedPatient"/>
                        <TextBlock Style="{StaticResource Muted}">
                            <Run Text="{Binding SelectedPatient.PatientNo, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding SelectedPatient.Phone, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                </DockPanel>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════ -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8">
            <TabControl BorderThickness="0" Background="Transparent"
                        SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}"
                        AutomationProperties.AutomationId="DentistTabs">

                <!-- ══════════════════════════════════════════════════════
                     Cases — open a case, see this patient's case list, and
                     the lifecycle actions (mark completed / cancel) for
                     whichever one is selected. Nothing about sittings,
                     replacements or payments renders here. -->
                <TabItem Header="Cases">
                    <Grid Margin="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Open a case" Style="{StaticResource H2}"/>

                                <TextBlock Text="Doctor" Style="{StaticResource Label}"/>
                                <ComboBox ItemsSource="{Binding Doctors}" SelectedItem="{Binding SelectedDoctor, Mode=TwoWay}"
                                          DisplayMemberPath="Name" Margin="0,0,0,6"
                                          AutomationProperties.AutomationId="DentistDoctor"/>

                                <TextBlock Text="Procedure" Style="{StaticResource Label}"/>
                                <ComboBox ItemsSource="{Binding Procedures}" SelectedItem="{Binding NewCaseProcedure, Mode=TwoWay}"
                                          DisplayMemberPath="Name" Margin="0,0,0,6"
                                          AutomationProperties.AutomationId="DentistNewCaseProcedure"/>

                                <TextBlock Text="or Package" Style="{StaticResource Label}"/>
                                <ComboBox ItemsSource="{Binding Packages}" SelectedItem="{Binding NewCasePackage, Mode=TwoWay}"
                                          DisplayMemberPath="Name" Margin="0,0,0,6"
                                          AutomationProperties.AutomationId="DentistNewCasePackage"/>

                                <TextBlock Text="Tooth" Style="{StaticResource Label}"/>
                                <TextBox Text="{Binding NewCaseTooth, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,0,0,6"
                                         AutomationProperties.AutomationId="DentistNewCaseTooth"/>

                                <Button Content="Open case" Style="{StaticResource BtnPrimaryLarge}"
                                        Command="{Binding OpenCaseCommand}"
                                        AutomationProperties.AutomationId="DentistOpenCase"/>
                            </StackPanel>
                        </Border>

                        <DockPanel Grid.Column="2">
                            <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,14">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="This patient's cases" Style="{StaticResource H2}"/>
                                    <DataGrid ItemsSource="{Binding Cases}" IsReadOnly="True" MaxHeight="220"
                                              SelectedItem="{Binding SelectedCase, Mode=TwoWay}"
                                              SelectionMode="Single" RowHeight="40"
                                              AutomationProperties.AutomationId="DentistCasesGrid">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="WHAT" Binding="{Binding ProcedureName}" Width="140*" MinWidth="90"
                                                                ElementStyle="{StaticResource GridName}"/>
                                            <DataGridTextColumn Header="TOOTH" Binding="{Binding ToothNumber}" Width="Auto"
                                                                ElementStyle="{StaticResource GridMuted}"/>
                                            <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="Auto"
                                                                ElementStyle="{StaticResource GridMuted}"/>
                                            <DataGridTextColumn Header="BALANCE" Binding="{Binding Balance, StringFormat=N2}" Width="Auto"
                                                                ElementStyle="{StaticResource GridNumber}"
                                                                HeaderStyle="{StaticResource GridNumberHeader}"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </Border>

                            <Border Style="{StaticResource Card}"
                                    Visibility="{Binding HasSelectedCase, Converter={StaticResource BoolVis}}">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,10">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <Button Content="Mark completed" Style="{StaticResource BtnGhost}" Margin="0,0,8,0"
                                                    Command="{Binding CompleteCaseCommand}"
                                                    AutomationProperties.AutomationId="DentistCompleteCase"/>
                                            <Button Content="Cancel case" Style="{StaticResource BtnGhost}"
                                                    Command="{Binding CancelCaseCommand}"
                                                    AutomationProperties.AutomationId="DentistCancelCase"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding SelectedCase.ProcedureName}" Style="{StaticResource H2}"
                                                   AutomationProperties.AutomationId="DentistSelectedCaseTitle"/>
                                    </DockPanel>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Total cost" Style="{StaticResource Muted}"/>
                                            <TextBlock Text="{Binding SelectedCase.TotalCost, StringFormat='₹{0:N2}'}" FontWeight="SemiBold"
                                                       AutomationProperties.AutomationId="DentistCaseTotalCost"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Paid" Style="{StaticResource Muted}"/>
                                            <TextBlock Text="{Binding SelectedCase.AmountPaid, StringFormat='₹{0:N2}'}" FontWeight="SemiBold"
                                                       AutomationProperties.AutomationId="DentistCaseAmountPaid"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Balance" Style="{StaticResource Muted}"/>
                                            <TextBlock Text="{Binding SelectedCase.Balance, StringFormat='₹{0:N2}'}" FontWeight="Bold"
                                                       Foreground="{DynamicResource Danger}"
                                                       AutomationProperties.AutomationId="DentistCaseBalance"/>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="Switch to the Treatment or Payments tab to add sittings, replacements, or a payment against this case."
                                               Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>

                            <TextBlock DockPanel.Dock="Bottom" Text="{Binding CasesStatus}" Style="{StaticResource Muted}"
                                       TextWrapping="Wrap" Margin="0,10,0,0"
                                       AutomationProperties.AutomationId="DentistCasesStatus"/>
                        </DockPanel>
                    </Grid>
                </TabItem>

                <!-- ══════════════════════════════════════════════════════
                     Treatment — sittings and replacements against whichever
                     case is selected on the Cases tab. -->
                <TabItem Header="Treatment">
                    <Grid Margin="16">
                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource NoCaseSelected}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Visibility="{Binding HasSelectedCase, Converter={StaticResource BoolVis}, ConverterParameter=invert}"/>

                        <DockPanel Visibility="{Binding HasSelectedCase, Converter={StaticResource BoolVis}}">
                            <ContentPresenter DockPanel.Dock="Top" Content="{Binding}" ContentTemplate="{StaticResource CaseStrip}"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Sittings -->
                                <Border Grid.Column="0" Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Add sitting" Style="{StaticResource H2}"/>
                                        <TextBlock Text="Work done" Style="{StaticResource Label}"/>
                                        <TextBox Text="{Binding SittingWorkDone, UpdateSourceTrigger=PropertyChanged}"
                                                 Margin="0,0,0,6"
                                                 AutomationProperties.AutomationId="DentistSittingWorkDone"/>
                                        <TextBlock Text="Anesthesia" Style="{StaticResource Label}"/>
                                        <ComboBox ItemsSource="{Binding AnesthesiaTypes}" SelectedItem="{Binding SelectedAnesthesiaType, Mode=TwoWay}"
                                                  DisplayMemberPath="Name" Margin="0,0,0,6"
                                                  AutomationProperties.AutomationId="DentistSittingAnesthesia"/>
                                        <TextBlock Text="Anesthesia cost" Style="{StaticResource Label}"/>
                                        <TextBox Text="{Binding SittingAnesthesiaCost, UpdateSourceTrigger=PropertyChanged}"
                                                 Margin="0,0,0,6"
                                                 local:NumericInput.Mode="Money"
                                                 AutomationProperties.AutomationId="DentistSittingAnesthesiaCost"/>
                                        <TextBlock Text="Next sitting on" Style="{StaticResource Label}"/>
                                        <TextBox Text="{Binding NextSittingOnText, UpdateSourceTrigger=PropertyChanged}"
                                                 Margin="0,0,0,6" ToolTip="yyyy-MM-dd"
                                                 AutomationProperties.AutomationId="DentistNextSittingOn"/>
                                        <Button Content="Add sitting" Style="{StaticResource BtnPrimary}"
                                                Command="{Binding AddSittingCommand}"
                                                AutomationProperties.AutomationId="DentistAddSitting"/>

                                        <DataGrid ItemsSource="{Binding SelectedCase.Sittings}" IsReadOnly="True" Margin="0,10,0,0" MaxHeight="220"
                                                  AutomationProperties.AutomationId="DentistSittingsGrid">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="#" Binding="{Binding SittingNumber}" Width="Auto"/>
                                                <DataGridTextColumn Header="DATE" Binding="{Binding SittingDate, StringFormat=dd MMM}" Width="Auto"
                                                                    ElementStyle="{StaticResource GridMuted}"/>
                                                <DataGridTextColumn Header="WORK" Binding="{Binding WorkDone}" Width="220*" MinWidth="80"
                                                                    ElementStyle="{StaticResource GridMuted}"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </StackPanel>
                                </Border>

                                <!-- Replacements -->
                                <Border Grid.Column="2" Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Add replacement" Style="{StaticResource H2}"/>
                                        <TextBlock Text="Item" Style="{StaticResource Label}"/>
                                        <ComboBox ItemsSource="{Binding Replacements}" SelectedItem="{Binding SelectedReplacementToAdd, Mode=TwoWay}"
                                                  DisplayMemberPath="Name" Margin="0,0,0,6"
                                                  AutomationProperties.AutomationId="DentistReplacementPicker"/>
                                        <TextBlock Text="Quantity" Style="{StaticResource Label}"/>
                                        <TextBox Text="{Binding ReplacementQuantity, UpdateSourceTrigger=PropertyChanged}"
                                                 Margin="0,0,0,6"
                                                 local:NumericInput.Mode="Whole"
                                                 AutomationProperties.AutomationId="DentistReplacementQuantity"/>
                                        <Button Content="Add replacement" Style="{StaticResource BtnPrimary}"
                                                Command="{Binding AddReplacementCommand}"
                                                AutomationProperties.AutomationId="DentistAddReplacement"/>

                                        <DataGrid ItemsSource="{Binding SelectedCase.Replacements}" IsReadOnly="True" Margin="0,10,0,0" MaxHeight="220"
                                                  AutomationProperties.AutomationId="DentistReplacementsGrid">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="ITEM" Binding="{Binding Name}" Width="160*" MinWidth="80"
                                                                    ElementStyle="{StaticResource GridName}"/>
                                                <DataGridTextColumn Header="QTY" Binding="{Binding Quantity}" Width="Auto"
                                                                    ElementStyle="{StaticResource GridNumber}"/>
                                                <DataGridTextColumn Header="AMOUNT" Binding="{Binding Amount, StringFormat=N2}" Width="Auto"
                                                                    ElementStyle="{StaticResource GridAmount}"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </DockPanel>

                        <TextBlock Text="{Binding CasesStatus}" Style="{StaticResource Muted}"
                                   TextWrapping="Wrap" VerticalAlignment="Bottom" Margin="0,0,0,-12"
                                   Visibility="{Binding HasSelectedCase, Converter={StaticResource BoolVis}}"/>
                    </Grid>
                </TabItem>

                <!-- ══════════════════════════════════════════════════════
                     Payments — record a payment and see payment history for
                     whichever case is selected on the Cases tab. -->
                <TabItem Header="Payments">
                    <Grid Margin="16">
                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource NoCaseSelected}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Visibility="{Binding HasSelectedCase, Converter={StaticResource BoolVis}, ConverterParameter=invert}"/>

                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      Visibility="{Binding HasSelectedCase, Converter={StaticResource BoolVis}}">
                            <StackPanel MaxWidth="640">
                                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource CaseStrip}"/>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Record payment" Style="{StaticResource H2}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Amount" Style="{StaticResource Label}"/>
                                                <TextBox Text="{Binding PaymentAmount, UpdateSourceTrigger=PropertyChanged}"
                                                         local:NumericInput.Mode="Money"
                                                         AutomationProperties.AutomationId="DentistPaymentAmount"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Payment mode" Style="{StaticResource Label}"/>
                                                <ComboBox ItemsSource="{Binding PaymentModes}" SelectedItem="{Binding PaymentMode, Mode=TwoWay}"
                                                          AutomationProperties.AutomationId="DentistPaymentMode"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="4" Visibility="{Binding ShowTransactionNo, Converter={StaticResource BoolVis}}">
                                                <TextBlock Text="Transaction no." Style="{StaticResource Label}"/>
                                                <TextBox Text="{Binding PaymentTransactionNo, UpdateSourceTrigger=PropertyChanged}"
                                                         AutomationProperties.AutomationId="DentistPaymentTransactionNo"/>
                                            </StackPanel>
                                        </Grid>
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <Button Content="Record &amp; print receipt" Style="{StaticResource BtnPrimaryLarge}" Margin="0,0,8,0"
                                                    Command="{Binding RecordPaymentAndPrintCommand}"
                                                    AutomationProperties.AutomationId="DentistRecordPaymentAndPrint"/>
                                            <Button Content="Record without printing" Style="{StaticResource BtnGhost}"
                                                    Command="{Binding RecordPaymentCommand}"
                                                    AutomationProperties.AutomationId="DentistRecordPayment"/>
                                        </StackPanel>

                                        <TextBlock Text="{Binding CasesStatus}" Style="{StaticResource Muted}"
                                                   TextWrapping="Wrap" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Top" Text="Payment history" Style="{StaticResource H2}"/>
                                        <DataGrid ItemsSource="{Binding SelectedCase.Payments}" IsReadOnly="True" MaxHeight="220"
                                                  AutomationProperties.AutomationId="DentistPaymentsGrid">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="RECEIPT" Binding="{Binding ReceiptNo}" Width="Auto"
                                                                    ElementStyle="{StaticResource GridName}"/>
                                                <DataGridTextColumn Header="DATE" Binding="{Binding PaidOn, StringFormat='dd MMM yyyy HH:mm'}" Width="Auto"
                                                                    ElementStyle="{StaticResource GridMuted}"/>
                                                <DataGridTextColumn Header="AMOUNT" Binding="{Binding Amount, StringFormat=N2}" Width="220*" MinWidth="80"
                                                                    ElementStyle="{StaticResource GridAmount}"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </TabItem>
            </TabControl>
        </Border>
    </Grid>
</UserControl>
