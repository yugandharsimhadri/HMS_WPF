<UserControl x:Class="Pharma.App.Views.OpdView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Pharma.App">

    <UserControl.Resources>
        <!-- A waiting patient. Token first and large: it is what the desk calls out. -->
        <DataTemplate x:Key="WaitingTile">
            <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                    CornerRadius="9" Padding="9" Margin="0,0,8,8" Width="178">
                <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                        <Border DockPanel.Dock="Left" Width="28" Height="28" CornerRadius="7"
                                Background="{DynamicResource AccentSoft}" Margin="0,0,8,0">
                            <TextBlock Text="{Binding TokenNo}" FontSize="{StaticResource FontBody}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Accent}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Patient.Name}" FontSize="{StaticResource FontBody}" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding PatientLine}" FontSize="{StaticResource FontSmall}"
                                       Foreground="{DynamicResource InkMuted}"/>
                        </StackPanel>
                    </DockPanel>

                    <TextBlock Text="{Binding Complaint}" FontSize="{StaticResource FontSmall}" Foreground="{DynamicResource InkMuted}"
                               TextWrapping="Wrap" MaxHeight="28" Margin="0,0,0,6"/>

                    <DockPanel Margin="0,0,0,7">
                        <Border DockPanel.Dock="Left" CornerRadius="4" Padding="6,1" Margin="0,0,5,0"
                                Background="{Binding FeePaid, Converter={StaticResource FeeBrush}}">
                            <TextBlock Text="{Binding FeeBadge}" FontSize="{StaticResource FontSmall}"
                                       Foreground="{Binding FeePaid, Converter={StaticResource FeeInk}}"/>
                        </Border>
                        <TextBlock Text="{Binding WaitedFor}" FontSize="{StaticResource FontSmall}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource InkMuted}"/>
                    </DockPanel>

                    <Button Content="Consult" Style="{StaticResource BtnPrimary}" Padding="6,6" FontSize="{StaticResource FontLabel}"
                            Command="{Binding DataContext.ConsultCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            AutomationProperties.AutomationId="TileConsult"
                            AutomationProperties.Name="{Binding Patient.Name}"/>

                    <UniformGrid Columns="3" Margin="0,5,0,0">
                        <Button Content="Fee" Style="{StaticResource BtnGhost}" Margin="0,0,4,0" Padding="2,4"
                                FontSize="{StaticResource FontSmall}" MinHeight="26"
                                Command="{Binding DataContext.CollectFeeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                AutomationProperties.AutomationId="TileFee"
                                AutomationProperties.Name="{Binding Patient.Name}"/>
                        <Button Content="Done" Style="{StaticResource BtnGhost}" Margin="0,0,4,0" Padding="2,4"
                                FontSize="{StaticResource FontSmall}" MinHeight="26" ToolTip="Move to completed"
                                Command="{Binding DataContext.CompleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                AutomationProperties.AutomationId="TileDone"
                                AutomationProperties.Name="{Binding Patient.Name}"/>
                        <Button Content="Cancel" Style="{StaticResource BtnDanger}" Padding="2,4"
                                FontSize="{StaticResource FontSmall}" MinHeight="26"
                                Command="{Binding DataContext.CancelVisitCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                AutomationProperties.AutomationId="TileCancel"
                                AutomationProperties.Name="{Binding Patient.Name}"/>
                    </UniformGrid>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Completed: same shape, quieter, and the actions are about paperwork. -->
        <DataTemplate x:Key="CompletedTile">
            <Border Background="{DynamicResource SurfaceMuted}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                    CornerRadius="9" Padding="9" Margin="0,0,8,8" Width="178">
                <StackPanel>
                    <DockPanel Margin="0,0,0,5">
                        <Border DockPanel.Dock="Left" Width="26" Height="26" CornerRadius="7"
                                Background="{DynamicResource BadgeFill}" Margin="0,0,8,0">
                            <TextBlock Text="{Binding TokenNo}" FontSize="{StaticResource FontLabel}"
                                       Foreground="{DynamicResource InkMuted}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Patient.Name}" FontSize="{StaticResource FontLabel}" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding PatientLine}" FontSize="{StaticResource FontSmall}"
                                       Foreground="{DynamicResource InkMuted}"/>
                        </StackPanel>
                    </DockPanel>

                    <TextBlock Text="{Binding Diagnosis}" FontSize="{StaticResource FontSmall}" Foreground="{DynamicResource InkMuted}"
                               TextWrapping="Wrap" MaxHeight="26" Margin="0,0,0,6"/>

                    <UniformGrid Columns="3">
                        <Button Content="Rx" Style="{StaticResource BtnGhost}" Margin="0,0,4,0" Padding="2,4"
                                FontSize="{StaticResource FontSmall}" MinHeight="26" ToolTip="Print prescription"
                                Command="{Binding DataContext.PrintPrescriptionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                AutomationProperties.AutomationId="TileRx"
                                AutomationProperties.Name="{Binding Patient.Name}"/>
                        <Button Content="Receipt" Style="{StaticResource BtnGhost}" Margin="0,0,4,0" Padding="2,4" FontSize="{StaticResource FontSmall}" MinHeight="26"
                                Command="{Binding DataContext.PrintReceiptCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                AutomationProperties.AutomationId="TileReceipt"
                                AutomationProperties.Name="{Binding Patient.Name}"/>
                        <Button Content="Reopen" Style="{StaticResource BtnGhost}" Padding="2,4" FontSize="{StaticResource FontSmall}" MinHeight="26"
                                ToolTip="Move back to waiting"
                                Command="{Binding DataContext.ReopenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                AutomationProperties.AutomationId="TileReopen"
                                AutomationProperties.Name="{Binding Patient.Name}"/>
                    </UniformGrid>
                </StackPanel>
            </Border>
        </DataTemplate>
        <!-- Same information and the same actions, laid out to fit more people. -->
        <DataTemplate x:Key="WaitingRow">
            <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1"
                    Padding="10,8">
                <DockPanel>
                    <Border DockPanel.Dock="Left" Width="30" Height="30" CornerRadius="6"
                            Background="{DynamicResource AccentSoft}" Margin="0,0,10,0">
                        <TextBlock Text="{Binding TokenNo}" FontSize="{StaticResource FontBody}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Accent}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Consult" Style="{StaticResource BtnPrimary}" Padding="10,5" Margin="0,0,4,0"
                                Command="{Binding DataContext.ConsultCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                AutomationProperties.AutomationId="TileConsult"
                                AutomationProperties.Name="{Binding Patient.Name}"/>
                        <Button Content="Fee" Style="{StaticResource BtnGhost}" Padding="9,5" Margin="0,0,4,0"
                                Command="{Binding DataContext.CollectFeeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                AutomationProperties.AutomationId="TileFee"
                                AutomationProperties.Name="{Binding Patient.Name}"/>
                        <Button Content="Done" Style="{StaticResource BtnGhost}" Padding="9,5" Margin="0,0,4,0"
                                Command="{Binding DataContext.CompleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                AutomationProperties.AutomationId="TileDone"
                                AutomationProperties.Name="{Binding Patient.Name}"/>
                        <Button Content="Cancel" Style="{StaticResource BtnDanger}" Padding="9,5"
                                Command="{Binding DataContext.CancelVisitCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                AutomationProperties.AutomationId="TileCancel"
                                AutomationProperties.Name="{Binding Patient.Name}"/>
                    </StackPanel>

                    <Border DockPanel.Dock="Right" CornerRadius="4" Padding="7,2" Margin="8,0,10,0"
                            VerticalAlignment="Center"
                            Background="{Binding FeePaid, Converter={StaticResource FeeBrush}}">
                        <TextBlock Text="{Binding FeeBadge}" FontSize="{StaticResource FontSmall}"
                                   Foreground="{Binding FeePaid, Converter={StaticResource FeeInk}}"/>
                    </Border>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Patient.Name}" FontSize="{StaticResource FontBody}" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding RowSummary}" Style="{StaticResource Muted}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="CompletedRow">
            <Border Background="{DynamicResource SurfaceMuted}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1"
                    Padding="10,8">
                <DockPanel>
                    <Border DockPanel.Dock="Left" Width="28" Height="28" CornerRadius="6"
                            Background="{DynamicResource BadgeFill}" Margin="0,0,10,0">
                        <TextBlock Text="{Binding TokenNo}" FontSize="{StaticResource FontLabel}"
                                   Foreground="{DynamicResource InkMuted}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Rx" Style="{StaticResource BtnGhost}" Padding="9,5" Margin="0,0,4,0"
                                Command="{Binding DataContext.PrintPrescriptionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                AutomationProperties.AutomationId="TileRx"
                                AutomationProperties.Name="{Binding Patient.Name}"/>
                        <Button Content="Receipt" Style="{StaticResource BtnGhost}" Padding="9,5" Margin="0,0,4,0"
                                Command="{Binding DataContext.PrintReceiptCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                AutomationProperties.AutomationId="TileReceipt"
                                AutomationProperties.Name="{Binding Patient.Name}"/>
                        <Button Content="Reopen" Style="{StaticResource BtnGhost}" Padding="9,5"
                                Command="{Binding DataContext.ReopenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                AutomationProperties.AutomationId="TileReopen"
                                AutomationProperties.Name="{Binding Patient.Name}"/>
                    </StackPanel>

                    <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock Text="{Binding Patient.Name}" FontSize="{StaticResource FontBody}" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Diagnosis}" Style="{StaticResource Muted}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>

        <!-- Layout is a user setting, so both columns switch together. -->
        <Style x:Key="WaitingList" TargetType="ItemsControl">
            <Setter Property="ItemTemplate" Value="{StaticResource WaitingRow}"/>
            <Setter Property="ItemsPanel">
                <Setter.Value><ItemsPanelTemplate><StackPanel/></ItemsPanelTemplate></Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding UseTiles}" Value="True">
                    <Setter Property="ItemTemplate" Value="{StaticResource WaitingTile}"/>
                    <Setter Property="ItemsPanel">
                        <Setter.Value><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CompletedList" TargetType="ItemsControl">
            <Setter Property="ItemTemplate" Value="{StaticResource CompletedRow}"/>
            <Setter Property="ItemsPanel">
                <Setter.Value><ItemsPanelTemplate><StackPanel/></ItemsPanelTemplate></Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding UseTiles}" Value="True">
                    <Setter Property="ItemTemplate" Value="{StaticResource CompletedTile}"/>
                    <Setter Property="ItemsPanel">
                        <Setter.Value><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- Doctor tabs. One per doctor plus All, so the doctor never repeats on a tile. -->
        <Border Grid.Row="0" BorderBrush="{DynamicResource Border}"
                BorderThickness="0,0,0,1" Margin="0,0,0,14">
            <DockPanel>
                <DatePicker DockPanel.Dock="Right" Width="140" Margin="8,0,0,6"
                            SelectedDate="{Binding Date, Mode=TwoWay}"
                            AutomationProperties.AutomationId="OpdDate"/>
                <Button DockPanel.Dock="Right" Content="+ New visit" Style="{StaticResource BtnPrimary}"
                        Margin="8,0,0,6" Command="{Binding NewVisitCommand}"
                        AutomationProperties.AutomationId="OpdNewVisit"/>
                <!-- Which sitting. Doctors work mornings and evenings with the
                     afternoon off, so this is the filter the desk actually
                     wants. The hours are set under Settings.

                     It replaced a payment-mode picker, which sat here deciding
                     how money was taken three clicks away — that now lives in
                     the fee form, where the money is. -->
                <ComboBox DockPanel.Dock="Right" Width="120" Margin="8,0,0,6" VerticalAlignment="Center"
                          ItemsSource="{Binding Sessions}" SelectedItem="{Binding Session, Mode=TwoWay}"
                          ToolTip="Morning or evening sitting. The hours are set under Settings."
                          AutomationProperties.AutomationId="OpdSession">
                    <!-- "FullDay" is what the enum is called; "Full day" is what
                         it has to say beside Morning and Evening. -->
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource EnumLabel}}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <StackPanel Orientation="Horizontal">
                    <RadioButton Content="All doctors" GroupName="DoctorTab" IsChecked="True"
                                 Style="{StaticResource DoctorTab}"
                                 Command="{Binding ShowAllDoctorsCommand}"
                                 AutomationProperties.AutomationId="OpdTabAll"/>
                    <ItemsControl ItemsSource="{Binding Doctors}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton Content="{Binding Name}" GroupName="DoctorTab"
                                             Style="{StaticResource DoctorTab}"
                                             AutomationProperties.Name="{Binding Name}"
                                             Command="{Binding DataContext.SelectDoctorTabCommand,
                                                       RelativeSource={RelativeSource AncestorType=UserControl}}"
                                             CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </DockPanel>
        </Border>

        <TextBlock Grid.Row="1" Text="{Binding Status}" Style="{StaticResource Muted}"
                   TextWrapping="Wrap" Margin="0,0,0,10"
                   AutomationProperties.AutomationId="OpdStatus"/>

        <!-- Waiting and completed, side by side across the whole page. Booking
             opens over the shell now rather than taking a column here. -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="14">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBlock Text="Waiting" Style="{StaticResource H2}" Margin="0"/>
                        <TextBlock Text="{Binding Waiting.Count}" Style="{StaticResource H2}" Margin="6,0,0,0"
                                   Foreground="{DynamicResource Accent}"
                                   AutomationProperties.AutomationId="OpdWaitingCount"/>
                    </DockPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Waiting}" Style="{StaticResource WaitingList}"
                                      AutomationProperties.AutomationId="OpdWaitingList"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBlock Text="Completed" Style="{StaticResource H2}" Margin="0"/>
                        <TextBlock Text="{Binding Completed.Count}" Style="{StaticResource H2}" Margin="6,0,0,0"
                                   Foreground="{DynamicResource InkMuted}"
                                   AutomationProperties.AutomationId="OpdCompletedCount"/>
                    </DockPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Completed}" Style="{StaticResource CompletedList}"
                                      AutomationProperties.AutomationId="OpdCompletedList"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

    </Grid>
</UserControl>
