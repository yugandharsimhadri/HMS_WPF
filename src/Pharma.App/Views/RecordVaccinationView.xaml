<UserControl x:Class="Pharma.App.Views.RecordVaccinationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Pharma.App"
             Background="{DynamicResource Bg}"
             Width="420">

    <DockPanel Margin="18">

        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,14" Padding="16,12">
            <TextBlock Text="{Binding Header}" Style="{StaticResource H2}"
                       AutomationProperties.AutomationId="RecordVaccinationHeader"/>
        </Border>

        <Border DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource BtnGhost}" Margin="0,0,8,0"
                        MinWidth="100" IsCancel="True"
                        Command="{Binding CancelCommand}"
                        AutomationProperties.AutomationId="RecordVaccinationCancel"/>
                <Button Content="Record &amp; add to bill" Style="{StaticResource BtnPrimaryLarge}"
                        MinWidth="150" IsDefault="True"
                        Command="{Binding SaveCommand}"
                        AutomationProperties.AutomationId="RecordVaccinationSave"/>
            </StackPanel>
        </Border>

        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" Style="{StaticResource Muted}"
                   TextWrapping="Wrap" Margin="2,10,2,0"
                   AutomationProperties.AutomationId="RecordVaccinationStatus"/>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <local:RequiredLabel Text="Vaccine"/>
                <ComboBox ItemsSource="{Binding Vaccines}" SelectedItem="{Binding SelectedVaccine, Mode=TwoWay}"
                          DisplayMemberPath="Name"
                          local:Field.IsMissing="{Binding VaccineMissing}"
                          AutomationProperties.AutomationId="RecordVaccinationVaccinePicker"/>

                <local:RequiredLabel Text="Brand / product (from Pharmacy stock)"/>
                <TextBox Text="{Binding ProductSearch, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,0"
                         local:Field.IsMissing="{Binding ProductMissing}"
                         ToolTip="Search pharmacy stock for the brand actually given"
                         AutomationProperties.AutomationId="RecordVaccinationProductSearch"/>

                <ListBox ItemsSource="{Binding ProductMatches}"
                         SelectedItem="{Binding SelectedProduct, Mode=TwoWay}"
                         MaxHeight="120" Margin="0,2,0,6"
                         Visibility="{Binding HasProductMatches, Converter={StaticResource BoolVis}}"
                         AutomationProperties.AutomationId="RecordVaccinationProductMatches">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="2">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                <TextBlock Style="{StaticResource Muted}">
                                    <Run Text="{Binding Manufacturer, Mode=OneWay}"/>
                                    <Run Text=" · "/>
                                    <Run Text="{Binding UnitPriceLabel, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border Visibility="{Binding HasSelectedProduct, Converter={StaticResource BoolVis}}"
                        Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
                        BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,6">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Change" Style="{StaticResource BtnGhost}"
                                Padding="8,2" Command="{Binding ClearProductCommand}"
                                AutomationProperties.AutomationId="RecordVaccinationClearProduct"/>
                        <StackPanel>
                            <TextBlock TextTrimming="CharacterEllipsis"
                                       AutomationProperties.AutomationId="RecordVaccinationSelectedProduct">
                                <Run Text="{Binding SelectedProduct.Name, Mode=OneWay}" FontWeight="SemiBold"/>
                                <Run Text=" — "/>
                                <Run Text="{Binding SelectedProduct.Manufacturer, Mode=OneWay}"/>
                            </TextBlock>
                            <TextBlock Style="{StaticResource Muted}"
                                       AutomationProperties.AutomationId="RecordVaccinationSelectedBatchPrice">
                                <Run Text="{Binding SelectedBatchLabel, Mode=OneWay}"/>
                                <Run Text=" · "/>
                                <Run Text="{Binding SelectedPriceLabel, Mode=OneWay}" FontWeight="SemiBold"/>
                            </TextBlock>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <TextBlock Text="Given on" Style="{StaticResource Label}"/>
                <TextBox Text="{Binding GivenOnText, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,6" ToolTip="yyyy-MM-dd"
                         AutomationProperties.AutomationId="RecordVaccinationGivenOn"/>

                <TextBlock Text="Site" Style="{StaticResource Label}"/>
                <TextBox Text="{Binding Site, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,6" ToolTip="e.g. Left thigh"
                         AutomationProperties.AutomationId="RecordVaccinationSite"/>

                <TextBlock Text="Administered by" Style="{StaticResource Label}"/>
                <TextBox Text="{Binding AdministeredBy, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.AutomationId="RecordVaccinationAdministeredBy"/>
            </StackPanel>
        </Border>
    </DockPanel>
</UserControl>
