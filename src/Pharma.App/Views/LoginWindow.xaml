<Window x:Class="Pharma.App.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sign in" Height="600" Width="920"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        FontFamily="{StaticResource UiFont}"
        Background="{DynamicResource Bg}"
        Foreground="{DynamicResource Ink}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ── Brand panel — the same NavBg the shell's own sidebar uses,
             so this is unmistakably the same application, not a bolt-on
             login screen wearing different colours. ─────────────────────── -->
        <Border Grid.Column="0" Background="{DynamicResource NavBg}" ClipToBounds="True">
            <Grid>
                <Ellipse Width="480" Height="480" Fill="{DynamicResource Accent}" Opacity="0.14"
                         HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-260,0,0"/>
                <Ellipse Width="320" Height="320" Fill="{DynamicResource Accent}" Opacity="0.10"
                         HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-160,0,0,-160"/>

                <DockPanel Margin="40,44,36,32" LastChildFill="False">
                    <StackPanel DockPanel.Dock="Top">
                        <!-- The clinic's own logo when one has been uploaded under
                             Settings → Reports; otherwise a drawn mark, never a
                             blank space where the brand should be. -->
                        <Border Width="60" Height="60" CornerRadius="16" Background="{DynamicResource AccentFill}"
                                Visibility="{Binding HasLogo, Converter={StaticResource BoolVis}, ConverterParameter=invert}">
                            <Path Data="M11,2 L13,2 13,11 22,11 22,13 13,13 13,22 11,22 11,13 2,13 2,11 11,11 Z"
                                  Fill="White" Stretch="Uniform" Width="26" Height="26"/>
                        </Border>
                        <Border Width="150" Height="60" Background="White" CornerRadius="8" Padding="10"
                                HorizontalAlignment="Left"
                                Visibility="{Binding HasLogo, Converter={StaticResource BoolToVisible}}">
                            <Image Source="{Binding LogoImage}" Stretch="Uniform"
                                   AutomationProperties.AutomationId="LoginLogo"/>
                        </Border>

                        <TextBlock Text="{Binding ClinicName}" FontSize="26" FontWeight="Bold" Foreground="White"
                                   TextWrapping="Wrap" Margin="0,26,0,8" LineHeight="30"
                                   AutomationProperties.AutomationId="LoginClinicName"/>
                        <TextBlock Text="OPD &amp; Pharmacy" FontSize="{StaticResource FontSubheading}"
                                   Foreground="{DynamicResource NavInkBright}" FontWeight="SemiBold"/>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom">
                        <Border BorderBrush="{DynamicResource NavInkFaded}" BorderThickness="0,1,0,0"
                                Opacity="0.3" Margin="0,0,0,16"/>
                        <TextBlock Foreground="{DynamicResource NavInkFaint}" FontSize="{StaticResource FontSmall}"
                                   TextWrapping="Wrap" LineHeight="18"
                                   Text="One place for OPD visits, prescriptions, the pharmacy counter and — where switched on — the diagnostics lab."/>
                    </StackPanel>
                </DockPanel>
            </Grid>
        </Border>

        <!-- ── The form itself, in a single card centred on the light ground —
             every field here already wears the app's own TextBox/PasswordBox/
             Button chrome via the unkeyed styles in Theme.xaml. ─────────────── -->
        <Grid Grid.Column="1" Background="{DynamicResource Bg}">
            <Border Padding="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- A fixed width rather than letting the StackPanel size
                     itself to its widest child's natural content — that left
                     every field only as wide as the "Sign in" button's label
                     happened to measure, instead of a deliberate, roomy
                     field length. -->
                <StackPanel Width="340">

                    <!-- ── Credentials ─────────────────────────────────── -->
                    <StackPanel Visibility="{Binding IsCredentialsStage, Converter={StaticResource BoolToVisible}}">
                        <TextBlock Text="Welcome back" Style="{StaticResource H1}"/>
                        <TextBlock Text="Sign in to continue" Style="{StaticResource Muted}" Margin="0,2,0,22"/>

                        <TextBlock Text="Username" Style="{StaticResource Label}"/>
                        <TextBox x:Name="UsernameBox" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.AutomationId="LoginUsername"/>

                        <TextBlock Text="Password" Style="{StaticResource Label}"/>
                        <PasswordBox x:Name="PasswordBox" KeyDown="PasswordBox_KeyDown"
                                     AutomationProperties.AutomationId="LoginPassword"/>

                        <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource Danger}"
                                   FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,10"
                                   Visibility="{Binding ErrorMessage, Converter={StaticResource TextToVisible}}"
                                   AutomationProperties.AutomationId="LoginError"/>

                        <Button Content="Sign in" Style="{StaticResource BtnPrimaryLarge}" HorizontalAlignment="Stretch"
                                Margin="0,6,0,0"
                                Click="SignIn_Click" IsDefault="True" IsEnabled="{Binding IsNotBusy}"
                                AutomationProperties.AutomationId="LoginSubmit"/>

                        <Button Content="Cancel" Style="{StaticResource BtnGhost}" HorizontalAlignment="Stretch" Margin="0,8,0,0"
                                Command="{Binding CancelCommand}"
                                Visibility="{Binding AllowCancel, Converter={StaticResource BoolToVisible}}"
                                AutomationProperties.AutomationId="LoginCancel"/>
                    </StackPanel>

                    <!-- ── Forced change of password ───────────────────── -->
                    <StackPanel Visibility="{Binding IsChangePasswordStage, Converter={StaticResource BoolToVisible}}">
                        <TextBlock Text="Set a new password" Style="{StaticResource H1}"/>
                        <TextBlock Text="{Binding ChangePasswordHint}" Style="{StaticResource Muted}"
                                   TextWrapping="Wrap" Margin="0,2,0,22"/>

                        <TextBlock Text="New password" Style="{StaticResource Label}"/>
                        <PasswordBox x:Name="NewPasswordBox" AutomationProperties.AutomationId="LoginNewPassword"/>

                        <TextBlock Text="Confirm new password" Style="{StaticResource Label}"/>
                        <PasswordBox x:Name="ConfirmPasswordBox" KeyDown="ConfirmPasswordBox_KeyDown"
                                     AutomationProperties.AutomationId="LoginConfirmPassword"/>

                        <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource Danger}"
                                   FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,10"
                                   Visibility="{Binding ErrorMessage, Converter={StaticResource TextToVisible}}"
                                   AutomationProperties.AutomationId="LoginChangePasswordError"/>

                        <Button Content="Set password and continue" Style="{StaticResource BtnPrimaryLarge}"
                                HorizontalAlignment="Stretch" Margin="0,6,0,0" Click="ChangePassword_Click"
                                AutomationProperties.AutomationId="LoginChangePasswordSubmit"/>
                    </StackPanel>

                    <!-- ── EnterpriseAdmin recovery: reset somebody's password ── -->
                    <StackPanel Visibility="{Binding IsRecoveryStage, Converter={StaticResource BoolToVisible}}">
                        <TextBlock Text="Reset a password" Style="{StaticResource H1}"/>
                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,22"
                                   Text="Pick the user who is locked out and set a temporary password for them. They will be asked to set their own the moment they sign in with it."/>

                        <TextBlock Text="User" Style="{StaticResource Label}"/>
                        <ComboBox ItemsSource="{Binding RecoveryUserOptions}" DisplayMemberPath="Display"
                                  SelectedItem="{Binding SelectedRecoveryUser}"
                                  AutomationProperties.AutomationId="LoginRecoveryUser"/>

                        <TextBlock Text="Temporary password" Style="{StaticResource Label}"/>
                        <PasswordBox x:Name="ResetPasswordBox" AutomationProperties.AutomationId="LoginResetPassword"/>

                        <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource Danger}"
                                   FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,10"
                                   Visibility="{Binding ErrorMessage, Converter={StaticResource TextToVisible}}"
                                   AutomationProperties.AutomationId="LoginRecoveryError"/>

                        <Button Content="Reset password" Style="{StaticResource BtnPrimaryLarge}"
                                HorizontalAlignment="Stretch" Margin="0,6,0,0" Click="ResetPassword_Click"
                                AutomationProperties.AutomationId="LoginRecoverySubmit"/>

                        <Button Content="Back to sign in" Style="{StaticResource BtnGhost}" HorizontalAlignment="Stretch" Margin="0,8,0,0"
                                Command="{Binding BackToLoginCommand}"
                                AutomationProperties.AutomationId="LoginRecoveryBack"/>
                    </StackPanel>

                    <!-- ── Recovery done ───────────────────────────────── -->
                    <StackPanel Visibility="{Binding IsRecoveryDoneStage, Converter={StaticResource BoolToVisible}}">
                        <TextBlock Text="Password reset" Style="{StaticResource H1}"/>
                        <TextBlock Text="{Binding RecoveryResultMessage}" Style="{StaticResource Muted}"
                                   TextWrapping="Wrap" Margin="0,2,0,22"
                                   AutomationProperties.AutomationId="LoginRecoveryDone"/>

                        <Button Content="Back to sign in" Style="{StaticResource BtnPrimaryLarge}" HorizontalAlignment="Stretch"
                                Command="{Binding BackToLoginCommand}"
                                AutomationProperties.AutomationId="LoginRecoveryDoneBack"/>
                    </StackPanel>

                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
