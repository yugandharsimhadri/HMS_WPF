<UserControl x:Class="Pharma.App.Views.ProcedureEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Pharma.App"
             Background="{DynamicResource Bg}"
             Width="420">

    <DockPanel Margin="18">

        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,14" Padding="16,12">
            <TextBlock Text="{Binding Header}" Style="{StaticResource H2}"
                       TextTrimming="CharacterEllipsis"
                       AutomationProperties.AutomationId="ProcedureEditorHeader"/>
        </Border>

        <Border DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <DockPanel>
                <Button DockPanel.Dock="Left" Content="Delete" Style="{StaticResource BtnDanger}"
                        MinWidth="100"
                        Command="{Binding DeleteCommand}"
                        Visibility="{Binding CanDelete, Converter={StaticResource BoolVis}}"
                        AutomationProperties.AutomationId="ProcedureEditorDelete"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Style="{StaticResource BtnGhost}" Margin="0,0,8,0"
                            MinWidth="100" IsCancel="True"
                            Command="{Binding CancelCommand}"
                            AutomationProperties.AutomationId="ProcedureEditorCancel"/>
                    <Button Content="Save procedure" Style="{StaticResource BtnPrimaryLarge}"
                            MinWidth="130" IsDefault="True"
                            Command="{Binding SaveCommand}"
                            AutomationProperties.AutomationId="ProcedureEditorSave"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" Style="{StaticResource Muted}"
                   TextWrapping="Wrap" Margin="2,10,2,0"
                   AutomationProperties.AutomationId="ProcedureEditorStatus"/>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <local:RequiredLabel Text="Procedure name"/>
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                         local:Field.IsMissing="{Binding NameMissing}"
                         AutomationProperties.AutomationId="ProcedureEditorName"/>

                <TextBlock Text="Department" Style="{StaticResource Label}"/>
                <ComboBox ItemsSource="{Binding Departments}" SelectedItem="{Binding SelectedDepartment, Mode=TwoWay}"
                          IsEnabled="{Binding IsNewProcedure}"
                          ToolTip="Fixed once the procedure exists — it never moves between departments from here"
                          AutomationProperties.AutomationId="ProcedureEditorDepartment">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource EnumLabel}}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock Text="Category" Style="{StaticResource Label}"/>
                <ComboBox ItemsSource="{Binding Categories}" Text="{Binding Category, UpdateSourceTrigger=PropertyChanged}"
                          IsEditable="True"
                          AutomationProperties.AutomationId="ProcedureEditorCategory"/>

                <TextBlock Text="Price" Style="{StaticResource Label}"/>
                <TextBox Text="{Binding Price, UpdateSourceTrigger=PropertyChanged}"
                         local:NumericInput.Mode="Money"
                         AutomationProperties.AutomationId="ProcedureEditorPrice"/>

                <CheckBox Content="Active" IsChecked="{Binding Active, Mode=TwoWay}"
                          Margin="0,10,0,4"
                          AutomationProperties.AutomationId="ProcedureEditorActive"/>
            </StackPanel>
        </Border>
    </DockPanel>
</UserControl>
