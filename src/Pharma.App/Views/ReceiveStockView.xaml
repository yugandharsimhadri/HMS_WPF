<UserControl x:Class="Pharma.App.Views.ReceiveStockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Pharma.App"
             Background="{DynamicResource Bg}"
             Width="620">

    <!-- Two columns of four. The width is stated because the overlay is sized to
         what is inside it, and eight fields want about this much. -->
    <DockPanel Margin="18">

        <StackPanel DockPanel.Dock="Top">
            <Border Style="{StaticResource Card}" Margin="0,0,0,14" Padding="16,12">
                <StackPanel>
                    <TextBlock Text="{Binding Header}" Style="{StaticResource H2}" Margin="0"
                               AutomationProperties.AutomationId="ReceiveStockHeader"/>
                    <TextBlock Text="{Binding OnHand}" Style="{StaticResource Muted}" Margin="0,3,0,0"
                               AutomationProperties.AutomationId="ReceiveStockOnHand"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <Border DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="{Binding Status}" Style="{StaticResource Muted}"
                           VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="300"
                           AutomationProperties.AutomationId="ReceiveStockStatus"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Style="{StaticResource BtnGhost}" Margin="0,0,8,0"
                            MinWidth="100" IsCancel="True"
                            Command="{Binding CancelCommand}"
                            AutomationProperties.AutomationId="ReceiveStockCancel"/>
                    <Button Content="Add stock" Style="{StaticResource BtnPrimaryLarge}"
                            MinWidth="140" IsDefault="True"
                            Command="{Binding SaveCommand}"
                            AutomationProperties.AutomationId="StockAdd"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Packs in, units out. The shop counts strips and the counter sells
             tablets, and this is the one place the two meet. -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,14,0,0" Padding="14,10"
                Visibility="{Binding IntakePreview, Converter={StaticResource TextToVisible}}">
            <TextBlock Text="{Binding IntakePreview}" Style="{StaticResource Muted}" TextWrapping="Wrap"
                       AutomationProperties.AutomationId="StockIntakePreview"/>
        </Border>

        <Border Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <local:RequiredLabel Text="Batch no"/>
                    <TextBox Text="{Binding BatchNo, UpdateSourceTrigger=PropertyChanged}"
                             local:Field.IsMissing="{Binding BatchNoMissing}"
                             ToolTip="Printed on the pack. Required — it goes on the bill by law."
                             AutomationProperties.AutomationId="StockBatchNo"/>

                    <local:RequiredLabel Text="Packs"/>
                    <TextBox Text="{Binding Packs, UpdateSourceTrigger=PropertyChanged}"
                             local:Field.IsMissing="{Binding PacksMissing}"
                             local:NumericInput.Mode="Whole"
                             ToolTip="How many packs arrived — strips, boxes, bottles"
                             AutomationProperties.AutomationId="StockQuantity"/>

                    <TextBlock Text="Rate per pack" Style="{StaticResource Label}"/>
                    <TextBox Text="{Binding PurchaseRate, UpdateSourceTrigger=PropertyChanged}"
                             local:NumericInput.Mode="Money"
                             ToolTip="What the hospital paid per pack"
                             AutomationProperties.AutomationId="StockPurchaseRate"/>

                    <TextBlock Text="Supplier" Style="{StaticResource Label}"/>
                    <TextBox Text="{Binding SupplierName, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.AutomationId="StockSupplier"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <local:RequiredLabel Text="Expiry"/>
                    <DatePicker SelectedDate="{Binding ExpiryDate, Mode=TwoWay}"
                                local:Field.IsMissing="{Binding ExpiryMissing}"
                                ToolTip="The pack is good until the end of that month"
                                AutomationProperties.AutomationId="StockExpiry"/>

                    <TextBlock Text="Free packs" Style="{StaticResource Label}"/>
                    <TextBox Text="{Binding FreePacks, UpdateSourceTrigger=PropertyChanged}"
                             local:NumericInput.Mode="Whole"
                             ToolTip="Scheme quantity, the +1 in 10+1. Adds to stock, costs nothing."
                             AutomationProperties.AutomationId="StockFreeQuantity"/>

                    <local:RequiredLabel Text="MRP per pack"/>
                    <TextBox Text="{Binding Mrp, UpdateSourceTrigger=PropertyChanged}"
                             local:Field.IsMissing="{Binding MrpMissing}"
                             local:NumericInput.Mode="Money"
                             ToolTip="The price printed on the pack. The counter prices from this."
                             AutomationProperties.AutomationId="StockMrp"/>

                    <TextBlock Text="Supplier bill no" Style="{StaticResource Label}"/>
                    <TextBox Text="{Binding SupplierInvoiceNo, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="What the reconciliation report matches against"
                             AutomationProperties.AutomationId="StockSupplierInvoice"/>
                </StackPanel>
            </Grid>
        </Border>
    </DockPanel>
</UserControl>
