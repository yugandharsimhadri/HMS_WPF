<Window x:Class="Pharma.App.Views.MessageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="460" SizeToContent="Height" MaxHeight="620"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontFamily="{StaticResource UiFont}"
        Background="{DynamicResource Bg}"
        Foreground="{DynamicResource Ink}">

    <DockPanel Margin="18">

        <Border DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <!-- The contents are the words the tests and the operator both
                     look for. Only the ones this question needs are shown. -->
                <Button x:Name="NoButton" Content="No" Style="{StaticResource BtnGhost}"
                        MinWidth="88" Margin="0,0,8,0" Visibility="Collapsed"
                        Click="No_Click" AutomationProperties.AutomationId="MessageNo"/>
                <Button x:Name="CancelButton" Content="Cancel" Style="{StaticResource BtnGhost}"
                        MinWidth="88" Margin="0,0,8,0" Visibility="Collapsed"
                        Click="Cancel_Click" AutomationProperties.AutomationId="MessageCancel"/>
                <Button x:Name="OkButton" Content="OK" Style="{StaticResource BtnPrimary}"
                        MinWidth="88" Visibility="Collapsed"
                        Click="Ok_Click" AutomationProperties.AutomationId="MessageOk"/>
                <Button x:Name="YesButton" Content="Yes" Style="{StaticResource BtnPrimary}"
                        MinWidth="88" Visibility="Collapsed"
                        Click="Yes_Click" AutomationProperties.AutomationId="MessageYes"/>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Padding="18,16">
            <DockPanel>
                <Border x:Name="Glyph" DockPanel.Dock="Left" Width="30" Height="30" CornerRadius="15"
                        VerticalAlignment="Top" Margin="0,1,14,0"
                        Background="{DynamicResource Accent}">
                    <!-- The page colour, not white: the warning and error discs
                         are dark in the light theme and light in the dark one,
                         so a fixed white mark disappears on one of them. -->
                    <TextBlock x:Name="GlyphMark" Text="i" Foreground="{DynamicResource Bg}" FontWeight="Bold"
                               FontSize="{StaticResource FontSubheading}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="MessageText" TextWrapping="Wrap" LineHeight="19"
                               FontSize="{StaticResource FontBody}"
                               Foreground="{DynamicResource Ink}"
                               AutomationProperties.AutomationId="MessageText"/>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </DockPanel>
</Window>
