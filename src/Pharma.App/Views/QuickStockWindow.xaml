<Window x:Class="Pharma.App.Views.QuickStockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Pharma.App"
        Title="Add stock" Width="520" SizeToContent="Height" MaxHeight="700"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        FontFamily="{StaticResource UiFont}"
        Background="{DynamicResource Bg}"
        Foreground="{DynamicResource Ink}">

    <DockPanel Margin="18">

        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,12" Padding="16,12">
            <StackPanel>
                <TextBlock Text="{Binding Medicine}" Style="{StaticResource H2}" TextWrapping="Wrap"
                           AutomationProperties.AutomationId="QuickStockMedicine"/>
                <TextBlock Text="{Binding OnHand}" Style="{StaticResource Muted}"
                           AutomationProperties.AutomationId="QuickStockOnHand"/>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="{Binding Status}" Style="{StaticResource Muted}"
                           VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="250"
                           AutomationProperties.AutomationId="QuickStockStatus"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Style="{StaticResource BtnGhost}" Margin="0,0,8,0"
                            Click="Close_Click"
                            AutomationProperties.AutomationId="QuickStockCancel"/>
                    <Button Content="Add to shelf" Style="{StaticResource BtnPrimary}"
                            Command="{Binding AddCommand}"
                            AutomationProperties.AutomationId="QuickStockAdd"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Packs on the shelf" Style="{StaticResource Label}"/>
                        <TextBox Text="{Binding Packs, UpdateSourceTrigger=PropertyChanged}"
                                 local:NumericInput.Mode="Whole" AutomationProperties.AutomationId="QuickStockPacks"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="MRP per pack" Style="{StaticResource Label}"/>
                        <TextBox Text="{Binding Mrp, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Printed on the pack. Nothing can be priced without it."
                                 local:NumericInput.Mode="Money" AutomationProperties.AutomationId="QuickStockMrp"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Rate paid" Style="{StaticResource Label}"/>
                        <TextBox Text="{Binding PurchaseRate, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Leave it if you do not know — it can be filled in when the bill arrives."
                                 local:NumericInput.Mode="Money" AutomationProperties.AutomationId="QuickStockRate"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="{Binding PackNote}" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                <TextBlock Text="{Binding Preview}" Style="{StaticResource Muted}" TextWrapping="Wrap"
                           Margin="0,0,0,10" FontWeight="SemiBold"
                           AutomationProperties.AutomationId="QuickStockPreview"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Batch no (if you have it)" Style="{StaticResource Label}"/>
                        <TextBox Text="{Binding BatchNo, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.AutomationId="QuickStockBatchNo"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Expiry" Style="{StaticResource Label}"/>
                        <DatePicker SelectedDate="{Binding ExpiryDate, Mode=TwoWay}"
                                    AutomationProperties.AutomationId="QuickStockExpiry"/>
                    </StackPanel>
                </Grid>

                <Border Background="{DynamicResource WarnFill}" BorderBrush="{DynamicResource WarnStroke}" BorderThickness="1"
                        CornerRadius="6" Padding="10,8" Margin="0,14,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚠" FontSize="{StaticResource FontSubheading}" FontWeight="Bold"
                                   Foreground="{DynamicResource WarnInk}" Margin="0,0,8,0" VerticalAlignment="Top"/>
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource WarnInk}" FontSize="{StaticResource FontLabel}"
                                   Text="This goes on the shelf now so the patient can be served. It has no supplier bill behind it, so it is listed under Reports → Stock to reconcile until the bill arrives. Leave the batch number blank and one is allocated for you."/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </Border>

    </DockPanel>
</Window>
