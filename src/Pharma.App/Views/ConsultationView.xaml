<UserControl x:Class="Pharma.App.Views.ConsultationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Pharma.App"
             Background="{DynamicResource Bg}"
             Width="980" MinHeight="600">

    <!-- The overlay sizes itself to its content now, and a consultation wants
         the room: notes on the left, the prescription on the right. Stated
         width, not just a minimum — a Grid column of Width="*" inside an
         unbounded MinWidth stretched to fill the whole window instead of
         stopping at a sensible form width; MedicineEditorView already solves
         this the same way. The overlay still clamps it down on a screen too
         small to honour even that. -->
    <DockPanel Margin="18">

        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,14" Padding="16,12">
            <TextBlock Text="{Binding Header}" Style="{StaticResource H1}"
                       AutomationProperties.AutomationId="ConsultationHeader"/>
        </Border>

        <Border DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="{Binding Status}" Style="{StaticResource Muted}"
                           VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Close" Style="{StaticResource BtnGhost}" Margin="0,0,8,0"
                            Command="{Binding CloseCommand}"
                            AutomationProperties.AutomationId="ConsultationClose"/>
                    <Button Content="Save" Style="{StaticResource BtnGhost}" Margin="0,0,8,0"
                            Command="{Binding SaveCommand}"
                            AutomationProperties.AutomationId="ConsultationSave"/>
                    <Button Content="Print prescription" Style="{StaticResource BtnGhost}" Margin="0,0,8,0"
                            Command="{Binding PrintCommand}"/>
                    <Button Content="Save &amp; complete" Style="{StaticResource BtnPrimary}"
                            Command="{Binding CompleteCommand}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <TabControl BorderThickness="0" Background="Transparent"
                    AutomationProperties.AutomationId="ConsultationTabs">

            <!-- ══════════════════════════════════════════════════════ -->
            <TabItem Header="Vitals">
                <Border Style="{StaticResource Card}">
                    <StackPanel MaxWidth="520" HorizontalAlignment="Left">
                        <TextBlock Text="All optional — record whatever this visit needs." Style="{StaticResource Muted}" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Weight kg" Style="{StaticResource Label}"/>
                                <TextBox Text="{Binding Weight, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="BP" Style="{StaticResource Label}"/>
                                <TextBox Text="{Binding BloodPressure, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Temp °F" Style="{StaticResource Label}"/>
                                <TextBox Text="{Binding Temperature, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Height cm" Style="{StaticResource Label}"/>
                                <TextBox Text="{Binding Height, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.AutomationId="RxHeight"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="HR bpm" Style="{StaticResource Label}"/>
                                <TextBox Text="{Binding HeartRate, UpdateSourceTrigger=PropertyChanged}"
                                         local:NumericInput.Mode="Whole"
                                         AutomationProperties.AutomationId="RxHeartRate"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="SpO2 %" Style="{StaticResource Label}"/>
                                <TextBox Text="{Binding Spo2, UpdateSourceTrigger=PropertyChanged}"
                                         local:NumericInput.Mode="Whole"
                                         AutomationProperties.AutomationId="RxSpo2"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </TabItem>

            <!-- ══════════════════════════════════════════════════════ -->
            <TabItem Header="Prescription">
            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Prescription" Style="{StaticResource H2}"/>

                    <!-- Entry is a form, not an editable grid: a grid needs a click
                         to start editing and eats the Tab key between fields. -->
                    <Border DockPanel.Dock="Top" Background="{DynamicResource SurfaceMuted}" BorderBrush="{DynamicResource Border}"
                            BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <local:RequiredLabel Text="Medicine"/>

                            <!-- The suggestions hang directly off the bottom of the
                                 box, like a dropdown, so the eye stays in one place. -->
                            <TextBox Text="{Binding MedicineSearch, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0"
                                     ToolTip="Type to search our pharmacy. Anything not stocked can still be prescribed."
                                     local:Field.IsMissing="{Binding MedicineMissing}"
                                     AutomationProperties.AutomationId="RxMedicine"/>

                            <ItemsControl ItemsSource="{Binding Matches}"
                                          AutomationProperties.AutomationId="RxMatches">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button HorizontalContentAlignment="Stretch" Padding="10,7"
                                                FontWeight="Normal" Style="{StaticResource BtnGhost}"
                                                Command="{Binding DataContext.PickMedicineCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                AutomationProperties.AutomationId="RxMatch"
                                                AutomationProperties.Name="{Binding Name}">
                                            <DockPanel LastChildFill="True">
                                                <TextBlock DockPanel.Dock="Right" FontSize="{StaticResource FontSmall}"
                                                           Margin="12,0,0,0" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource InkMuted}"
                                                           Text="{Binding StockOnHand, StringFormat='{}{0} in stock'}"/>
                                                <TextBlock DockPanel.Dock="Right" FontSize="{StaticResource FontSmall}"
                                                           Margin="12,0,0,0" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource InkMuted}"
                                                           Text="{Binding PackSize}"/>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                           TextAlignment="Left"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </DockPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="{Binding MedicineHint}" Style="{StaticResource Muted}"
                                       TextWrapping="Wrap" Margin="0,6,0,10"
                                       AutomationProperties.AutomationId="RxMedicineHint"/>

                            <!-- Fixed widths, not Width="*" — a prescription line
                                 does not need to stretch to fill whatever room
                                 the window happens to have, and a trailing star
                                 column soaks up the leftover space instead of
                                 the fields themselves. -->
                            <Grid HorizontalAlignment="Left">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="70"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Dose" Style="{StaticResource Label}"/>
                                    <TextBox Text="{Binding NewDosage, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.AutomationId="RxDose"/>
                                </StackPanel>
                                <!-- Chosen, not typed. This is how a prescription is
                                     written, and it rules out "1-0-l" or "1_0_1". -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Morning · Afternoon · Night" Style="{StaticResource Label}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0" ItemsSource="{Binding DoseOptions}"
                                                  SelectedItem="{Binding MorningDose, Mode=TwoWay}"
                                                  ToolTip="Morning dose"
                                                  AutomationProperties.AutomationId="RxMorning"/>
                                        <ComboBox Grid.Column="2" ItemsSource="{Binding DoseOptions}"
                                                  SelectedItem="{Binding AfternoonDose, Mode=TwoWay}"
                                                  ToolTip="Afternoon dose"
                                                  AutomationProperties.AutomationId="RxAfternoon"/>
                                        <ComboBox Grid.Column="4" ItemsSource="{Binding DoseOptions}"
                                                  SelectedItem="{Binding NightDose, Mode=TwoWay}"
                                                  ToolTip="Night dose"
                                                  AutomationProperties.AutomationId="RxNight"/>
                                    </Grid>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Days" Style="{StaticResource Label}"/>
                                    <TextBox Text="{Binding NewDays, UpdateSourceTrigger=PropertyChanged}"
                                             local:NumericInput.Mode="Whole" AutomationProperties.AutomationId="RxDays"/>
                                </StackPanel>
                                <StackPanel Grid.Column="6">
                                    <local:RequiredLabel Text="Qty (units)"/>
                                    <TextBox Text="{Binding NewQuantity, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Individual tablets. Worked out from frequency and days"
                                             local:Field.IsMissing="{Binding QuantityMissing}"
                                             local:NumericInput.Mode="Whole" AutomationProperties.AutomationId="RxQuantity"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="{Binding CourseHint}" Style="{StaticResource Muted}"
                                       Margin="0,0,0,8" TextWrapping="Wrap"
                                       AutomationProperties.AutomationId="RxCourseHint"/>

                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Add" Style="{StaticResource BtnPrimary}"
                                        MinWidth="90" Margin="8,0,0,0"
                                        Command="{Binding AddLineCommand}"
                                        AutomationProperties.AutomationId="RxAdd"/>
                                <Button DockPanel.Dock="Right" Content="Clear" Style="{StaticResource BtnGhost}"
                                        MinWidth="80" Margin="8,0,0,0"
                                        Command="{Binding ClearLineCommand}"
                                        ToolTip="Empties this entry row. Lines already added stay."
                                        AutomationProperties.AutomationId="RxClear"/>
                                <TextBox Text="{Binding NewInstructions, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0" ToolTip="Instructions, e.g. after food"
                                         AutomationProperties.AutomationId="RxInstructions"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <DataGrid ItemsSource="{Binding Lines}" RowHeight="30"
                              AutomationProperties.AutomationId="RxGrid">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="MEDICINE" Binding="{Binding Medicine}" Width="220*" MinWidth="105"
                                                ElementStyle="{StaticResource GridName}"/>
                            <DataGridTextColumn Header="DOSE" Binding="{Binding Dosage}" Width="Auto" ElementStyle="{StaticResource GridText}"/>
                            <DataGridTextColumn Header="FREQUENCY" Binding="{Binding Frequency}" Width="Auto" ElementStyle="{StaticResource GridText}"/>
                            <DataGridTextColumn Header="DAYS" Binding="{Binding Days}" Width="Auto"
                                                ElementStyle="{StaticResource GridNumber}"
                                                HeaderStyle="{StaticResource GridNumberHeader}"/>
                            <DataGridTextColumn Header="DISPENSE" Binding="{Binding Course}" Width="Auto" ElementStyle="{StaticResource GridText}"/>
                            <DataGridTextColumn Header="INSTRUCTIONS" Binding="{Binding Instructions}" Width="Auto"
                                                ElementStyle="{StaticResource GridMuted}"/>
                            <DataGridTemplateColumn Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="✕" BorderThickness="0" Background="Transparent"
                                                Foreground="{DynamicResource Danger}" Cursor="Hand" ToolTip="Remove line"
                                                Command="{Binding DataContext.RemoveLineCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
            </TabItem>

            <!-- ══════════════════════════════════════════════════════ -->
            <TabItem Header="Diagnosis">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="330"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Complaint" Style="{StaticResource Label}"/>
                                <TextBox Text="{Binding Complaint, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True" Height="60" TextWrapping="Wrap"
                                         AutomationProperties.AutomationId="RxComplaint"/>

                                <TextBlock Text="Diagnosis" Style="{StaticResource Label}"/>
                                <TextBox Text="{Binding Diagnosis, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True" Height="60" TextWrapping="Wrap"
                                         AutomationProperties.AutomationId="RxDiagnosis"/>

                                <TextBlock Text="Advice / notes" Style="{StaticResource Label}"/>
                                <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True" Height="70" TextWrapping="Wrap"
                                         AutomationProperties.AutomationId="RxNotes"/>

                                <TextBlock Text="Review on" Style="{StaticResource Label}"/>
                                <DatePicker SelectedDate="{Binding FollowUpOn, Mode=TwoWay}"
                                            AutomationProperties.AutomationId="RxFollowUpOn"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- Tests requested — the diagnostics equivalent of the
                         prescription entry. Always available, whether or not
                         the Diagnostics module is on: with it on, this
                         searches the real test catalogue and is picked up
                         later at the Diagnostics desk; with it off, there is
                         no catalogue to search, so typing a name and
                         pressing Add just writes it down — it still prints
                         on the prescription, and if the module is switched
                         on later, nothing here has to be redone. -->
                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Tests requested" Style="{StaticResource H2}"/>

                            <Border DockPanel.Dock="Top" Background="{DynamicResource SurfaceMuted}" BorderBrush="{DynamicResource Border}"
                                    BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Test" Style="{StaticResource Label}"/>
                                    <TextBox Text="{Binding TestSearch, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0"
                                             ToolTip="Type to search our test catalogue. Anything not in it can still be requested as free text."
                                             local:Field.IsMissing="{Binding TestMissing}"
                                             AutomationProperties.AutomationId="RxTestSearch"/>

                                    <ItemsControl ItemsSource="{Binding TestMatches}"
                                                  AutomationProperties.AutomationId="RxTestMatches">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button HorizontalContentAlignment="Stretch" Padding="10,7"
                                                        FontWeight="Normal" Style="{StaticResource BtnGhost}"
                                                        Command="{Binding DataContext.PickTestCommand,
                                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        AutomationProperties.AutomationId="RxTestMatch"
                                                        AutomationProperties.Name="{Binding Name}">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Text="{Binding TestHint}" Style="{StaticResource Muted}"
                                               TextWrapping="Wrap" Margin="0,6,0,10"
                                               AutomationProperties.AutomationId="RxTestHint"/>

                                    <Button Content="Add" Style="{StaticResource BtnPrimary}"
                                            HorizontalAlignment="Left" MinWidth="90"
                                            Command="{Binding AddTestRequestCommand}"
                                            AutomationProperties.AutomationId="RxTestAdd"/>
                                </StackPanel>
                            </Border>

                            <DataGrid ItemsSource="{Binding RequestedTests}" RowHeight="30"
                                      AutomationProperties.AutomationId="RxTestGrid">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="TEST" Binding="{Binding TestName}" Width="*" MinWidth="105"
                                                        IsReadOnly="True" ElementStyle="{StaticResource GridName}"/>
                                    <DataGridTemplateColumn Width="Auto">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="✕" BorderThickness="0" Background="Transparent"
                                                        Foreground="{DynamicResource Danger}" Cursor="Hand" ToolTip="Remove"
                                                        Command="{Binding DataContext.RemoveTestRequestCommand,
                                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
