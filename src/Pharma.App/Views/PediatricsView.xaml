<UserControl x:Class="Pharma.App.Views.PediatricsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Pharma.App">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════════════════════
             Patient — search, select, clear. Above the tabs, so it
             carries across whatever tab is open below rather than
             living inside any one of them. -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="16,12">
            <Grid>
                <StackPanel Visibility="{Binding HasSelectedPatient, Converter={StaticResource BoolVis}, ConverterParameter=invert}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="+ New patient" Style="{StaticResource BtnGhost}"
                                Margin="8,0,0,0"
                                Command="{Binding NewPatientCommand}"
                                AutomationProperties.AutomationId="PediatricsNewPatient"/>
                        <TextBlock DockPanel.Dock="Left" Text="Patient" Style="{StaticResource Label}"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox Text="{Binding PatientSearch, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0"
                                 ToolTip="Search by patient name or phone number"
                                 AutomationProperties.AutomationId="PediatricsPatientSearch"/>
                    </DockPanel>

                    <ListBox ItemsSource="{Binding PatientMatches}"
                             SelectedItem="{Binding SelectedPatient, Mode=TwoWay}"
                             DisplayMemberPath="Display" MaxHeight="160" Margin="0,8,0,0"
                             AutomationProperties.AutomationId="PediatricsPatientMatches"/>
                </StackPanel>

                <DockPanel Visibility="{Binding HasSelectedPatient, Converter={StaticResource BoolVis}}">
                    <Button DockPanel.Dock="Right" Content="Clear patient" Style="{StaticResource BtnGhost}"
                            VerticalAlignment="Center"
                            Command="{Binding ChangePatientCommand}"
                            AutomationProperties.AutomationId="PediatricsChangePatient"/>
                    <StackPanel>
                        <TextBlock Text="{Binding SelectedPatient.Name}" FontWeight="SemiBold"
                                   FontSize="{StaticResource FontSubheading}"
                                   AutomationProperties.AutomationId="PediatricsSelectedPatient"/>
                        <TextBlock Style="{StaticResource Muted}">
                            <Run Text="{Binding SelectedPatient.PatientNo, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding SelectedPatient.Age, Mode=OneWay}"/><Run Text=" yrs · "/><Run Text="{Binding SelectedPatient.Phone, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                </DockPanel>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════ -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8">
            <TabControl BorderThickness="0" Background="Transparent"
                        AutomationProperties.AutomationId="PediatricsTabs">

                <TabItem Header="Growth">
                    <Grid Margin="16">

                        <!-- Nothing here can be used before a patient is picked — see the
                             patient header above. Showing a placeholder rather than a
                             disabled, confusing screen full of empty grids. -->
                        <Border Style="{StaticResource Card}" MaxWidth="420"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding HasSelectedPatient, Converter={StaticResource BoolVis}, ConverterParameter=invert}">
                            <StackPanel>
                                <TextBlock Text="No patient selected" Style="{StaticResource H2}"/>
                                <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Text="Pick a patient above first to record and chart their growth."/>
                            </StackPanel>
                        </Border>

                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      Visibility="{Binding HasSelectedPatient, Converter={StaticResource BoolVis}}">
                            <StackPanel MaxWidth="620">
                                <DockPanel Margin="0,0,0,4">
                                    <Button DockPanel.Dock="Right" Content="+ Record growth" Style="{StaticResource BtnPrimary}"
                                            Command="{Binding OpenRecordGrowthCommand}"
                                            AutomationProperties.AutomationId="PediatricsOpenRecordGrowth"/>
                                    <TextBlock Text="Growth" Style="{StaticResource H2}"/>
                                </DockPanel>

                                <TextBlock Text="{Binding GrowthStatus}" Style="{StaticResource Muted}"
                                           TextWrapping="Wrap" Margin="0,0,0,10"
                                           Visibility="{Binding GrowthStatus, Converter={StaticResource TextToVisible}}"
                                           AutomationProperties.AutomationId="PediatricsGrowthStatus"/>

                                <TextBlock Text="Chart" Style="{StaticResource Label}"/>
                                <ComboBox ItemsSource="{Binding GrowthChartMetrics}" SelectedItem="{Binding SelectedGrowthMetric, Mode=TwoWay}"
                                          Width="200" HorizontalAlignment="Left" Margin="0,0,0,10"
                                          AutomationProperties.AutomationId="PediatricsGrowthMetric">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource EnumLabel}}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
                                        BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,14"
                                        Visibility="{Binding HasGrowthChartData, Converter={StaticResource BoolVis}}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <Border Width="14" Height="3" Background="{DynamicResource SeriesBlue}"
                                                    VerticalAlignment="Center" Margin="0,0,4,0"/>
                                            <TextBlock Text="Patient" Style="{StaticResource Muted}" Margin="0,0,16,0"/>
                                            <Border Width="14" Height="3" Background="{DynamicResource InkMuted}"
                                                    VerticalAlignment="Center" Margin="0,0,4,0"/>
                                            <TextBlock Text="Expected (approx. reference, not a percentile chart)" Style="{StaticResource Muted}"/>
                                        </StackPanel>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Grid Grid.Column="0" Height="190" Width="50">
                                                <TextBlock Text="{Binding GrowthChartYAxisTop}" VerticalAlignment="Top" HorizontalAlignment="Right"
                                                           Style="{StaticResource Muted}" FontSize="{StaticResource FontSmall}"
                                                           AutomationProperties.AutomationId="PediatricsGrowthChartYTop"/>
                                                <TextBlock Text="{Binding GrowthChartYAxisBottom}" VerticalAlignment="Bottom" HorizontalAlignment="Right"
                                                           Style="{StaticResource Muted}" FontSize="{StaticResource FontSmall}"
                                                           AutomationProperties.AutomationId="PediatricsGrowthChartYBottom"/>
                                            </Grid>

                                            <StackPanel Grid.Column="2">
                                                <Canvas Width="480" Height="190" ClipToBounds="True">
                                                    <Path Data="{Binding ExpectedGrowthLine}" Stroke="{DynamicResource InkMuted}"
                                                          StrokeThickness="1.6" StrokeDashArray="4,3"/>
                                                    <Path Data="{Binding PatientGrowthLine}" Stroke="{DynamicResource SeriesBlue}" StrokeThickness="2.2"/>
                                                    <ItemsControl ItemsSource="{Binding GrowthChartDots}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <Canvas/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemContainerStyle>
                                                            <Style TargetType="ContentPresenter">
                                                                <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                                                <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                                            </Style>
                                                        </ItemsControl.ItemContainerStyle>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Ellipse Width="6" Height="6" Fill="{DynamicResource SeriesBlue}"/>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Canvas>
                                                <DockPanel Margin="0,2,0,0">
                                                    <TextBlock DockPanel.Dock="Left" Text="0 mo" Style="{StaticResource Muted}" FontSize="{StaticResource FontSmall}"/>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding GrowthChartXAxisRight}" Style="{StaticResource Muted}" FontSize="{StaticResource FontSmall}"/>
                                                </DockPanel>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,14"
                                           Visibility="{Binding HasGrowthChartData, Converter={StaticResource BoolVis}, ConverterParameter=invert}"
                                           Text="Record a measurement to see the growth chart here."/>

                                <TextBlock Text="History" Style="{StaticResource H2}" Margin="0,0,0,6"/>
                                <DataGrid ItemsSource="{Binding GrowthHistory}" IsReadOnly="True" MaxHeight="160"
                                          AutomationProperties.AutomationId="PediatricsGrowthHistoryGrid">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="DATE" Binding="{Binding MeasuredOn, StringFormat=dd MMM yyyy}" Width="Auto"
                                                            ElementStyle="{StaticResource GridMuted}"/>
                                        <DataGridTextColumn Header="WEIGHT" Binding="{Binding WeightKg, StringFormat=N1}" Width="Auto"
                                                            ElementStyle="{StaticResource GridNumber}"/>
                                        <DataGridTextColumn Header="HEIGHT" Binding="{Binding HeightCm, StringFormat=N1}" Width="Auto"
                                                            ElementStyle="{StaticResource GridNumber}"/>
                                        <DataGridTextColumn Header="BMI" Binding="{Binding BmiValue, StringFormat=N1}" Width="220*" MinWidth="60"
                                                            ElementStyle="{StaticResource GridNumber}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </TabItem>

                <!-- ══════════════════════════════════════════════════════ -->
                <TabItem Header="Care">
                    <Grid Margin="16">

                        <!-- Nothing here can be used before a patient is picked — see the
                             patient header above. Showing a placeholder rather than a
                             disabled, confusing screen full of empty grids. -->
                        <Border Style="{StaticResource Card}" MaxWidth="420"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding HasSelectedPatient, Converter={StaticResource BoolVis}, ConverterParameter=invert}">
                            <StackPanel>
                                <TextBlock Text="No patient selected" Style="{StaticResource H2}"/>
                                <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Text="Pick a patient above first — procedure billing and vaccination both open from here once you have."/>
                            </StackPanel>
                        </Border>

                        <Grid Visibility="{Binding HasSelectedPatient, Converter={StaticResource BoolVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="300"/>
                            </Grid.ColumnDefinitions>

                            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                                <StackPanel>

                                    <Border Style="{StaticResource Card}" Margin="0,0,0,14"
                                            Visibility="{Binding HasDueVaccines, Converter={StaticResource BoolVis}}">
                                        <StackPanel>
                                            <TextBlock Text="Due for this patient" Style="{StaticResource H2}"/>
                                            <ItemsControl ItemsSource="{Binding DueVaccines}"
                                                          AutomationProperties.AutomationId="PediatricsDueVaccines">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Margin="0,2,0,2">
                                                            <Run Text="{Binding VaccineName, Mode=OneWay}"/><Run Text=" — due "/><Run Text="{Binding DueOn, StringFormat=dd MMM yyyy, Mode=OneWay}"/>
                                                        </TextBlock>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                        <Button Content="+ Add procedure" Style="{StaticResource BtnPrimary}" Margin="0,0,8,0"
                                                Command="{Binding OpenAddProcedureCommand}"
                                                AutomationProperties.AutomationId="PediatricsOpenAddProcedure"/>
                                        <Button Content="+ Record vaccination" Style="{StaticResource BtnPrimary}"
                                                Command="{Binding OpenRecordVaccinationCommand}"
                                                AutomationProperties.AutomationId="PediatricsOpenRecordVaccination"/>
                                    </StackPanel>

                                    <TextBlock Text="{Binding VaccinationStatus}" Style="{StaticResource Muted}"
                                               TextWrapping="Wrap" Margin="0,0,0,8"
                                               Visibility="{Binding VaccinationStatus, Converter={StaticResource TextToVisible}}"
                                               AutomationProperties.AutomationId="PediatricsVaccinationStatus"/>

                                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Top" Text="Bill items" Style="{StaticResource H2}"/>

                                            <DataGrid ItemsSource="{Binding Lines}" CanUserSortColumns="False" MaxHeight="220"
                                                      AutomationProperties.AutomationId="PediatricsLinesGrid">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="ITEM" Binding="{Binding ProcedureName}" Width="220*" MinWidth="140"
                                                                        IsReadOnly="True" ElementStyle="{StaticResource GridName}"/>
                                                    <DataGridTextColumn Header="TYPE" Binding="{Binding Kind}" Width="Auto"
                                                                        IsReadOnly="True" ElementStyle="{StaticResource GridMuted}"/>
                                                    <DataGridTextColumn Header="PRICE" Binding="{Binding Price, StringFormat=N2, UpdateSourceTrigger=LostFocus}"
                                                                        Width="Auto" ElementStyle="{StaticResource GridNumber}"
                                                                        HeaderStyle="{StaticResource GridNumberHeader}"/>
                                                    <DataGridTextColumn Header="QTY" Binding="{Binding Quantity, UpdateSourceTrigger=LostFocus}"
                                                                        Width="Auto" ElementStyle="{StaticResource GridNumber}"
                                                                        HeaderStyle="{StaticResource GridNumberHeader}"/>
                                                    <DataGridTextColumn Header="AMOUNT" Binding="{Binding Amount, StringFormat=N2}"
                                                                        Width="Auto" IsReadOnly="True" ElementStyle="{StaticResource GridAmount}"
                                                                        HeaderStyle="{StaticResource GridNumberHeader}"/>
                                                    <DataGridTemplateColumn Width="Auto">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <Button Content="✕" ToolTip="Remove line" BorderThickness="0"
                                                                        Background="Transparent" Foreground="{DynamicResource Danger}" Cursor="Hand"
                                                                        Command="{Binding DataContext.RemoveLineCommand,
                                                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                        CommandParameter="{Binding}"/>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </DockPanel>
                                    </Border>

                                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                                        <DockPanel>
                                            <DockPanel DockPanel.Dock="Top">
                                                <Button DockPanel.Dock="Right" Content="Print" Style="{StaticResource BtnGhost}"
                                                        Command="{Binding PrintVaccinationHistoryCommand}"
                                                        AutomationProperties.AutomationId="PediatricsPrintVaccinationHistory"/>
                                                <Button DockPanel.Dock="Right" Content="Clear patient" Style="{StaticResource BtnGhost}"
                                                        Margin="0,0,8,0"
                                                        Command="{Binding ChangePatientCommand}"
                                                        ToolTip="Deselect this patient — ready to search for the next one"
                                                        AutomationProperties.AutomationId="PediatricsClearPatientAfterPrint"/>
                                                <TextBlock Text="Previous vaccination history" Style="{StaticResource H2}"/>
                                            </DockPanel>
                                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Muted}" Margin="0,0,0,8"
                                                       Text="Doses already recorded for this patient, most recent first — separate from the form above, which is for giving a new one."/>
                                            <DataGrid ItemsSource="{Binding VaccinationHistory}" IsReadOnly="True" MaxHeight="160"
                                                      AutomationProperties.AutomationId="PediatricsVaccinationHistoryGrid">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="GIVEN ON" Binding="{Binding GivenOn, StringFormat=dd MMM yyyy}" Width="Auto"
                                                                        ElementStyle="{StaticResource GridMuted}"/>
                                                    <DataGridTextColumn Header="VACCINE" Binding="{Binding VaccineName}" Width="200*" MinWidth="120"
                                                                        ElementStyle="{StaticResource GridName}"/>
                                                    <DataGridTextColumn Header="DOSE" Binding="{Binding DoseNumber}" Width="Auto"
                                                                        ElementStyle="{StaticResource GridNumber}"/>
                                                    <DataGridTextColumn Header="BATCH" Binding="{Binding BatchNo}" Width="Auto"
                                                                        ElementStyle="{StaticResource GridMuted}"/>
                                                    <DataGridTextColumn Header="SITE" Binding="{Binding SiteOfInjection}" Width="Auto"
                                                                        ElementStyle="{StaticResource GridMuted}"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </DockPanel>
                                    </Border>

                                </StackPanel>
                            </ScrollViewer>

                            <Border Grid.Column="2" Style="{StaticResource Card}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <TextBlock Text="Bill" Style="{StaticResource H2}"/>

                                        <TextBlock Text="{Binding BillNo, StringFormat='Bill No {0}'}"
                                                   Style="{StaticResource Muted}"
                                                   Visibility="{Binding BillNo, Converter={StaticResource TextToVisible}}"
                                                   AutomationProperties.AutomationId="PediatricsBillNo"/>

                                        <TextBlock Text="Discount" Style="{StaticResource Label}"/>
                                        <TextBox Text="{Binding Discount, UpdateSourceTrigger=PropertyChanged}"
                                                 Margin="0,0,0,6"
                                                 local:NumericInput.Mode="Money"
                                                 AutomationProperties.AutomationId="PediatricsDiscount"/>

                                        <TextBlock Text="Referred by" Style="{StaticResource Label}"/>
                                        <TextBox Text="{Binding ReferredBy, UpdateSourceTrigger=PropertyChanged}"
                                                 Margin="0,0,0,6"
                                                 ToolTip="Optional — only needed for a patient not seen through our own OPD"
                                                 AutomationProperties.AutomationId="PediatricsReferredBy"/>

                                        <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Margin="0,6,0,10"/>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Total" Style="{StaticResource Muted}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding TotalAmount, StringFormat=N2}"/>
                                        </Grid>

                                        <Border Background="#0F766E" CornerRadius="6" Padding="14,10" Margin="0,8,0,12">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Left" Text="FINAL AMOUNT" Foreground="{DynamicResource NavInkBright}"
                                                           FontSize="{StaticResource FontSmall}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding FinalAmount, StringFormat='₹{0:N2}'}" Foreground="White"
                                                           FontSize="{StaticResource FontHeading}" FontWeight="Bold" HorizontalAlignment="Right"
                                                           AutomationProperties.AutomationId="PediatricsFinalAmount"/>
                                            </DockPanel>
                                        </Border>

                                        <TextBlock Text="Payment" Style="{StaticResource Label}"/>
                                        <ComboBox ItemsSource="{Binding PaymentModes}" SelectedItem="{Binding PaymentMode, Mode=TwoWay}"
                                                  Margin="0,0,0,6"
                                                  AutomationProperties.AutomationId="PediatricsPaymentMode"/>

                                        <StackPanel Visibility="{Binding ShowTransactionNo, Converter={StaticResource BoolVis}}">
                                            <TextBlock Text="Transaction / reference no." Style="{StaticResource Label}"/>
                                            <TextBox Text="{Binding TransactionNo, UpdateSourceTrigger=PropertyChanged}"
                                                     Margin="0,0,0,6"
                                                     AutomationProperties.AutomationId="PediatricsTransactionNo"/>
                                        </StackPanel>

                                        <Button Content="Save &amp; print bill" Style="{StaticResource BtnPrimaryLarge}"
                                                Margin="0,4,0,0"
                                                Command="{Binding SaveBillAndPrintCommand}"
                                                AutomationProperties.AutomationId="PediatricsSaveAndPrint"/>
                                        <Button Content="Save without printing" Style="{StaticResource BtnGhost}" Margin="0,6,0,0"
                                                Command="{Binding SaveBillCommand}"
                                                AutomationProperties.AutomationId="PediatricsSaveBill"/>
                                        <Button Content="Clear" Style="{StaticResource BtnGhost}" Margin="0,6,0,0"
                                                Command="{Binding NewBillCommand}"
                                                AutomationProperties.AutomationId="PediatricsNewBill"/>

                                        <TextBlock Text="{Binding BillingStatus}" Style="{StaticResource Muted}"
                                                   TextWrapping="Wrap" Margin="0,8,0,0"
                                                   AutomationProperties.AutomationId="PediatricsBillingStatus"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- ══════════════════════════════════════════════════════ -->
                <TabItem Header="Immunization">
                    <Grid Margin="16">

                        <!-- Nothing here can be used before a patient is picked — see the
                             patient header above. Showing a placeholder rather than a
                             disabled, confusing screen full of empty grids. -->
                        <Border Style="{StaticResource Card}" MaxWidth="420"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding HasSelectedPatient, Converter={StaticResource BoolVis}, ConverterParameter=invert}">
                            <StackPanel>
                                <TextBlock Text="No patient selected" Style="{StaticResource H2}"/>
                                <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Text="Pick a patient above first to see their doses checked off against the vaccine schedule."/>
                            </StackPanel>
                        </Border>

                        <!-- Fills the tab, like Care does. This was capped at 820
                             wide, which left the card marooned in the middle of a
                             wide window with the grid scrolling inside 360px while
                             half the screen sat empty. -->
                        <DockPanel Visibility="{Binding HasSelectedPatient, Converter={StaticResource BoolVis}}">
                            <TextBlock DockPanel.Dock="Top" Text="Immunization card" Style="{StaticResource H2}"
                                       Margin="0,0,0,10"/>

                            <UniformGrid DockPanel.Dock="Top" Columns="4" Margin="0,0,0,14">
                                <Border Style="{StaticResource Card}" Margin="0,0,6,0" Padding="12,10">
                                    <StackPanel>
                                        <TextBlock Text="{Binding ImmunizationGivenCount}" FontWeight="Bold"
                                                   FontSize="{StaticResource FontSubheading}" Foreground="{DynamicResource AccentDark}"
                                                   AutomationProperties.AutomationId="PediatricsImmunizationGivenCount"/>
                                        <TextBlock Text="Given" Style="{StaticResource Muted}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}" Margin="6,0,6,0" Padding="12,10">
                                    <StackPanel>
                                        <TextBlock Text="{Binding ImmunizationOverdueCount}" FontWeight="Bold"
                                                   FontSize="{StaticResource FontSubheading}" Foreground="{DynamicResource DangerInk}"
                                                   AutomationProperties.AutomationId="PediatricsImmunizationOverdueCount"/>
                                        <TextBlock Text="Overdue" Style="{StaticResource Muted}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}" Margin="6,0,6,0" Padding="12,10">
                                    <StackPanel>
                                        <TextBlock Text="{Binding ImmunizationDueSoonCount}" FontWeight="Bold"
                                                   FontSize="{StaticResource FontSubheading}" Foreground="{DynamicResource WarnInk}"
                                                   AutomationProperties.AutomationId="PediatricsImmunizationDueSoonCount"/>
                                        <TextBlock Text="Due soon" Style="{StaticResource Muted}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}" Margin="6,0,0,0" Padding="12,10">
                                    <StackPanel>
                                        <TextBlock Text="{Binding ImmunizationUpcomingCount}" FontWeight="Bold"
                                                   FontSize="{StaticResource FontSubheading}" Foreground="{DynamicResource InkMuted}"
                                                   AutomationProperties.AutomationId="PediatricsImmunizationUpcomingCount"/>
                                        <TextBlock Text="Upcoming" Style="{StaticResource Muted}"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <DataGrid ItemsSource="{Binding ImmunizationRows}" IsReadOnly="True"
                                      CanUserSortColumns="False"
                                      AutomationProperties.AutomationId="PediatricsImmunizationGrid">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="AGE" Binding="{Binding RecommendedAgeDays, Converter={StaticResource ImmunizationAgeLabel}}"
                                                         Width="Auto" ElementStyle="{StaticResource GridMuted}"/>
                                    <DataGridTemplateColumn Header="VACCINE" Width="200*" MinWidth="140">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Style="{StaticResource GridName}" VerticalAlignment="Center">
                                                    <Run Text="{Binding VaccineName, Mode=OneWay}"/><Run Text=" — dose "/><Run Text="{Binding DoseNumber, Mode=OneWay}"/>
                                                </TextBlock>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="STATUS" Width="Auto">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding Status, Converter={StaticResource ImmunizationStatusFill}}"
                                                        CornerRadius="10" Padding="8,2" HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding Status, Converter={StaticResource ImmunizationStatusLabel}}"
                                                               Foreground="{Binding Status, Converter={StaticResource ImmunizationStatusInk}}"
                                                               FontSize="{StaticResource FontSmall}" FontWeight="SemiBold"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="DETAIL" Width="260*" MinWidth="160">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource ImmunizationRowDetail}}"
                                                           Style="{StaticResource Muted}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Width="Auto">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Record" Style="{StaticResource BtnGhost}" Padding="10,3"
                                                        Visibility="{Binding Status, Converter={StaticResource ImmunizationNeedsAction}}"
                                                        Command="{Binding DataContext.RecordFromCardCommand,
                                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Grid>
                </TabItem>
            </TabControl>
        </Border>
    </Grid>
</UserControl>
