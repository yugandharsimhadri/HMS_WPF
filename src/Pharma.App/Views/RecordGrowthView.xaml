<UserControl x:Class="Pharma.App.Views.RecordGrowthView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Pharma.App"
             Background="{DynamicResource Bg}"
             Width="380">

    <DockPanel Margin="18">

        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,14" Padding="16,12">
            <TextBlock Text="{Binding Header}" Style="{StaticResource H2}"
                       AutomationProperties.AutomationId="RecordGrowthHeader"/>
        </Border>

        <Border DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource BtnGhost}" Margin="0,0,8,0"
                        MinWidth="100" IsCancel="True"
                        Command="{Binding CancelCommand}"
                        AutomationProperties.AutomationId="RecordGrowthCancel"/>
                <Button Content="Record" Style="{StaticResource BtnPrimaryLarge}"
                        MinWidth="100" IsDefault="True"
                        Command="{Binding SaveCommand}"
                        AutomationProperties.AutomationId="RecordGrowthSave"/>
            </StackPanel>
        </Border>

        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" Style="{StaticResource Muted}"
                   TextWrapping="Wrap" Margin="2,10,2,0"
                   AutomationProperties.AutomationId="RecordGrowthStatus"/>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Measured on" Style="{StaticResource Label}"/>
                <TextBox Text="{Binding MeasuredOnText, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,6" ToolTip="yyyy-MM-dd"
                         AutomationProperties.AutomationId="RecordGrowthMeasuredOn"/>

                <TextBlock Text="Weight (kg)" Style="{StaticResource Label}"/>
                <TextBox Text="{Binding WeightKg, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,6"
                         AutomationProperties.AutomationId="RecordGrowthWeightKg"/>

                <TextBlock Text="Height (cm)" Style="{StaticResource Label}"/>
                <TextBox Text="{Binding HeightCm, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,6"
                         AutomationProperties.AutomationId="RecordGrowthHeightCm"/>

                <TextBlock Text="Head circumference (cm)" Style="{StaticResource Label}"/>
                <TextBox Text="{Binding HeadCircumferenceCm, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.AutomationId="RecordGrowthHeadCircumferenceCm"/>
            </StackPanel>
        </Border>
    </DockPanel>
</UserControl>
