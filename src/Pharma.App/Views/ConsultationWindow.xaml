<Window x:Class="Pharma.App.Views.ConsultationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Consultation" Height="740" Width="1080"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Bg}">

    <DockPanel Margin="18">

        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,14" Padding="16,12">
            <TextBlock Text="{Binding Header}" Style="{StaticResource H1}"
                       AutomationProperties.AutomationId="ConsultationHeader"/>
        </Border>

        <Border DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="{Binding Status}" Style="{StaticResource Muted}"
                           VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Save" Style="{StaticResource BtnGhost}" Margin="0,0,8,0"
                            Command="{Binding SaveCommand}"/>
                    <Button Content="Print prescription" Style="{StaticResource BtnGhost}" Margin="0,0,8,0"
                            Command="{Binding PrintCommand}"/>
                    <Button Content="Save &amp; complete" Style="{StaticResource BtnPrimary}"
                            Command="{Binding CompleteCommand}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Clinical notes -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Vitals" Style="{StaticResource H2}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Weight kg" Style="{StaticResource Label}"/>
                                <TextBox Text="{Binding Weight, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="BP" Style="{StaticResource Label}"/>
                                <TextBox Text="{Binding BloodPressure, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Temp °F" Style="{StaticResource Label}"/>
                                <TextBox Text="{Binding Temperature, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Complaint" Style="{StaticResource Label}"/>
                        <TextBox Text="{Binding Complaint, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" Height="60" TextWrapping="Wrap"/>

                        <TextBlock Text="Diagnosis" Style="{StaticResource Label}"/>
                        <TextBox Text="{Binding Diagnosis, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" Height="60" TextWrapping="Wrap"/>

                        <TextBlock Text="Advice / notes" Style="{StaticResource Label}"/>
                        <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" Height="70" TextWrapping="Wrap"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Fee" Style="{StaticResource Label}"/>
                                <TextBox Text="{Binding Fee, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Review on" Style="{StaticResource Label}"/>
                                <DatePicker SelectedDate="{Binding FollowUpOn, Mode=TwoWay}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Prescription -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Prescription" Style="{StaticResource H2}"/>

                    <!-- Entry is a form, not an editable grid: a grid needs a click
                         to start editing and eats the Tab key between fields. -->
                    <Border DockPanel.Dock="Top" Background="#F7F9FA" BorderBrush="{StaticResource Border}"
                            BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Medicine" Style="{StaticResource Label}"/>
                            <ComboBox ItemsSource="{Binding Products}" SelectedItem="{Binding NewMedicine, Mode=TwoWay}"
                                      IsEditable="True" IsTextSearchEnabled="True"
                                      Text="{Binding NewMedicineText, UpdateSourceTrigger=PropertyChanged}"
                                      ToolTip="Pick from the catalogue so the pharmacy can load it onto a bill"
                                      AutomationProperties.AutomationId="RxMedicine">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate><TextBlock Text="{Binding Name}"/></DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="70"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Dose" Style="{StaticResource Label}"/>
                                    <TextBox Text="{Binding NewDosage, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.AutomationId="RxDose"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Frequency" Style="{StaticResource Label}"/>
                                    <TextBox Text="{Binding NewFrequency, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="1-0-1, 1-1-1, OD, BD, TDS, SOS"
                                             AutomationProperties.AutomationId="RxFrequency"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Days" Style="{StaticResource Label}"/>
                                    <TextBox Text="{Binding NewDays, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.AutomationId="RxDays"/>
                                </StackPanel>
                                <StackPanel Grid.Column="6">
                                    <TextBlock Text="Qty (units)" Style="{StaticResource Label}"/>
                                    <TextBox Text="{Binding NewQuantity, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Individual tablets. Worked out from frequency and days"
                                             AutomationProperties.AutomationId="RxQuantity"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="{Binding CourseHint}" Style="{StaticResource Muted}"
                                       Margin="0,0,0,8" TextWrapping="Wrap"
                                       AutomationProperties.AutomationId="RxCourseHint"/>

                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Add" Style="{StaticResource BtnPrimary}"
                                        MinWidth="90" Margin="8,0,0,0"
                                        Command="{Binding AddLineCommand}"
                                        AutomationProperties.AutomationId="RxAdd"/>
                                <TextBox Text="{Binding NewInstructions, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0" ToolTip="Instructions, e.g. after food"
                                         AutomationProperties.AutomationId="RxInstructions"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <DataGrid ItemsSource="{Binding Lines}" RowHeight="30"
                              AutomationProperties.AutomationId="RxGrid">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="MEDICINE" Binding="{Binding Medicine}" Width="*"/>
                            <DataGridTextColumn Header="DOSE" Binding="{Binding Dosage}" Width="80"/>
                            <DataGridTextColumn Header="FREQUENCY" Binding="{Binding Frequency}" Width="95"/>
                            <DataGridTextColumn Header="DAYS" Binding="{Binding Days}" Width="55"/>
                            <DataGridTextColumn Header="DISPENSE" Binding="{Binding Course}" Width="150"/>
                            <DataGridTextColumn Header="INSTRUCTIONS" Binding="{Binding Instructions}" Width="140"/>
                            <DataGridTemplateColumn Width="34">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="✕" BorderThickness="0" Background="Transparent"
                                                Foreground="#B42318" Cursor="Hand" ToolTip="Remove line"
                                                Command="{Binding DataContext.RemoveLineCommand,
                                                          RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
