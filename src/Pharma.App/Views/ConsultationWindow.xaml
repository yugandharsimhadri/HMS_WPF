<Window x:Class="Pharma.App.Views.ConsultationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Consultation" Height="740" Width="1080"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Bg}">

    <DockPanel Margin="18">

        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,14" Padding="16,12">
            <TextBlock Text="{Binding Header}" Style="{StaticResource H1}"
                       AutomationProperties.AutomationId="ConsultationHeader"/>
        </Border>

        <Border DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="{Binding Status}" Style="{StaticResource Muted}"
                           VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Save" Style="{StaticResource BtnGhost}" Margin="0,0,8,0"
                            Command="{Binding SaveCommand}"/>
                    <Button Content="Print prescription" Style="{StaticResource BtnGhost}" Margin="0,0,8,0"
                            Command="{Binding PrintCommand}"/>
                    <Button Content="Save &amp; complete" Style="{StaticResource BtnPrimary}"
                            Command="{Binding CompleteCommand}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Clinical notes -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Vitals" Style="{StaticResource H2}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Weight kg" Style="{StaticResource Label}"/>
                                <TextBox Text="{Binding Weight, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="BP" Style="{StaticResource Label}"/>
                                <TextBox Text="{Binding BloodPressure, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Temp °F" Style="{StaticResource Label}"/>
                                <TextBox Text="{Binding Temperature, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Complaint" Style="{StaticResource Label}"/>
                        <TextBox Text="{Binding Complaint, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" Height="60" TextWrapping="Wrap"/>

                        <TextBlock Text="Diagnosis" Style="{StaticResource Label}"/>
                        <TextBox Text="{Binding Diagnosis, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" Height="60" TextWrapping="Wrap"/>

                        <TextBlock Text="Advice / notes" Style="{StaticResource Label}"/>
                        <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" Height="70" TextWrapping="Wrap"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Fee" Style="{StaticResource Label}"/>
                                <TextBox Text="{Binding Fee, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Review on" Style="{StaticResource Label}"/>
                                <DatePicker SelectedDate="{Binding FollowUpOn, Mode=TwoWay}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Prescription -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" LastChildFill="False" Margin="0,0,0,10">
                        <TextBlock Text="Prescription" Style="{StaticResource H2}" Margin="0" VerticalAlignment="Center"/>
                        <Button DockPanel.Dock="Right" Content="+ Add line" Style="{StaticResource BtnGhost}"
                                Command="{Binding AddLineCommand}"/>
                    </DockPanel>

                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap"
                               Text="Type the medicine name, or pick one from the catalogue so the pharmacy can load it into a bill directly."/>

                    <DataGrid ItemsSource="{Binding Lines}" IsReadOnly="False" CanUserSortColumns="False"
                              RowHeight="34">
                        <DataGrid.Columns>
                            <DataGridComboBoxColumn Header="MEDICINE" Width="*"
                                                    SelectedValueBinding="{Binding ProductId}"
                                                    SelectedValuePath="Id" DisplayMemberPath="Name"
                                                    IsReadOnly="False">
                                <DataGridComboBoxColumn.ElementStyle>
                                    <Style TargetType="ComboBox">
                                        <Setter Property="ItemsSource"
                                                Value="{Binding DataContext.Products,
                                                        RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        <Setter Property="IsEditable" Value="True"/>
                                        <Setter Property="Text" Value="{Binding Medicine, Mode=TwoWay}"/>
                                    </Style>
                                </DataGridComboBoxColumn.ElementStyle>
                                <DataGridComboBoxColumn.EditingElementStyle>
                                    <Style TargetType="ComboBox">
                                        <Setter Property="ItemsSource"
                                                Value="{Binding DataContext.Products,
                                                        RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        <Setter Property="IsEditable" Value="True"/>
                                        <Setter Property="Text" Value="{Binding Medicine, Mode=TwoWay}"/>
                                    </Style>
                                </DataGridComboBoxColumn.EditingElementStyle>
                            </DataGridComboBoxColumn>
                            <DataGridTextColumn Header="DOSE" Binding="{Binding Dosage}" Width="90"/>
                            <DataGridTextColumn Header="FREQUENCY" Binding="{Binding Frequency}" Width="110"/>
                            <DataGridTextColumn Header="DAYS" Binding="{Binding Days}" Width="60"/>
                            <DataGridTextColumn Header="QTY" Binding="{Binding Quantity}" Width="60"/>
                            <DataGridTextColumn Header="INSTRUCTIONS" Binding="{Binding Instructions}" Width="160"/>
                            <DataGridTemplateColumn Width="34">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="✕" BorderThickness="0" Background="Transparent"
                                                Foreground="#B42318" Cursor="Hand" ToolTip="Remove line"
                                                Command="{Binding DataContext.RemoveLineCommand,
                                                          RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
