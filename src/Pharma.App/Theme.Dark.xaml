<!--
    The dark palette. Same keys as Theme.Light.xaml, swapped at runtime.

    Not an inversion: the surfaces are warm-neutral rather than black, the ink
    stops short of white, and the teal is lifted so it still reads as the
    clinic's colour against a dark ground instead of going muddy.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="Bg"          Color="#12171C"/>
    <SolidColorBrush x:Key="Surface"     Color="#1B222A"/>
    <SolidColorBrush x:Key="Border"      Color="#2E3841"/>
    <SolidColorBrush x:Key="Ink"         Color="#E4EAEF"/>
    <SolidColorBrush x:Key="InkMuted"    Color="#93A2B0"/>
    <SolidColorBrush x:Key="Accent"      Color="#2AA79B"/>
    <SolidColorBrush x:Key="AccentDark"  Color="#17847A"/>
    <SolidColorBrush x:Key="Danger"      Color="#E4756A"/>
    <SolidColorBrush x:Key="Warn"        Color="#E0A15C"/>
    <SolidColorBrush x:Key="NavBg"       Color="#0D1418"/>

    <SolidColorBrush x:Key="SurfaceMuted" Color="#171E24"/>
    <SolidColorBrush x:Key="BadgeFill"    Color="#28323B"/>
    <SolidColorBrush x:Key="AccentSoft"   Color="#1C3A38"/>

    <!-- Dashboard chart series, beyond the single Accent teal — pharmacy
         (blue) and diagnostics (orange). Picked and validated (CVD-safe
         against Accent, ≥3:1 on Surface) alongside Accent as a three-hue
         categorical set; never reused for anything but a chart series. -->
    <SolidColorBrush x:Key="SeriesBlue"       Color="#3987E5"/>
    <SolidColorBrush x:Key="SeriesBlueSoft"   Color="#1B2A3D"/>
    <SolidColorBrush x:Key="SeriesOrange"     Color="#D95926"/>
    <SolidColorBrush x:Key="SeriesOrangeSoft" Color="#3A2418"/>

    <SolidColorBrush x:Key="WarnFill"     Color="#33281A"/>
    <!-- Lightened from #8A6428 (2.70:1 against WarnFill — under the 3:1 a
         border needs) to #C08A34 (4.75:1). -->
    <SolidColorBrush x:Key="WarnStroke"   Color="#C08A34"/>
    <SolidColorBrush x:Key="WarnInk"      Color="#EBC282"/>

    <!-- See Theme.Light.xaml. Warm rather than pure red, so it sits with the
         other surfaces; DangerInk reads 7.1:1 on DangerFill. -->
    <SolidColorBrush x:Key="DangerFill"   Color="#38221F"/>
    <SolidColorBrush x:Key="DangerInk"    Color="#F0A79E"/>
    <SolidColorBrush x:Key="NavInk"       Color="#C3D2D8"/>
    <SolidColorBrush x:Key="NavInkBright" Color="#8FD3CC"/>
    <SolidColorBrush x:Key="NavInkFaint"  Color="#6C8A92"/>
    <!-- Lightened from #5C7A82 (4.04:1 against the nav panel) to #6A8890
         (4.90:1), matching the same fix made in Theme.Light.xaml. -->
    <SolidColorBrush x:Key="NavInkFaded"  Color="#6A8890"/>

    <!-- Interaction: a row under the pointer, a pressed button, a grid header. -->
    <SolidColorBrush x:Key="HoverFill"   Color="#223038"/>
    <SolidColorBrush x:Key="PressedFill" Color="#202A32"/>
    <SolidColorBrush x:Key="HeaderFill"  Color="#232E36"/>

    <!-- See Theme.Light.xaml: a rule between rows, not a border. -->
    <SolidColorBrush x:Key="GridLine"    Color="#242E36"/>
    <!-- Lightened from #7B8B97 (4.57:1, fine on its own, but too close to the
         line once anti-aliasing thins a 1.4px stroke) to #8C9CA7 (5.68:1). -->
    <SolidColorBrush x:Key="ArrowInk"    Color="#8C9CA7"/>

    <!-- Keyboard focus — see Theme.Light.xaml. Lightened so the same blue
         reads clearly against dark surfaces too. -->
    <SolidColorBrush x:Key="FocusStroke" Color="#5B8DEF"/>

    <!-- Inset and raised still read the same way, just darker: fields sink,
         buttons lift. -->
    <LinearGradientBrush x:Key="InputFill" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#151B21" Offset="0"/>
        <GradientStop Color="#1A222A" Offset="0.45"/>
        <GradientStop Color="#1E272F" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="InputStroke" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#3A4650" Offset="0"/>
        <GradientStop Color="#2C363E" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="InputStrokeHover" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#4E5D68" Offset="0"/>
        <GradientStop Color="#3B4750" Offset="1"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="InputStrokeFocus" Color="#2AA79B"/>
    <SolidColorBrush x:Key="InputFillDisabled" Color="#1A1F24"/>

    <!-- The old stops (#2FB8AA / #1E8F84) put white button text at 2.45:1 and
         3.95:1 — both under the 4.5:1 normal text needs. Both stops now
         clear it, at some cost to the "lifted" gradient's contrast with
         itself; the button still reads raised against the dark ground. -->
    <LinearGradientBrush x:Key="AccentFill" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1B8078" Offset="0"/>
        <GradientStop Color="#14675E" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GhostFill" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#242D36" Offset="0"/>
        <GradientStop Color="#1C242B" Offset="1"/>
    </LinearGradientBrush>

</ResourceDictionary>
